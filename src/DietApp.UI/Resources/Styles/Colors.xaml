<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
    Como funciona: Diccionario central de colores del sistema de diseno 'Clinical Nutrition Ergonomics' de Stitch.
    Define tokens semanticos primarios, secundarios, contenedores tonales, paleta para los 7 minerales criticos
    y soporte contrastado para modo claro y modo oscuro.
    Por que se tomo esta decision: Centraliza los codigos hexadecimales oficiales de Stitch en Color y SolidColorBrush,
    garantizando coherencia visual absoluta y compatibilidad nativa con Android y Windows.
    -->

    <!-- 1. Paleta Basica y Neutros -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">#00000000</Color>

    <!-- 2. Tokens Oficiales Stitch (Tema Claro) -->
    <Color x:Key="StitchBackground">#FAF8FF</Color>
    <Color x:Key="StitchSurface">#FAF8FF</Color>
    <Color x:Key="StitchSurfaceDim">#D2D9F4</Color>
    <Color x:Key="StitchSurfaceBright">#FAF8FF</Color>
    <Color x:Key="StitchSurfaceContainerLowest">#FFFFFF</Color>
    <Color x:Key="StitchSurfaceContainerLow">#F2F3FF</Color>
    <Color x:Key="StitchSurfaceContainer">#EAEDFF</Color>
    <Color x:Key="StitchSurfaceContainerHigh">#E2E7FF</Color>
    <Color x:Key="StitchSurfaceContainerHighest">#DAE2FD</Color>

    <Color x:Key="StitchOnSurface">#131B2E</Color>
    <Color x:Key="StitchOnSurfaceVariant">#424936</Color>
    <Color x:Key="StitchInverseSurface">#283044</Color>
    <Color x:Key="StitchInverseOnSurface">#EEF0FF</Color>

    <Color x:Key="StitchOutline">#727A64</Color>
    <Color x:Key="StitchOutlineVariant">#C1CAB0</Color>
    <Color x:Key="StitchOutlineVariantSoft">#E2E8F0</Color>

    <!-- 3. Roles Semanticos Primarios, Secundarios y Terciarios -->
    <Color x:Key="StitchPrimary">#416900</Color>
    <Color x:Key="StitchOnPrimary">#FFFFFF</Color>
    <Color x:Key="StitchPrimaryContainer">#84CC16</Color>
    <Color x:Key="StitchOnPrimaryContainer">#315200</Color>
    <Color x:Key="StitchInversePrimary">#91DB2A</Color>
    <Color x:Key="StitchPrimaryFixed">#ACF847</Color>

    <Color x:Key="StitchSecondary">#A53C0B</Color>
    <Color x:Key="StitchOnSecondary">#FFFFFF</Color>
    <Color x:Key="StitchSecondaryContainer">#FC7B48</Color>
    <Color x:Key="StitchOnSecondaryContainer">#671F00</Color>
    <Color x:Key="StitchSecondaryFixed">#FFDBCF</Color>
    <Color x:Key="StitchSecondaryFixedDim">#FFB59B</Color>
    <Color x:Key="StitchOnSecondaryFixed">#380D00</Color>
    <Color x:Key="StitchClinicalCoral">#EF713F</Color>

    <Color x:Key="StitchTertiary">#855300</Color>
    <Color x:Key="StitchOnTertiary">#FFFFFF</Color>
    <Color x:Key="StitchTertiaryContainer">#FEA518</Color>
    <Color x:Key="StitchOnTertiaryContainer">#684000</Color>
    <Color x:Key="StitchTertiaryFixed">#FFDDB8</Color>
    <Color x:Key="StitchTertiaryFixedDim">#FFB95F</Color>
    <Color x:Key="StitchOnTertiaryFixed">#2A1700</Color>

    <Color x:Key="StitchError">#BA1A1A</Color>
    <Color x:Key="StitchOnError">#FFFFFF</Color>
    <Color x:Key="StitchErrorContainer">#FFDAD6</Color>
    <Color x:Key="StitchOnErrorContainer">#93000A</Color>

    <!-- 4. Tokens Modo Oscuro -->
    <Color x:Key="StitchDarkBackground">#0B0F19</Color>
    <Color x:Key="StitchDarkSurface">#131B2E</Color>
    <Color x:Key="StitchDarkSurfaceLowest">#1A2238</Color>
    <Color x:Key="StitchDarkSurfaceLow">#1E2742</Color>
    <Color x:Key="StitchDarkSurfaceContainerLow">#1E2742</Color>
    <Color x:Key="StitchDarkSurfaceContainer">#242E4C</Color>
    <Color x:Key="StitchDarkSurfaceContainerHigh">#2A3554</Color>
    <Color x:Key="StitchDarkOnSurface">#F1F5F9</Color>
    <Color x:Key="StitchDarkOnSurfaceVariant">#94A3B8</Color>
    <Color x:Key="StitchDarkOutline">#475569</Color>
    <Color x:Key="StitchDarkOutlineVariant">#334155</Color>

    <!-- 5. Paleta de los 7 Minerales Clinicos (Stitch Pill Matrix) -->
    <!-- Potasio (K) -->
    <Color x:Key="MineralKContainer">#FFF1ED</Color>
    <Color x:Key="MineralKText">#C2410C</Color>
    <Color x:Key="MineralKBorder">#FDBA74</Color>

    <!-- Fosforo (P) -->
    <Color x:Key="MineralPContainer">#FAF5FF</Color>
    <Color x:Key="MineralPText">#7E22CE</Color>
    <Color x:Key="MineralPBorder">#D8B4FE</Color>

    <!-- Sodio (Na) -->
    <Color x:Key="MineralNaContainer">#EFF6FF</Color>
    <Color x:Key="MineralNaText">#1D4ED8</Color>
    <Color x:Key="MineralNaBorder">#93C5FD</Color>

    <!-- Calcio (Ca) -->
    <Color x:Key="MineralCaContainer">#F0FDFA</Color>
    <Color x:Key="MineralCaText">#0F766E</Color>
    <Color x:Key="MineralCaBorder">#99F6E4</Color>

    <!-- Magnesio (Mg) -->
    <Color x:Key="MineralMgContainer">#FFF1F2</Color>
    <Color x:Key="MineralMgText">#BE123C</Color>
    <Color x:Key="MineralMgBorder">#FECDD3</Color>

    <!-- Hierro (Fe) -->
    <Color x:Key="MineralFeContainer">#FEF3C7</Color>
    <Color x:Key="MineralFeText">#B45309</Color>
    <Color x:Key="MineralFeBorder">#FDE68A</Color>

    <!-- Zinc (Zn) -->
    <Color x:Key="MineralZnContainer">#F1F5F9</Color>
    <Color x:Key="MineralZnText">#334155</Color>
    <Color x:Key="MineralZnBorder">#CBD5E1</Color>

    <!-- Proteina -->
    <Color x:Key="MineralProteinContainer">#F7FEE7</Color>
    <Color x:Key="MineralProteinText">#315200</Color>
    <Color x:Key="MineralProteinBorder">#84CC16</Color>

    <!-- 6. Pinceles (SolidColorBrush) para evitar conversiones en tiempo de ejecucion -->
    <SolidColorBrush x:Key="StitchBackgroundBrush" Color="{StaticResource StitchBackground}" />
    <SolidColorBrush x:Key="StitchSurfaceBrush" Color="{StaticResource StitchSurface}" />
    <SolidColorBrush x:Key="StitchSurfaceContainerLowestBrush" Color="{StaticResource StitchSurfaceContainerLowest}" />
    <SolidColorBrush x:Key="StitchSurfaceContainerLowBrush" Color="{StaticResource StitchSurfaceContainerLow}" />
    <SolidColorBrush x:Key="StitchSurfaceContainerBrush" Color="{StaticResource StitchSurfaceContainer}" />
    <SolidColorBrush x:Key="StitchSurfaceContainerHighBrush" Color="{StaticResource StitchSurfaceContainerHigh}" />
    <SolidColorBrush x:Key="StitchSurfaceContainerHighestBrush" Color="{StaticResource StitchSurfaceContainerHighest}" />

    <SolidColorBrush x:Key="StitchPrimaryBrush" Color="{StaticResource StitchPrimary}" />
    <SolidColorBrush x:Key="StitchPrimaryContainerBrush" Color="{StaticResource StitchPrimaryContainer}" />
    <SolidColorBrush x:Key="StitchSecondaryBrush" Color="{StaticResource StitchSecondary}" />
    <SolidColorBrush x:Key="StitchSecondaryContainerBrush" Color="{StaticResource StitchSecondaryContainer}" />
    <SolidColorBrush x:Key="StitchTertiaryBrush" Color="{StaticResource StitchTertiary}" />
    <SolidColorBrush x:Key="StitchTertiaryContainerBrush" Color="{StaticResource StitchTertiaryContainer}" />
    <SolidColorBrush x:Key="StitchClinicalCoralBrush" Color="{StaticResource StitchClinicalCoral}" />

    <SolidColorBrush x:Key="StitchOnSurfaceBrush" Color="{StaticResource StitchOnSurface}" />
    <SolidColorBrush x:Key="StitchOnSurfaceVariantBrush" Color="{StaticResource StitchOnSurfaceVariant}" />
    <SolidColorBrush x:Key="StitchOnSecondaryFixedBrush" Color="{StaticResource StitchOnSecondaryFixed}" />
    <SolidColorBrush x:Key="StitchOnTertiaryFixedBrush" Color="{StaticResource StitchOnTertiaryFixed}" />
    <SolidColorBrush x:Key="StitchDarkSurfaceContainerLowBrush" Color="{StaticResource StitchDarkSurfaceContainerLow}" />
    <SolidColorBrush x:Key="StitchOutlineBrush" Color="{StaticResource StitchOutline}" />
    <SolidColorBrush x:Key="StitchOutlineVariantBrush" Color="{StaticResource StitchOutlineVariant}" />
    <SolidColorBrush x:Key="StitchOutlineVariantSoftBrush" Color="{StaticResource StitchOutlineVariantSoft}" />

    <SolidColorBrush x:Key="MineralKContainerBrush" Color="{StaticResource MineralKContainer}" />
    <SolidColorBrush x:Key="MineralPContainerBrush" Color="{StaticResource MineralPContainer}" />
    <SolidColorBrush x:Key="MineralNaContainerBrush" Color="{StaticResource MineralNaContainer}" />
    <SolidColorBrush x:Key="MineralCaContainerBrush" Color="{StaticResource MineralCaContainer}" />
    <SolidColorBrush x:Key="MineralMgContainerBrush" Color="{StaticResource MineralMgContainer}" />
    <SolidColorBrush x:Key="MineralFeContainerBrush" Color="{StaticResource MineralFeContainer}" />
    <SolidColorBrush x:Key="MineralZnContainerBrush" Color="{StaticResource MineralZnContainer}" />

</ResourceDictionary>
