<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Sistema de Diseno Stitch: Clinical Nutrition Ergonomics -->
    <!-- Colores Nucleares y Acentos -->
    <Color x:Key="Primary">#84cc16</Color>
    <Color x:Key="PrimaryDark">#416900</Color>
    <Color x:Key="PrimaryDarkText">#102000</Color>
    <Color x:Key="PrimaryFixed">#acf847</Color>
    <Color x:Key="PrimaryFixedDim">#91db2a</Color>
    <Color x:Key="OnPrimary">#ffffff</Color>
    <Color x:Key="OnPrimaryContainer">#315200</Color>
    <Color x:Key="PrimaryContainer">#84cc16</Color>

    <!-- Secundario (Coral Clinico / Excesos y Alertas Severas) -->
    <Color x:Key="Secondary">#ef713f</Color>
    <Color x:Key="SecondaryDark">#a53c0b</Color>
    <Color x:Key="SecondaryDarkText">#ffffff</Color>
    <Color x:Key="SecondaryContainer">#fc7b48</Color>
    <Color x:Key="OnSecondary">#ffffff</Color>
    <Color x:Key="OnSecondaryContainer">#671f00</Color>
    <Color x:Key="SecondaryFixed">#ffdbcf</Color>
    <Color x:Key="SecondaryFixedDim">#ffb59b</Color>

    <!-- Terciario (Ambar Clinico / Avisos Preventivos y Limites Cercanos) -->
    <Color x:Key="Tertiary">#f59e0b</Color>
    <Color x:Key="TertiaryDark">#855300</Color>
    <Color x:Key="TertiaryContainer">#fea518</Color>
    <Color x:Key="OnTertiary">#ffffff</Color>
    <Color x:Key="OnTertiaryContainer">#684000</Color>
    <Color x:Key="TertiaryFixed">#ffddb8</Color>
    <Color x:Key="TertiaryFixedDim">#ffb95f</Color>

    <!-- Superficies, Fondos y Contenedores -->
    <Color x:Key="SurfaceWarm">#faf8ff</Color>
    <Color x:Key="SurfaceDark">#121214</Color>
    <Color x:Key="Surface">#faf8ff</Color>
    <Color x:Key="SurfaceDim">#d2d9f4</Color>
    <Color x:Key="SurfaceBright">#faf8ff</Color>
    <Color x:Key="SurfaceContainerLowest">#ffffff</Color>
    <Color x:Key="SurfaceContainerLow">#f2f3ff</Color>
    <Color x:Key="SurfaceContainer">#eaedff</Color>
    <Color x:Key="SurfaceContainerHigh">#e2e7ff</Color>
    <Color x:Key="SurfaceContainerHighest">#dae2fd</Color>

    <Color x:Key="CardBackgroundLight">#ffffff</Color>
    <Color x:Key="CardBackgroundDark">#1c1c20</Color>
    <Color x:Key="BorderWarmLight">#c1cab0</Color>
    <Color x:Key="BorderWarmDark">#334155</Color>

    <!-- Tipografia y Contraste Clinico -->
    <Color x:Key="ContrastDark">#131b2e</Color>
    <Color x:Key="OnSurface">#131b2e</Color>
    <Color x:Key="OnSurfaceVariant">#424936</Color>
    <Color x:Key="InverseSurface">#283044</Color>
    <Color x:Key="InverseOnSurface">#eef0ff</Color>
    <Color x:Key="Outline">#727a64</Color>
    <Color x:Key="OutlineVariant">#c1cab0</Color>

    <!-- Matriz Tonal Especializada de 7 Minerales Clinicos -->
    <!-- Potasio (K) -->
    <Color x:Key="MineralPotassiumBg">#FFF1ED</Color>
    <Color x:Key="MineralPotassiumText">#C2410C</Color>
    <Color x:Key="MineralPotassiumBorder">#FDBA74</Color>
    <!-- Fosforo (P) -->
    <Color x:Key="MineralPhosphorusBg">#FAF5FF</Color>
    <Color x:Key="MineralPhosphorusText">#7E22CE</Color>
    <Color x:Key="MineralPhosphorusBorder">#D8B4FE</Color>
    <!-- Sodio (Na) -->
    <Color x:Key="MineralSodiumBg">#EFF6FF</Color>
    <Color x:Key="MineralSodiumText">#1D4ED8</Color>
    <Color x:Key="MineralSodiumBorder">#93C5FD</Color>
    <!-- Calcio (Ca) -->
    <Color x:Key="MineralCalciumBg">#F0FDFA</Color>
    <Color x:Key="MineralCalciumText">#0F766E</Color>
    <Color x:Key="MineralCalciumBorder">#99F6E4</Color>
    <!-- Magnesio (Mg) -->
    <Color x:Key="MineralMagnesiumBg">#FFF1F2</Color>
    <Color x:Key="MineralMagnesiumText">#BE123C</Color>
    <Color x:Key="MineralMagnesiumBorder">#FECDD3</Color>
    <!-- Hierro (Fe) -->
    <Color x:Key="MineralIronBg">#FEF3C7</Color>
    <Color x:Key="MineralIronText">#B45309</Color>
    <Color x:Key="MineralIronBorder">#FDE68A</Color>
    <!-- Zinc (Zn) -->
    <Color x:Key="MineralZincBg">#F1F5F9</Color>
    <Color x:Key="MineralZincText">#334155</Color>
    <Color x:Key="MineralZincBorder">#CBD5E1</Color>
    <!-- Proteina -->
    <Color x:Key="MineralProteinBg">#F4F9EA</Color>
    <Color x:Key="MineralProteinText">#315200</Color>
    <Color x:Key="MineralProteinBorder">#84CC16</Color>

    <!-- Pildoras y Badges Nutricionales Generales -->
    <Color x:Key="PillNeutralBackground">#ffffff</Color>
    <Color x:Key="PillNeutralBorder">#c1cab0</Color>
    <Color x:Key="PillNeutralText">#131b2e</Color>
    <Color x:Key="PillCoralBackground">#ef713f</Color>
    <Color x:Key="PillCoralText">#ffffff</Color>
    <Color x:Key="PillLimeBackground">#84cc16</Color>
    <Color x:Key="PillLimeText">#102000</Color>

    <!-- Colores Semanticos de Nutricion, Accion y Alerta -->
    <Color x:Key="HealthTeal">#0F766E</Color>
    <Color x:Key="HealthTealDark">#14B8A6</Color>
    <Color x:Key="SuccessGreen">#84cc16</Color>
    <Color x:Key="SuccessGreenDark">#416900</Color>
    <Color x:Key="AlertRed">#ba1a1a</Color>
    <Color x:Key="AlertRedDark">#ffdad6</Color>
    <Color x:Key="WarningAmber">#f59e0b</Color>
    <Color x:Key="WarningAmberDark">#fea518</Color>
    <Color x:Key="InfoBlue">#1D4ED8</Color>
    <Color x:Key="InfoBlueDark">#93C5FD</Color>
    <Color x:Key="SlateDark">#1E293B</Color>
    <Color x:Key="SlateLight">#F8FAFC</Color>
    <Color x:Key="BorderLight">#c1cab0</Color>
    <Color x:Key="BorderDark">#334155</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">#131b2e</Color>
    <Color x:Key="Magenta">#ef713f</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#131b2e</Color>

    <Color x:Key="Gray100">#F3EFEA</Color>
    <Color x:Key="Gray200">#E5DFD9</Color>
    <Color x:Key="Gray300">#C9C2BA</Color>
    <Color x:Key="Gray400">#9E9891</Color>
    <Color x:Key="Gray500">#6E6862</Color>
    <Color x:Key="Gray600">#45413C</Color>
    <Color x:Key="Gray900">#1C1B19</Color>
    <Color x:Key="Gray950">#131b2e</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="ContrastDarkBrush" Color="{StaticResource ContrastDark}"/>
    <SolidColorBrush x:Key="SurfaceWarmBrush" Color="{StaticResource SurfaceWarm}"/>
    <SolidColorBrush x:Key="CardBackgroundLightBrush" Color="{StaticResource CardBackgroundLight}"/>
    <SolidColorBrush x:Key="CardBackgroundDarkBrush" Color="{StaticResource CardBackgroundDark}"/>
    <SolidColorBrush x:Key="BorderWarmLightBrush" Color="{StaticResource BorderWarmLight}"/>
    <SolidColorBrush x:Key="PillCoralBrush" Color="{StaticResource PillCoralBackground}"/>
    <SolidColorBrush x:Key="PillLimeBrush" Color="{StaticResource PillLimeBackground}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="HealthTealBrush" Color="{StaticResource HealthTeal}"/>
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreen}"/>
    <SolidColorBrush x:Key="AlertRedBrush" Color="{StaticResource AlertRed}"/>
    <SolidColorBrush x:Key="WarningAmberBrush" Color="{StaticResource WarningAmber}"/>
    <SolidColorBrush x:Key="InfoBlueBrush" Color="{StaticResource InfoBlue}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>