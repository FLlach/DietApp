<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DietApp.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DietApp.UI.Views"
    Title="DietApp">

    <!--
    Como funciona: Estructura central de navegacion basada en pestanas (TabBar).
    Permite alternar de forma nativa entre el conteo diario, el catalogo con filtro
    de minerales, el modulo de recetas culinarias, el registro de comidas y el alta de alimentos.
    Por que se tomo esta decision: Shell provee navegacion declarativa, fluida y nativa
    optimizada tanto para dispositivos moviles (Android e iOS) como para ventanas en escritorio.
    -->

    <TabBar>
        <Tab Title="Conteo Diario">
            <ShellContent
                Title="Conteo Diario"
                ContentTemplate="{DataTemplate views:MealTrackingPage}"
                Route="MealTrackingPage" />
        </Tab>

        <Tab Title="Recetas">
            <ShellContent
                Title="Recetas"
                ContentTemplate="{DataTemplate views:RecipesPage}"
                Route="RecipesPage" />
        </Tab>

        <Tab Title="Catalogo y Filtro">
            <ShellContent
                Title="Catalogo y Filtro"
                ContentTemplate="{DataTemplate views:FoodCatalogPage}"
                Route="FoodCatalogPage" />
        </Tab>

        <Tab Title="Registrar Comida">
            <ShellContent
                Title="Registrar Comida"
                ContentTemplate="{DataTemplate views:AddMealPage}"
                Route="AddMealPage" />
        </Tab>

        <Tab Title="Nuevo Alimento">
            <ShellContent
                Title="Nuevo Alimento"
                ContentTemplate="{DataTemplate views:AddFoodPage}"
                Route="AddFoodPage" />
        </Tab>
    </TabBar>

</Shell>
