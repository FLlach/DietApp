<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.AddFoodPage"
             x:DataType="vm:AddFoodViewModel"
             Title="{loc:Translate AddFood_Title}">

    <!--
    Como funciona: Formulario de ingreso de nuevos alimentos con su correspondiente
    desglose de minerales (fosforo, potasio, sodio, etc.) por porcion base.
    Por que se tomo esta decision: Permite al usuario enriquecer el catalogo con alimentos
    especificos de su dieta, habilitando que la aplicacion calcule aportes minerales personalizados.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label Text="{loc:Translate AddFood_Header}"
                   FontAttributes="Bold"
                   FontSize="18" />

            <Label Text="{loc:Translate AddFood_Subtitle}"
                   FontSize="13"
                   TextColor="Gray" />

            <!-- Datos Generales -->
            <Border StrokeShape="RoundRectangle 10"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate AddFood_Name}" FontAttributes="Bold" FontSize="13" />
                    <Entry Placeholder="{loc:Translate AddFood_NamePlaceholder}"
                           Text="{Binding Name}" />

                    <Label Text="{loc:Translate AddFood_Category}" FontAttributes="Bold" FontSize="13" />
                    <Entry Placeholder="{loc:Translate AddFood_CategoryPlaceholder}"
                           Text="{Binding Category}" />

                    <Label Text="{loc:Translate AddFood_PortionGrams}" FontAttributes="Bold" FontSize="13" />
                    <Entry Placeholder="100"
                           Keyboard="Numeric"
                           Text="{Binding ReferenceGramsText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Datos de Minerales -->
            <Label Text="{loc:Translate AddFood_MineralsTitle}"
                   FontAttributes="Bold"
                   FontSize="15" />

            <Border StrokeShape="RoundRectangle 10"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="10">
                    <!-- Fosforo -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                        <Label Text="{loc:Translate Mineral_Phosphorus}" FontAttributes="Bold" FontSize="12" />
                        <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding PhosphorusText}" />
                    </VerticalStackLayout>

                    <!-- Potasio -->
                    <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                        <Label Text="{loc:Translate Mineral_Potassium}" FontAttributes="Bold" FontSize="12" />
                        <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding PotassiumText}" />
                    </VerticalStackLayout>

                    <!-- Sodio -->
                    <VerticalStackLayout Grid.Row="1" Grid.Column="0">
                        <Label Text="{loc:Translate Mineral_Sodium}" FontAttributes="Bold" FontSize="12" />
                        <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding SodiumText}" />
                    </VerticalStackLayout>

                    <!-- Calcio -->
                    <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                        <Label Text="{loc:Translate Mineral_Calcium}" FontAttributes="Bold" FontSize="12" />
                        <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding CalciumText}" />
                    </VerticalStackLayout>

                    <!-- Magnesio -->
                    <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                        <Label Text="{loc:Translate Mineral_Magnesium}" FontAttributes="Bold" FontSize="12" />
                        <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding MagnesiumText}" />
                    </VerticalStackLayout>

                    <!-- Hierro -->
                    <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                        <Label Text="{loc:Translate Mineral_Iron}" FontAttributes="Bold" FontSize="12" />
                        <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding IronText}" />
                    </VerticalStackLayout>

                    <!-- Zinc -->
                    <VerticalStackLayout Grid.Row="3" Grid.Column="0">
                        <Label Text="{loc:Translate Mineral_Zinc}" FontAttributes="Bold" FontSize="12" />
                        <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding ZincText}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Mensaje de estado -->
            <Label Text="{Binding FeedbackMessage}"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="#27AE60" />

            <!-- Boton Guardar -->
            <Button Text="{loc:Translate AddFood_SaveButton}"
                    Command="{Binding SaveFoodCommand}"
                    FontAttributes="Bold"
                    HeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
