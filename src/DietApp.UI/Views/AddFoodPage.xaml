<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.AddFoodPage"
             x:DataType="vm:AddFoodViewModel"
             Title="{loc:Translate AddFood_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <!--
    Como funciona: Alta de alimentos conforme a la pantalla Stitch 'Alta de Alimento (AddFoodPage)'.
    Estructura la captura bromatologica mediante tarjetas bento (Datos Generales, Macronutrientes,
    y Cuadricula Clinica de los 7 Minerales Criticos con marcadores diana).
    Por que se tomo esta decision: Aplica objetivos tactiles de 48dp, teclados numericos y
    paleta Stitch 'Clinical Nutrition Ergonomics' para facilitar la digitacion precisa.
    -->

    <Grid RowDefinitions="*, Auto">
        <!-- Contenido Desplazable del Formulario -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="16">
                <!-- 1. Cabecera Clinica Stitch -->
                <Border Style="{StaticResource StitchCardStyle}"
                        Padding="16, 14">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 24"
                                WidthRequest="48"
                                HeightRequest="48"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                StrokeThickness="1">
                            <Label Text="+"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="REGISTRO CLÍNICO DIETÉTICO"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}" />
                            <Label Text="{loc:Translate AddFood_Title}"
                                   FontAttributes="Bold"
                                   FontSize="20"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                            <Label Text="Base de Datos Local SQLite • .NET MAUI"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Indicador de Carga -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <!-- 2. Bento: Datos Generales -->
                <Border Style="{StaticResource StitchCardStyle}"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="Datos Generales"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Obligatorio *"
                                   FontSize="11"
                                   TextColor="{StaticResource Secondary}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Nombre -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate AddFood_Name}"
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    HeightRequest="48"
                                    Padding="12, 0">
                                <Entry Text="{Binding Name}"
                                       Placeholder="{loc:Translate AddFood_NamePlaceholder}"
                                       HeightRequest="48"
                                       FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Categoria y Porcion de Referencia -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{loc:Translate AddFood_Category}"
                                       FontAttributes="Bold"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                <Border StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                        StrokeThickness="1"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                        HeightRequest="48"
                                        Padding="12, 0">
                                    <Entry Text="{Binding Category}"
                                           Placeholder="{loc:Translate AddFood_CategoryPlaceholder}"
                                           HeightRequest="48"
                                           FontSize="13" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{loc:Translate AddFood_ReferenceGrams}"
                                       FontAttributes="Bold"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                <Border StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                        StrokeThickness="1"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                        HeightRequest="48"
                                        Padding="12, 0">
                                    <Entry Text="{Binding ReferenceGramsText}"
                                           Keyboard="Numeric"
                                           HeightRequest="48"
                                           FontSize="14" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. Bento: Macronutrientes Principales -->
                <Border Style="{StaticResource StitchCardStyle}"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="Macronutrientes Principales"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                                   VerticalOptions="Center" />
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 8"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}"
                                    Padding="8, 2">
                                <Label Text="Por porción base"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                            <!-- Calorias -->
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="{loc:Translate AddFood_Calories}"
                                       FontAttributes="Bold"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                <Border StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                        StrokeThickness="1"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                        HeightRequest="48"
                                        Padding="12, 0">
                                    <Entry Text="{Binding CaloriesText}"
                                           Keyboard="Numeric"
                                           HeightRequest="48"
                                           FontSize="14" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Proteinas -->
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{loc:Translate AddFood_Protein}"
                                       FontAttributes="Bold"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                <Border StrokeShape="RoundRectangle 12"
                                        Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                        StrokeThickness="1"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                        HeightRequest="48"
                                        Padding="12, 0">
                                    <Entry Text="{Binding ProteinText}"
                                           Keyboard="Numeric"
                                           HeightRequest="48"
                                           FontSize="14" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 4. Bento: 7 Minerales Criticos (Grid 2 Columnas) -->
                <Border Style="{StaticResource StitchCardStyle}"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="7 Minerales Críticos"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                <Label Text="Control bromatológico diana en mg"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 8"
                                    Background="{StaticResource Primary}"
                                    Padding="8, 2"
                                    VerticalOptions="Center">
                                <Label Text="mg / porción"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                            <!-- 1. Potasio (K) - Marcador Renal -->
                            <Border Grid.Row="0" Grid.Column="0"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralPillPotassiumBrush}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    Padding="10, 8">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0"
                                               Text="Potasio (K)"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                        <Label Grid.Column="1"
                                               Text="Renal"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource MineralPillPotassiumBrush}" />
                                    </Grid>
                                    <Entry Text="{Binding PotassiumText}"
                                           Keyboard="Numeric"
                                           HeightRequest="44"
                                           FontSize="14" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- 2. Fosforo (P) - Marcador Oseo -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralPillPhosphorusBrush}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    Padding="10, 8">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0"
                                               Text="Fósforo (P)"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                        <Label Grid.Column="1"
                                               Text="Óseo"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource MineralPillPhosphorusBrush}" />
                                    </Grid>
                                    <Entry Text="{Binding PhosphorusText}"
                                           Keyboard="Numeric"
                                           HeightRequest="44"
                                           FontSize="14" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- 3. Sodio (Na) - Marcador Tension -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralPillSodiumBrush}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    Padding="10, 8">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0"
                                               Text="Sodio (Na)"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                        <Label Grid.Column="1"
                                               Text="Tensión"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource MineralPillSodiumBrush}" />
                                    </Grid>
                                    <Entry Text="{Binding SodiumText}"
                                           Keyboard="Numeric"
                                           HeightRequest="44"
                                           FontSize="14" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- 4. Calcio (Ca) -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralPillCalciumBrush}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    Padding="10, 8">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0"
                                               Text="Calcio (Ca)"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                        <Label Grid.Column="1"
                                               Text="Básico"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource MineralPillCalciumBrush}" />
                                    </Grid>
                                    <Entry Text="{Binding CalciumText}"
                                           Keyboard="Numeric"
                                           HeightRequest="44"
                                           FontSize="14" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- 5. Magnesio (Mg) -->
                            <Border Grid.Row="2" Grid.Column="0"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralPillMagnesiumBrush}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    Padding="10, 8">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0"
                                               Text="Magnesio (Mg)"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                        <Label Grid.Column="1"
                                               Text="Muscular"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource MineralPillMagnesiumBrush}" />
                                    </Grid>
                                    <Entry Text="{Binding MagnesiumText}"
                                           Keyboard="Numeric"
                                           HeightRequest="44"
                                           FontSize="14" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- 6. Hierro (Fe) -->
                            <Border Grid.Row="2" Grid.Column="1"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralPillIronBrush}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    Padding="10, 8">
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0"
                                               Text="Hierro (Fe)"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                        <Label Grid.Column="1"
                                               Text="Anemia"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource MineralPillIronBrush}" />
                                    </Grid>
                                    <Entry Text="{Binding IronText}"
                                           Keyboard="Numeric"
                                           HeightRequest="44"
                                           FontSize="14" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- 7. Zinc (Zn) - Ocupa 2 columnas -->
                            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralPillZincBrush}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    Padding="12, 8">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Zinc (Zn)"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                        <Label Text="Inmune y Metabolismo"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource MineralPillZincBrush}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            StrokeShape="RoundRectangle 8"
                                            Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                            StrokeThickness="1"
                                            WidthRequest="100"
                                            HeightRequest="44"
                                            Padding="8, 0">
                                        <Entry Text="{Binding ZincText}"
                                               Keyboard="Numeric"
                                               HorizontalTextAlignment="End"
                                               HeightRequest="44"
                                               FontSize="14" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Mensaje de Feedback -->
                <Label Text="{Binding FeedbackMessage}"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       FontSize="13"
                       TextColor="{StaticResource PrimaryDark}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra Fija Inferior de Accion (Bottom Action Bar) -->
        <Border Grid.Row="1"
                StrokeShape="Rectangle"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                Padding="16, 12">
            <Button Text="{loc:Translate AddFood_SaveButton}"
                    Command="{Binding SaveFoodAsyncCommand}"
                    Style="{StaticResource StitchPrimaryButtonStyle}"
                    HeightRequest="52"
                    MinimumHeightRequest="52"
                    FontSize="15" />
        </Border>
    </Grid>
</ContentPage>
