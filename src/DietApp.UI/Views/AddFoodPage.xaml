                                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                                HeightRequest="36"
                                                Padding="6, 0">
                                            <Entry Text="{Binding PhosphorusMgText, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                                   HorizontalTextAlignment="End"
                                                   BackgroundColor="Transparent"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="mg"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               TextColor="{StaticResource StitchOutline}"
                                               VerticalOptions="Center"
                                               Margin="6, 0, 0, 0" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 3. Sodio (Na) - Marcador Tension -->
                            <Border Grid.Row="1" Grid.Column="0"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                    Padding="10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Sodio (Na)"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 4"
                                                StrokeThickness="0"
                                                Background="{StaticResource StitchErrorContainer}"
                                                Padding="4, 1">
                                            <Label Text="Tensión"
                                                   FontFamily="Inter"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource StitchOnErrorContainer}" />
                                        </Border>
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                                HeightRequest="36"
                                                Padding="6, 0">
                                            <Entry Text="{Binding SodiumMgText, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                                   HorizontalTextAlignment="End"
                                                   BackgroundColor="Transparent"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="mg"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               TextColor="{StaticResource StitchOutline}"
                                               VerticalOptions="Center"
                                               Margin="6, 0, 0, 0" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 4. Calcio (Ca) -->
                            <Border Grid.Row="1" Grid.Column="1"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                    Padding="10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Calcio (Ca)"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                        <Label Grid.Column="1"
                                               Text="Básico"
                                               FontFamily="Inter"
                                               FontSize="10"
                                               TextColor="{StaticResource StitchOutline}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                                HeightRequest="36"
                                                Padding="6, 0">
                                            <Entry Text="{Binding CalciumMgText, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                                   HorizontalTextAlignment="End"
                                                   BackgroundColor="Transparent"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="mg"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               TextColor="{StaticResource StitchOutline}"
                                               VerticalOptions="Center"
                                               Margin="6, 0, 0, 0" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 5. Magnesio (Mg) -->
                            <Border Grid.Row="2" Grid.Column="0"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                    Padding="10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Magnesio (Mg)"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                        <Label Grid.Column="1"
                                               Text="Muscular"
                                               FontFamily="Inter"
                                               FontSize="10"
                                               TextColor="{StaticResource StitchOutline}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                                HeightRequest="36"
                                                Padding="6, 0">
                                            <Entry Text="{Binding MagnesiumMgText, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                                   HorizontalTextAlignment="End"
                                                   BackgroundColor="Transparent"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="mg"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               TextColor="{StaticResource StitchOutline}"
                                               VerticalOptions="Center"
                                               Margin="6, 0, 0, 0" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 6. Hierro (Fe) -->
                            <Border Grid.Row="2" Grid.Column="1"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                    Padding="10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Hierro (Fe)"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                        <Label Grid.Column="1"
                                               Text="Anemia"
                                               FontFamily="Inter"
                                               FontSize="10"
                                               TextColor="{StaticResource StitchOutline}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                                HeightRequest="36"
                                                Padding="6, 0">
                                            <Entry Text="{Binding IronMgText, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                                   HorizontalTextAlignment="End"
                                                   BackgroundColor="Transparent"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="mg"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               TextColor="{StaticResource StitchOutline}"
                                               VerticalOptions="Center"
                                               Margin="6, 0, 0, 0" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 7. Zinc (Zn) - Ocupa ambas columnas -->
                            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                    Padding="10">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                        <Label Text="Zinc (Zn)"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                               VerticalOptions="Center" />
                                        <Label Text="Inmune &amp; Metabolismo"
                                               FontFamily="Inter"
                                               FontSize="10"
                                               TextColor="{StaticResource StitchOutline}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 8"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                                WidthRequest="80"
                                                HeightRequest="36"
                                                Padding="6, 0">
                                            <Entry Text="{Binding ZincMgText, Mode=TwoWay}"
                                                   Keyboard="Numeric"
                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                                   HorizontalTextAlignment="End"
                                                   BackgroundColor="Transparent"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Label Text="mg"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               TextColor="{StaticResource StitchOutline}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>

                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- 2.5 Tarjeta de Dictamen y Advertencias Clinicas -->
                <Border Style="{StaticResource StitchCardBorderStyle}"
                        Padding="16"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="12">

                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="{x:Static helpers:MaterialIconFont.FactCheck}"
                                   Style="{StaticResource MaterialIconStyle}"
                                   FontSize="18"
                                   TextColor="{StaticResource StitchPrimary}" />
                            <Label Text="Dictamen y Advertencias"
                                   FontFamily="PlusJakartaSans"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                        </HorizontalStackLayout>

                        <!-- Interruptor Apto Dieta Renal (KDOQI) -->
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                Padding="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center" Margin="0, 0, 10, 0">
                                    <Label Text="Apto Dieta Renal (KDOQI)"
                                           FontFamily="Inter"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                    <Label Text="Adecuado para protocolos de enfermedad renal crónica estadios 3-5"
                                           FontFamily="Inter"
                                           FontSize="10"
                                           TextColor="{StaticResource StitchOutline}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding IsKdoqiRenalDietCompliant, Mode=TwoWay}"
                                        OnColor="{StaticResource StitchPrimaryContainer}"
                                        ThumbColor="{StaticResource StitchPrimary}"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- Pastillas de Advertencias Clinicas -->
                        <VerticalStackLayout Spacing="6" Margin="0, 4, 0, 0">
                            <Label Text="Advertencias Clínicas y Etiquetas Rápidas"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                            
                            <FlexLayout BindableLayout.ItemsSource="{Binding ClinicalPills}"
                                        Wrap="Wrap">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:ClinicalTagPillModel">
                                        <Border StrokeShape="RoundRectangle 9999"
                                                StrokeThickness="1"
                                                Padding="10, 5"
                                                Margin="0, 3, 6, 3">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddFoodViewModel}}, Path=ToggleClinicalPillCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource StitchPrimaryContainer}" />
                                                    <Setter Property="Stroke" Value="{StaticResource StitchPrimaryContainer}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StitchSurfaceContainer}, Dark={StaticResource StitchDarkSurfaceContainer}}" />
                                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                                </DataTrigger>
                                            </Border.Triggers>

                                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                                <Label Text="{Binding IconGlyph}"
                                                       Style="{StaticResource MaterialIconStyle}"
                                                       FontSize="13">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource StitchOnPrimaryContainer}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <Label Text="{Binding Name}"
                                                       FontFamily="Inter"
                                                       FontSize="11"
                                                       FontAttributes="Bold">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource StitchOnPrimaryContainer}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Observaciones Dietoterapeuticas -->
                        <VerticalStackLayout Spacing="4" Margin="0, 4, 0, 0">
                            <Label Text="Observaciones dietoterapéuticas"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                    Padding="10">
                                <Editor Text="{Binding ClinicalObservations, Mode=TwoWay}"
                                        Placeholder="Añadir notas sobre biodisponibilidad mineral o cocción recomendada..."
                                        PlaceholderColor="{StaticResource StitchOutline}"
                                        AutoSize="TextChanges"
                                        MinimumHeightRequest="60"
                                        FontFamily="Inter"
                                        FontSize="12"
                                        TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                        BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. Barra de Acciones Fijada Inferior (Docked Footer) -->
        <Border Grid.Row="2"
                StrokeShape="Rectangle"
                StrokeThickness="0,1,0,0"
                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}"
                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                Padding="16, 12">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10" MaximumWidthRequest="540" HorizontalOptions="Center">

                <!-- Accion Secundaria: Descartar -->
                <Button Grid.Column="0"
                        Text="Descartar"
                        Command="{Binding DiscardCommand}"
                        FontFamily="Inter"
                        FontSize="13"
                        HeightRequest="46"
                        CornerRadius="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainer}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                        TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}"
                        BorderColor="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}"
                        BorderWidth="1"
                        Padding="18, 0" />

                <!-- Accion Principal: + Guardar en Catalogo Local -->
                <Button Grid.Column="1"
                        Text="+ Guardar en Catálogo Local"
                        Command="{Binding SaveFoodCommand}"
                        FontFamily="Inter"
                        FontSize="13"
                        FontAttributes="Bold"
                        HeightRequest="46"
                        CornerRadius="12"
                        BackgroundColor="{StaticResource StitchPrimaryContainer}"
                        TextColor="{StaticResource StitchOnPrimaryContainer}"
                        SemanticProperties.Description="Guardar alimento en la base de datos local" />

            </Grid>
        </Border>

        <!-- 3. Modal / Overlay de Escaneo de Codigo de Barras con Camara -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              IsVisible="{Binding IsScanning}"
              BackgroundColor="#EE000000"
              RowDefinitions="Auto, *, Auto"
              ZIndex="999">

            <!-- Cabecera del Escaner -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto, *, Auto"
                  Padding="20, 16"
                  BackgroundColor="#CC000000">

                <!-- Boton Cerrar Escaner -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 9999"
                        StrokeThickness="0"
                        Background="#33FFFFFF"
                        WidthRequest="44"
                        HeightRequest="44"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StopScanCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static helpers:MaterialIconFont.Close}"
                           Style="{StaticResource MaterialIconStyle}"
                           FontSize="22"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Titulo y Guia -->
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                    <Label Text="Escanear Código de Barras"
                           FontFamily="PlusJakartaSans"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Enfoca el código del producto dentro del marco"
                           FontFamily="Inter"
                           FontSize="11"
                           TextColor="#CCCCCC"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Boton Alternar Linterna -->
                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 9999"
                        StrokeThickness="0"
                        Background="#33FFFFFF"
                        WidthRequest="44"
                        HeightRequest="44"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleTorchCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static helpers:MaterialIconFont.FlashOn}"
                           Style="{StaticResource MaterialIconStyle}"
                           FontSize="22"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Visor de Camara con Reticula Central -->
            <Grid Grid.Row="1">
                <!-- Control Nativo de Camara -->
                <scanner:CameraView x:Name="ScannerCameraView"
                                    CameraEnabled="{Binding IsScanning}"
                                    TorchOn="{Binding IsTorchOn}"
                                    OnDetectionFinished="OnScannerDetectionFinished"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill" />

                <!-- Reticula Guia con Borde Lima -->
                <Grid HorizontalOptions="Center"
                      VerticalOptions="Center"
                      WidthRequest="290"
                      HeightRequest="190">
                    <Border StrokeShape="RoundRectangle 16"
                            StrokeThickness="2.5"
                            Stroke="{StaticResource StitchPrimary}"
                            Background="Transparent">
                        <Grid>
                            <!-- Linea Guia Central -->
                            <BoxView HeightRequest="2"
                                     Color="{StaticResource StitchPrimary}"
                                     Opacity="0.85"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Fill" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Barra Inferior de Cancelacion -->
            <VerticalStackLayout Grid.Row="2"
                                 Padding="24, 20"
                                 Spacing="12"
                                 BackgroundColor="#CC000000"
                                 HorizontalOptions="Fill">
                <Label Text="La detección es automática cuando el código se alinea con la línea verde."
                       FontFamily="Inter"
                       FontSize="11"
                       TextColor="#AAAAAA"
                       HorizontalOptions="Center" />

                <Button Text="Cancelar Escaneo"
                        Command="{Binding StopScanCommand}"
                        BackgroundColor="#262626"
                        TextColor="White"
                        FontFamily="Inter"
                        FontSize="13"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="46"
                        HorizontalOptions="Center"
                        WidthRequest="220" />
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>
