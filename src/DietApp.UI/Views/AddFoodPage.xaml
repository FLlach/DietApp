                                               FontFamily="Inter"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 4"
                                                StrokeThickness="0"
                                                Background="{StaticResource StitchSecondaryFixed}"
                                                Padding="4, 1">
