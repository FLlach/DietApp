<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.AddFoodPage"
             x:DataType="vm:AddFoodViewModel"
             Title="{loc:Translate AddFood_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWarm}, Dark={StaticResource Black}}">

    <!--
    Como funciona: Formulario de alta y parametrizacion de alimentos basado en el diseno Stitch 'Clinical Nutrition Ergonomics'.
    Permite registrar nuevos alimentos locales completando los datos generales de racion y energia,
    asi como la dosificacion cuantitativa de los 7 minerales criticos (mg).
    Por que se tomo esta decision: Asegura una captura precisa y sin errores mediante cajas de texto
    de 48dp y validacion inmediata en el ViewModel.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- 1. Encabezado Clinico -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16, 12"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="DIETAPP • ALTA NUTRICIONAL"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDark}" />
                    <Label Text="{loc:Translate AddFood_Title}"
                           FontAttributes="Bold"
                           FontSize="20"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                    <Label Text="{loc:Translate AddFood_Subtitle}"
                           FontSize="12"
                           TextColor="{StaticResource Outline}" />
                </VerticalStackLayout>
            </Border>

            <!-- Indicador de Carga -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryDark}"
                               HorizontalOptions="Center" />

            <!-- 2. Bento: Datos Generales y Energeticos -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Datos Generales y Ración Base"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                    <!-- Nombre del Alimento -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate AddFood_Name}"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="{StaticResource Outline}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 0">
                            <Entry Placeholder="{loc:Translate AddFood_NamePlaceholder}"
                                   Text="{Binding Name}"
                                   HeightRequest="48"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Categoria -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate AddFood_Category}"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="{StaticResource Outline}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 0">
                            <Entry Placeholder="{loc:Translate AddFood_CategoryPlaceholder}"
                                   Text="{Binding Category}"
                                   HeightRequest="48"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Porcion en Gramos -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate AddFood_PortionGrams}"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="{StaticResource Outline}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 0">
                            <Entry Placeholder="100"
                                   Keyboard="Numeric"
                                   Text="{Binding ReferenceGramsText}"
                                   HeightRequest="48"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Calorias y Proteinas -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{loc:Translate AddFood_Calories}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{StaticResource Outline}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                    Padding="8, 0">
                                <Entry Placeholder="0"
                                       Keyboard="Numeric"
                                       Text="{Binding CaloriesText}"
                                       HeightRequest="48"
                                       FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{loc:Translate AddFood_Protein}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{StaticResource Outline}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                    Padding="8, 0">
                                <Entry Placeholder="0"
                                       Keyboard="Numeric"
                                       Text="{Binding ProteinText}"
                                       HeightRequest="48"
                                       FontSize="14" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 3. Bento: Aportes de 7 Minerales Criticos (mg) -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate AddFood_MineralsTitle}"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- Fosforo -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="{loc:Translate Mineral_Phosphorus}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{StaticResource MineralPhosphorusText}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralPhosphorusBorder}"
                                    StrokeThickness="1"
                                    Background="{StaticResource MineralPhosphorusBg}"
                                    Padding="8, 0">
                                <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding PhosphorusText}" HeightRequest="48" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Potasio -->
                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                            <Label Text="{loc:Translate Mineral_Potassium}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{StaticResource MineralPotassiumText}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralPotassiumBorder}"
                                    StrokeThickness="1"
                                    Background="{StaticResource MineralPotassiumBg}"
                                    Padding="8, 0">
                                <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding PotassiumText}" HeightRequest="48" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Sodio -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                            <Label Text="{loc:Translate Mineral_Sodium}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{StaticResource MineralSodiumText}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralSodiumBorder}"
                                    StrokeThickness="1"
                                    Background="{StaticResource MineralSodiumBg}"
                                    Padding="8, 0">
                                <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding SodiumText}" HeightRequest="48" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Calcio -->
                        <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                            <Label Text="{loc:Translate Mineral_Calcium}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{StaticResource MineralCalciumText}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralCalciumBorder}"
                                    StrokeThickness="1"
                                    Background="{StaticResource MineralCalciumBg}"
                                    Padding="8, 0">
                                <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding CalciumText}" HeightRequest="48" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Magnesio -->
                        <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                            <Label Text="{loc:Translate Mineral_Magnesium}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{StaticResource MineralMagnesiumText}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralMagnesiumBorder}"
                                    StrokeThickness="1"
                                    Background="{StaticResource MineralMagnesiumBg}"
                                    Padding="8, 0">
                                <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding MagnesiumText}" HeightRequest="48" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Hierro -->
                        <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                            <Label Text="{loc:Translate Mineral_Iron}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{StaticResource MineralIronText}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralIronBorder}"
                                    StrokeThickness="1"
                                    Background="{StaticResource MineralIronBg}"
                                    Padding="8, 0">
                                <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding IronText}" HeightRequest="48" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Zinc -->
                        <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="4">
                            <Label Text="{loc:Translate Mineral_Zinc}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{StaticResource MineralZincText}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource MineralZincBorder}"
                                    StrokeThickness="1"
                                    Background="{StaticResource MineralZincBg}"
                                    Padding="8, 0">
                                <Entry Placeholder="0" Keyboard="Numeric" Text="{Binding ZincText}" HeightRequest="48" FontSize="14" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Mensaje de Estado -->
            <Label Text="{Binding FeedbackMessage}"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   FontSize="13"
                   TextColor="{StaticResource PrimaryDark}" />

            <!-- 4. Boton Guardar Alimento -->
            <Button Text="{loc:Translate AddFood_SaveButton}"
                    Command="{Binding SaveFoodCommand}"
                    Style="{StaticResource StitchPrimaryButtonStyle}"
                    HeightRequest="52"
                    MinimumHeightRequest="52"
                    FontSize="16"
                    Margin="0, 4, 0, 16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
