                                                   FontFamily="Inter"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource StitchOnSecondaryFixed}" />
                                        </Border>
                                    </Grid>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                                HeightRequest="36"
                                                Padding="6, 0">
                                            <Entry Text="{Binding PotassiumMgText, Mode=TwoWay}"
