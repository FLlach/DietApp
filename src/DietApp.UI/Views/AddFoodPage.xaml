                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                                   HorizontalTextAlignment="End"
                                                   BackgroundColor="Transparent"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1"
                                               Text="mg"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               TextColor="{StaticResource StitchOutline}"
                                               VerticalOptions="Center"
                                               Margin="6, 0, 0, 0" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 2. Fosforo (P) - Marcador Oseo -->
                            <Border Grid.Row="0" Grid.Column="1"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                    Padding="10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="Fósforo (P)"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 4"
                                                StrokeThickness="0"
                                                Background="{StaticResource StitchTertiaryFixed}"
                                                Padding="4, 1">
                                            <Label Text="Óseo"
                                                   FontFamily="Inter"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource StitchOnTertiaryFixed}" />
