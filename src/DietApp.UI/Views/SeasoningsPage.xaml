<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:dto="clr-namespace:DietApp.Application.DTOs;assembly=DietApp.Application"
             xmlns:models="clr-namespace:DietApp.UI.Models"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.SeasoningsPage"
             x:Name="ThisSeasoningsPage"
             x:DataType="vm:SeasoningsViewModel"
             Title="{loc:Translate Seasonings_Title}">

    <!--
    Como funciona: Pantalla de seleccion de componentes, alinos y registro (Vista B de DESIGN.md y mockupBase.jpeg).
    Muestra el carrusel superior de resumen de menu con pildoras de balance nutricional (Receta, Postre, Liquido),
    segmentacion por pestanas de categoria (Base, Alinos, Postre, Liquido), cuadricula interactiva 2x2 de alinos
    con fotografia y check activo, panel desplegable de formulacion y barra fija inferior con botones 'Agregar' y 'Completado'.
    Por que se tomo esta decision: Alinea la experiencia de armado y condimentacion con el prototipo visual oficial,
    asegurando alta fidelidad estetica, accesibilidad tactil y preservacion de la persistencia relacional en SQLite.
    -->

    <Grid RowDefinitions="*, Auto">
        <!-- Area Desplazable de Contenido Principal -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="14" Spacing="16">
                <!-- Indicador de Carga -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <!-- Mensaje de Estado / Notificacion Reactiva -->
                <Border StrokeShape="RoundRectangle 10"
                        Padding="12, 8"
                        Background="{AppThemeBinding Light=#FFF3ED, Dark=#2E1D16}"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        IsVisible="{Binding HasStatusMessage}">
                    <Label Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextColor="{StaticResource Primary}"
                           FontAttributes="Bold" />
                </Border>

                <!-- 1. Carrusel Superior de Resumen de Menu (mockupBase.jpeg) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding SummaryModules}"
                                           Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MealModuleSummaryModel">
                                <Border StrokeShape="RoundRectangle 14"
                                        WidthRequest="145"
                                        Padding="10"
                                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                        StrokeThickness="1">
                                    <VerticalStackLayout Spacing="6">
                                        <!-- Cabecera de la Tarjeta con Icono de Badge o Imagen -->
                                        <Grid ColumnDefinitions="*, Auto" HeightRequest="45">
                                            <!-- Miniatura de Imagen si existe -->
                                            <Border Grid.Column="0"
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    WidthRequest="45"
                                                    HeightRequest="45"
                                                    HorizontalOptions="Start"
                                                    IsVisible="{Binding HasImage}">
                                                <Image Source="{Binding ImagePath}"
                                                       Aspect="AspectFit" />
                                            </Border>

                                            <!-- Badge de Estado (Alerta '!' o Check) -->
                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 11"
                                                    WidthRequest="22"
                                                    HeightRequest="22"
                                                    Padding="0"
                                                    StrokeThickness="0"
                                                    Background="{Binding IsAlertBadge, Converter={x:Null}}"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Start">
                                                <Label Text="{Binding BadgeIcon}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Titulo y Porcion -->
                                        <VerticalStackLayout Spacing="1">
                                            <Label Text="{Binding Title}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding PortionText}"
                                                   FontSize="11"
                                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                        </VerticalStackLayout>

                                        <!-- Pildoras Nutricionales Internas -->
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding NutrientPills}"
                                                             Spacing="3"
                                                             Margin="0, 2, 0, 0">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:NutrientPillItemModel">
                                                    <Border StrokeShape="RoundRectangle 10"
                                                            Padding="6, 2"
                                                            StrokeThickness="0.5"
                                                            Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                                            Background="{AppThemeBinding Light=#FFFBF8, Dark=#26262B}">
                                                        <Label Text="{Binding Text}"
                                                               FontSize="10"
                                                               FontAttributes="Bold"
                                                               HorizontalTextAlignment="Center"
                                                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- 2. Segmentacion por Categorias (Tabs) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0, 4, 0, 2">
                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categories}"
                                           Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border StrokeShape="RoundRectangle 16"
                                        Padding="16, 6"
                                        StrokeThickness="1"
                                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference ThisSeasoningsPage}, Path=BindingContext.SelectCategoryCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding .}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- 3. Cuadricula 2x2 de Seleccion de Alinos con Fotografia (mockupBase.jpeg) -->
                <FlexLayout BindableLayout.ItemsSource="{Binding SelectableSeasonings}"
                            Wrap="Wrap"
                            JustifyContent="SpaceBetween"
                            AlignItems="Start">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ComponentSelectionItemModel">
                            <Border FlexLayout.Basis="48%"
                                    Style="{StaticResource IngredientCardStyle}"
                                    Margin="0, 0, 0, 12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference ThisSeasoningsPage}, Path=BindingContext.ToggleSelectableItemCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="Auto, Auto">
                                    <!-- Badge de Check Coral en Esquina Superior Derecha -->
                                    <Border Grid.Row="0"
                                            StrokeShape="RoundRectangle 12"
                                            WidthRequest="24"
                                            HeightRequest="24"
                                            Padding="0"
                                            StrokeThickness="0"
                                            Background="{StaticResource PrimaryBrush}"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            IsVisible="{Binding IsSelected}"
                                            ZIndex="2">
                                        <Label Text="✓"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <!-- Imagen Centrada del Alino -->
                                    <Border Grid.Row="0"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="0"
                                            StrokeThickness="0"
                                            HeightRequest="90"
                                            WidthRequest="120"
                                            Background="Transparent"
                                            HorizontalOptions="Center">
                                        <Image Source="{Binding ImagePath}"
                                               Aspect="AspectFit"
                                               HeightRequest="90"
                                               WidthRequest="120" />
                                    </Border>

                                    <!-- Titulo del Alino -->
                                    <Label Grid.Row="1"
                                           Text="{Binding Title}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           Margin="0, 6, 0, 0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- 4. Tarjeta Desplegable de Creacion de Nuevo Alino Personalizado -->
                <Border StrokeShape="RoundRectangle 14"
                        Padding="16"
                        IsVisible="{Binding IsCreatePanelVisible}"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1.5"
                        Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{loc:Translate Seasonings_CreateHeader}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{StaticResource Primary}" />

                        <!-- Nombre del Alino -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate Seasonings_Name}"
                                   FontAttributes="Bold"
                                   FontSize="12" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Padding="10, 4"
                                    Background="{AppThemeBinding Light=#F8F5F2, Dark=#26262B}">
                                <Entry Text="{Binding Name}"
                                       Placeholder="{loc:Translate Seasonings_NamePlaceholder}"
                                       FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Descripcion -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate Seasonings_Description}"
                                   FontAttributes="Bold"
                                   FontSize="12" />
                            <Border StrokeShape="RoundRectangle 8"
                                    Padding="10, 4"
                                    Background="{AppThemeBinding Light=#F8F5F2, Dark=#26262B}">
                                <Entry Text="{Binding Description}"
                                       Placeholder="{loc:Translate Seasonings_DescriptionPlaceholder}"
                                       FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Dosificacion de Alimentos -->
                        <Label Text="{loc:Translate Seasonings_IngredientsTitle}"
                               FontAttributes="Bold"
                               FontSize="13" />

                        <Grid ColumnDefinitions="*, 75, Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="6, 2"
                                    Background="{AppThemeBinding Light=#F8F5F2, Dark=#26262B}">
                                <Picker ItemsSource="{Binding AvailableFoods}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedFood}"
                                        Title="{loc:Translate Seasonings_SelectFoodPlaceholder}"
                                        FontSize="12" />
                            </Border>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="6, 2"
                                    Background="{AppThemeBinding Light=#F8F5F2, Dark=#26262B}">
                                <Entry Text="{Binding GramsText}"
                                       Keyboard="Numeric"
                                       Placeholder="g"
                                       HorizontalTextAlignment="Center"
                                       FontSize="12" />
                            </Border>

                            <Button Grid.Column="2"
                                    Text="+"
                                    Command="{Binding AddDraftItemCommand}"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    WidthRequest="44"
                                    HeightRequest="44"
                                    MinimumHeightRequest="44"
                                    MinimumWidthRequest="44"
                                    BackgroundColor="{StaticResource Secondary}"
                                    TextColor="{StaticResource ContrastDark}" />
                        </Grid>

                        <!-- Lista de Ingredientes en el Borrador -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DraftItems}"
                                             Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SeasoningDraftItemModel">
                                    <Border StrokeShape="RoundRectangle 6"
                                            Padding="10, 6"
                                            Background="{AppThemeBinding Light=#F4F0EC, Dark=#26262B}">
                                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                            <Label Grid.Column="0"
                                                   Text="{Binding DisplayText}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center" />

                                            <Button Grid.Column="1"
                                                    Text="✕"
                                                    Command="{Binding Source={x:Reference ThisSeasoningsPage}, Path=BindingContext.RemoveDraftItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    MinimumHeightRequest="44"
                                                    MinimumWidthRequest="44"
                                                    Padding="0"
                                                    BackgroundColor="{StaticResource AlertRed}"
                                                    TextColor="White" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Botones Guardar y Cancelar -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0, 6, 0, 0">
                            <Button Grid.Column="0"
                                    Text="{loc:Translate Seasonings_SaveSeasoning}"
                                    Command="{Binding SaveSeasoningCommand}"
                                    Style="{StaticResource PillActionCompletedStyle}" />

                            <Button Grid.Column="1"
                                    Text="{loc:Translate Seasonings_Cancel}"
                                    Command="{Binding ToggleCreatePanelCommand}"
                                    Style="{StaticResource PillActionSecondaryStyle}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 5. Listado de Alinos Guardados en Persistencia SQLite -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Seasonings}"
                                     Spacing="10"
                                     Margin="0, 4, 0, 10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="dto:SeasoningDto">
                            <Border StrokeShape="RoundRectangle 12"
                                    Padding="12"
                                    Background="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                    StrokeThickness="1">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               VerticalOptions="Center" />

                                        <Border Grid.Column="1"
                                                StrokeShape="RoundRectangle 6"
                                                Padding="6, 2"
                                                Background="{AppThemeBinding Light=#FFF3ED, Dark=#2E1D16}">
                                            <Label Text="{Binding TotalCalories, StringFormat='{0:F0} kcal'}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                        </Border>

                                        <Button Grid.Column="2"
                                                Text="{loc:Translate Seasonings_Delete}"
                                                Command="{Binding Source={x:Reference ThisSeasoningsPage}, Path=BindingContext.DeleteSeasoningCommand}"
                                                CommandParameter="{Binding Id}"
                                                FontSize="11"
                                                HeightRequest="44"
                                                MinimumHeightRequest="44"
                                                Padding="10, 2"
                                                BackgroundColor="{StaticResource AlertRed}"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                    </Grid>
                                    <Label Text="{Binding Description}"
                                           FontSize="12"
                                           TextColor="Gray"
                                           IsVisible="{Binding HasDescription}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 6. Barra Fija de Acciones Inferiores (mockupBase.jpeg) -->
        <Border Grid.Row="1"
                StrokeShape="RoundRectangle 24"
                Background="{AppThemeBinding Light={StaticResource ContrastDark}, Dark=#18181B}"
                Padding="16, 12"
                Margin="14, 0, 14, 12"
                StrokeThickness="0"
                ZIndex="10">
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <!-- Boton Secundario: Agregar (Blanco con Borde y Texto Oscuro) -->
                <Button Grid.Column="0"
                        Text="Agregar"
                        Command="{Binding ToggleCreatePanelCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}"
                        BorderColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}"
                        BorderWidth="1.5"
                        FontAttributes="Bold"
                        CornerRadius="22"
                        HeightRequest="44"
                        MinimumHeightRequest="44"
                        Padding="16, 8" />

                <!-- Boton Primario: Completado (Verde Lima Suave con Texto Oscuro) -->
                <Button Grid.Column="1"
                        Text="Completado"
                        Command="{Binding CompleteSelectionCommand}"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="{StaticResource ContrastDark}"
                        FontAttributes="Bold"
                        CornerRadius="22"
                        HeightRequest="44"
                        MinimumHeightRequest="44"
                        Padding="16, 8" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
