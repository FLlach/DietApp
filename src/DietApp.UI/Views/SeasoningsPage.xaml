<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:dto="clr-namespace:DietApp.Application.DTOs;assembly=DietApp.Application"
             xmlns:models="clr-namespace:DietApp.UI.Models"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.SeasoningsPage"
             x:Name="ThisSeasoningsPage"
             x:DataType="vm:SeasoningsViewModel"
             Title="{loc:Translate Seasonings_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">

    <!--
    Como funciona: Pantalla de seleccion y dosificacion de alinos conforme a la pantalla Stitch 'Modulo de Alinos (SeasoningsPage)'.
    Presenta cabecera clinica con boton de retorno en 48dp, alerta de tolerancia renal electrolitica,
    selector horizontal de destino del alino, cuadricula 2x2 de alinos con fotografia y badges de check,
    estudio constructor de alino casero y dock fijo inferior ergonomico.
    Por que se tomo esta decision: Cumple con las especificaciones de Stitch 'Clinical Nutrition Ergonomics',
    garantizando un area minima de 48dp en controles interactivos y contraste AA para control renal.
    -->

    <Grid RowDefinitions="*, Auto">
        <!-- Area Desplazable de Contenido Principal -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16" Spacing="16">
                <!-- Indicador de Carga -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center" />

                <!-- 1. Cabecera Clinica Stitch con Retorno Tactil -->
                <Border Style="{StaticResource StitchCardStyle}"
                        Padding="16, 12">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                        <Button Grid.Column="0"
                                Text="←"
                                Clicked="OnBackClicked"
                                Style="{StaticResource StitchNeutralButtonStyle}"
                                WidthRequest="48"
                                HeightRequest="48"
                                MinimumWidthRequest="48"
                                MinimumHeightRequest="48"
                                FontSize="20"
                                Padding="0" />

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="DIETAPP CLINICAL • CONDIMENTOS"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}" />
                            <Label Text="{loc:Translate Seasonings_Title}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                            <Label Text="Dosificación y Control Renal Electrolítico"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Mensaje de Estado / Notificacion Reactiva -->
                <Border StrokeShape="RoundRectangle 12"
                        Padding="14, 10"
                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        IsVisible="{Binding HasStatusMessage}">
                    <Label Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextColor="{StaticResource PrimaryDark}"
                           FontAttributes="Bold" />
                </Border>

                <!-- 2. Alerta de Tolerancia Renal y Seguridad Mineral -->
                <Border StrokeShape="RoundRectangle 14"
                        Padding="14, 12"
                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                        StrokeThickness="1">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 20"
                                WidthRequest="40"
                                HeightRequest="40"
                                Background="{StaticResource Primary}"
                                VerticalOptions="Start">
                            <Label Text="✓"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="Tolerancia Renal Estimada: Óptima"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                            <Label Text="Los condimentos seleccionados evitan sales sintéticas (NaCl) y preservan el margen electrolítico de sodio y potasio."
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 3. Destino del Aliño (Pestañas Horizontales) -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Destino del Aliño"
                           FontAttributes="Bold"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categories}"
                                               Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border StrokeShape="RoundRectangle 24"
                                            Padding="16, 10"
                                            StrokeThickness="1"
                                            HeightRequest="48"
                                            Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                            Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={x:Reference ThisSeasoningsPage}, Path=BindingContext.SelectCategoryCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding .}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!-- 4. Cuadricula 2x2 de Seleccion de Alinos con Fotografia -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Opciones Preconfiguradas"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />

                    <FlexLayout BindableLayout.ItemsSource="{Binding SelectableSeasonings}"
                                Wrap="Wrap"
                                JustifyContent="SpaceBetween"
                                AlignItems="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ComponentSelectionItemModel">
                                <Border FlexLayout.Basis="48%"
                                        Style="{StaticResource StitchCardStyle}"
                                        Padding="12"
                                        Margin="0, 0, 0, 12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference ThisSeasoningsPage}, Path=BindingContext.ToggleSelectableItemCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto, Auto, Auto">
                                        <!-- Badge de Check en Esquina Superior Derecha -->
                                        <Border Grid.Row="0"
                                                StrokeShape="RoundRectangle 12"
                                                WidthRequest="26"
                                                HeightRequest="26"
                                                Padding="0"
                                                StrokeThickness="0"
                                                Background="{StaticResource Primary}"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                IsVisible="{Binding IsSelected}"
                                                ZIndex="2">
                                            <Label Text="✓"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- Imagen Centrada del Alino -->
                                        <Border Grid.Row="0"
                                                StrokeShape="RoundRectangle 10"
                                                Padding="0"
                                                StrokeThickness="0"
                                                HeightRequest="85"
                                                WidthRequest="110"
                                                Background="Transparent"
                                                HorizontalOptions="Center">
                                            <Image Source="{Binding ImagePath}"
                                                   Aspect="AspectFit"
                                                   HeightRequest="85"
                                                   WidthRequest="110" />
                                        </Border>

                                        <!-- Titulo del Alino -->
                                        <Label Grid.Row="1"
                                               Text="{Binding Title}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               Margin="0, 6, 0, 4"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />

                                        <!-- Mini Pastilla Informativa -->
                                        <Border Grid.Row="2"
                                                StrokeShape="RoundRectangle 8"
                                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}"
                                                Padding="6, 2"
                                                HorizontalOptions="Center">
                                            <Label Text="Renal Seguro"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource PrimaryDark}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- 5. Constructor de Aliño Casero (Custom Seasoning Formulation Studio) -->
                <Border Style="{StaticResource StitchCardStyle}"
                        Padding="16"
                        IsVisible="{Binding IsCreatePanelVisible}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{loc:Translate Seasonings_CreateHeader}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                <Label Text="Combina bases e infunde extractos libres de sodio"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="✕"
                                    Command="{Binding ToggleCreatePanelCommand}"
                                    Style="{StaticResource StitchNeutralButtonStyle}"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    MinimumWidthRequest="40"
                                    MinimumHeightRequest="40"
                                    Padding="0"
                                    FontSize="14" />
                        </Grid>

                        <!-- Nombre del Aliño -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate Seasonings_Name}"
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    HeightRequest="48"
                                    Padding="10, 0">
                                <Entry Text="{Binding Name}"
                                       Placeholder="{loc:Translate Seasonings_NamePlaceholder}"
                                       HeightRequest="48"
                                       FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Descripcion -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{loc:Translate Seasonings_Description}"
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    HeightRequest="48"
                                    Padding="10, 0">
                                <Entry Text="{Binding Description}"
                                       Placeholder="{loc:Translate Seasonings_DescriptionPlaceholder}"
                                       HeightRequest="48"
                                       FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Dosificacion de Alimentos -->
                        <Label Text="{loc:Translate Seasonings_IngredientsTitle}"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />

                        <Grid ColumnDefinitions="*, 80, Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    HeightRequest="48"
                                    Padding="10, 0">
                                <Picker ItemsSource="{Binding AvailableFoods}"
                                        ItemDisplayBinding="{Binding Name}"
                                        SelectedItem="{Binding SelectedFood}"
                                        Title="{loc:Translate Seasonings_SelectFoodPlaceholder}"
                                        HeightRequest="48"
                                        FontSize="12" />
                            </Border>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                                    HeightRequest="48"
                                    Padding="6, 0">
                                <Entry Text="{Binding GramsText}"
                                       Keyboard="Numeric"
                                       Placeholder="g"
                                       HorizontalTextAlignment="Center"
                                       HeightRequest="48"
                                       FontSize="13" />
                            </Border>

                            <Button Grid.Column="2"
                                    Text="+"
                                    Command="{Binding AddDraftItemCommand}"
                                    Style="{StaticResource StitchNeutralButtonStyle}"
                                    WidthRequest="48"
                                    HeightRequest="48"
                                    MinimumWidthRequest="48"
                                    MinimumHeightRequest="48"
                                    FontSize="20"
                                    Padding="0" />
                        </Grid>

                        <!-- Lista de Ingredientes en el Borrador -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DraftItems}"
                                             Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SeasoningDraftItemModel">
                                    <Border StrokeShape="RoundRectangle 10"
                                            Padding="12, 8"
                                            Background="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}"
                                            Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                                            StrokeThickness="1">
                                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                            <Label Grid.Column="0"
                                                   Text="{Binding DisplayText}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                                                   VerticalOptions="Center" />

                                            <Button Grid.Column="1"
                                                    Text="✕"
                                                    Command="{Binding Source={x:Reference ThisSeasoningsPage}, Path=BindingContext.RemoveDraftItemCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    MinimumHeightRequest="40"
                                                    MinimumWidthRequest="40"
                                                    Padding="0"
                                                    BackgroundColor="{StaticResource Secondary}"
                                                    TextColor="White"
                                                    CornerRadius="10" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Botones Guardar y Cancelar -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0, 6, 0, 0">
                            <Button Grid.Column="0"
                                    Text="{loc:Translate Seasonings_SaveSeasoning}"
                                    Command="{Binding SaveSeasoningCommand}"
                                    Style="{StaticResource StitchPrimaryButtonStyle}"
                                    HeightRequest="48"
                                    MinimumHeightRequest="48" />

                            <Button Grid.Column="1"
                                    Text="{loc:Translate Seasonings_Cancel}"
                                    Command="{Binding ToggleCreatePanelCommand}"
                                    Style="{StaticResource StitchNeutralButtonStyle}"
                                    HeightRequest="48"
                                    MinimumHeightRequest="48" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 6. Listado de Aliños Guardados en SQLite -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Aliños Guardados en Catálogo"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Seasonings}"
                                         Spacing="10">
                        <BindableLayout.EmptyView>
                            <Border Style="{StaticResource StitchCardStyle}"
                                    Padding="16">
                                <Label Text="No hay aliños guardados. Puedes crear uno con el botón 'Nuevo Aliño'."
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                            </Border>
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:SeasoningDto">
                                <Border Style="{StaticResource StitchCardStyle}"
                                        Padding="14">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}"
                                                   VerticalOptions="Center" />

                                            <Border Grid.Column="1"
                                                    StrokeShape="RoundRectangle 8"
                                                    Padding="8, 2"
                                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLight}, Dark={StaticResource SurfaceContainerDark}}">
                                                <Label Text="{Binding TotalCalories, StringFormat='{0:F0} kcal'}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" />
                                            </Border>

                                            <Button Grid.Column="2"
                                                    Text="✕"
                                                    Command="{Binding Source={x:Reference ThisSeasoningsPage}, Path=BindingContext.DeleteSeasoningCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    FontSize="12"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    MinimumHeightRequest="40"
                                                    MinimumWidthRequest="40"
                                                    Padding="0"
                                                    CornerRadius="10"
                                                    BackgroundColor="{StaticResource Secondary}"
                                                    TextColor="White"
                                                    VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding Description}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                                               IsVisible="{Binding HasDescription}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- 7. Barra Fija Inferior de Accion (Dual Action Dock de 48dp) -->
        <Border Grid.Row="1"
                StrokeShape="Rectangle"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource OutlineLightBrush}, Dark={StaticResource OutlineDarkBrush}}"
                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource SurfaceContainerDark}}"
                Padding="16, 12">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                <!-- Boton Secundario: Nuevo Aliño -->
                <Button Grid.Column="0"
                        Text="+ Nuevo Aliño"
                        Command="{Binding ToggleCreatePanelCommand}"
                        Style="{StaticResource StitchNeutralButtonStyle}"
                        HeightRequest="48"
                        MinimumHeightRequest="48"
                        Padding="16, 0" />

                <!-- Boton Primario: Aplicar a Receta / Registro -->
                <Button Grid.Column="1"
                        Text="Aplicar Selección"
                        Command="{Binding CompleteSelectionCommand}"
                        Style="{StaticResource StitchPrimaryButtonStyle}"
                        HeightRequest="48"
                        MinimumHeightRequest="48"
                        Padding="16, 0" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
