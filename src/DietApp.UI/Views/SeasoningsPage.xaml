<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:dto="clr-namespace:DietApp.Application.DTOs;assembly=DietApp.Application"
             xmlns:models="clr-namespace:DietApp.UI.Models"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.SeasoningsPage"
             x:Name="ThisSeasoningsPage"
             x:DataType="vm:SeasoningsViewModel"
             Title="{loc:Translate Seasonings_Title}">

    <!--
    Como funciona: Pantalla de gestion de alinos y condimentos. Permite visualizar mezclas preconfiguradas,
    crear nuevos alinos dosificando alimentos del catalogo con calculo de minerales, y administrarlos
    para su incorporacion automatica e instantanea en recetas culinarias.
    Por que se tomo esta decision: En DDD, provee una seccion visual dedicada que acelera la preparacion
    de recetas complejas al evitar la carga repetitiva de condimentos comunes como vinagretas o adobos.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- Encabezado de la Seccion -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="{loc:Translate Seasonings_Title}"
                           FontAttributes="Bold"
                           FontSize="20" />
                    <Label Text="{loc:Translate Seasonings_Subtitle}"
                           FontSize="13"
                           TextColor="Gray" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="{loc:Translate Seasonings_NewSeasoning}"
                        Command="{Binding ToggleCreatePanelCommand}"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="44"
                        MinimumHeightRequest="44"
                        Padding="14, 0"
                        BackgroundColor="#27AE60"
                        TextColor="White"
                        VerticalOptions="Center" />
            </Grid>

            <!-- Indicador de Carga -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />

            <!-- Mensaje de Estado / Notificacion -->
            <Border StrokeShape="RoundRectangle 8"
                    Padding="12, 8"
                    Background="{AppThemeBinding Light=#E8F8F5, Dark=#142D27}"
                    Stroke="#2ECC71"
                    StrokeThickness="1"
                    IsVisible="{Binding HasStatusMessage}">
                <Label Text="{Binding StatusMessage}"
                       FontSize="13"
                       TextColor="#16A085"
                       FontAttributes="Bold" />
            </Border>

            <!-- Tarjeta de Creacion de Nuevo Alino (Desplegable) -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="16"
                    IsVisible="{Binding IsCreatePanelVisible}"
                    Stroke="#27AE60"
                    StrokeThickness="1.5"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate Seasonings_CreateHeader}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light=#1E8449, Dark=#2ECC71}" />

                    <!-- Nombre del Alino -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate Seasonings_Name}"
                               FontAttributes="Bold"
                               FontSize="13" />
                        <Border StrokeShape="RoundRectangle 8"
                                Padding="10, 4"
                                Background="{AppThemeBinding Light=#F8F9F9, Dark=#1A1A22}">
                            <Entry Text="{Binding Name}"
                                   Placeholder="{loc:Translate Seasonings_NamePlaceholder}"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Descripcion o Notas -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate Seasonings_Description}"
                               FontAttributes="Bold"
                               FontSize="13" />
                        <Border StrokeShape="RoundRectangle 8"
                                Padding="10, 4"
                                Background="{AppThemeBinding Light=#F8F9F9, Dark=#1A1A22}">
                            <Entry Text="{Binding Description}"
                                   Placeholder="{loc:Translate Seasonings_DescriptionPlaceholder}"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Seccion de Ingredientes del Alino -->
                    <Label Text="{loc:Translate Seasonings_IngredientsTitle}"
                           FontAttributes="Bold"
                           FontSize="14"
                           Margin="0, 4, 0, 0" />

                    <Grid ColumnDefinitions="*, 80, Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <!-- Selector de Alimento -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="6, 2"
                                Background="{AppThemeBinding Light=#F8F9F9, Dark=#1A1A22}">
                            <Picker ItemsSource="{Binding AvailableFoods}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedFood}"
                                    Title="{loc:Translate Seasonings_SelectFoodPlaceholder}"
                                    FontSize="13" />
                        </Border>

                        <!-- Entrada de Gramos -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="6, 2"
                                Background="{AppThemeBinding Light=#F8F9F9, Dark=#1A1A22}">
                            <Entry Text="{Binding GramsText}"
                                   Keyboard="Numeric"
                                   Placeholder="g"
                                   HorizontalTextAlignment="Center"
                                   FontSize="13" />
                        </Border>

                        <!-- Boton Agregar Componente -->
                        <Button Grid.Column="2"
                                Text="+"
                                Command="{Binding AddDraftItemCommand}"
                                FontAttributes="Bold"
                                FontSize="18"
                                WidthRequest="44"
                                HeightRequest="44"
                                MinimumHeightRequest="44"
                                MinimumWidthRequest="44"
                                BackgroundColor="#3498DB"
                                TextColor="White" />
                    </Grid>

                    <!-- Lista de Ingredientes en el Borrador -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DraftItems}"
                                         Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:SeasoningDraftItemModel">
                                <Border StrokeShape="RoundRectangle 6"
                                        Padding="10, 6"
                                        Background="{AppThemeBinding Light=#EAEDED, Dark=#2C3E50}">
                                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                        <Label Grid.Column="0"
                                               Text="{Binding DisplayText}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center" />

                                        <Button Grid.Column="1"
                                                Text="X"
                                                Command="{Binding Source={x:Reference ThisSeasoningsPage}, Path=BindingContext.RemoveDraftItemCommand}"
                                                CommandParameter="{Binding .}"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                WidthRequest="44"
                                                HeightRequest="44"
                                                MinimumHeightRequest="44"
                                                MinimumWidthRequest="44"
                                                Padding="0"
                                                BackgroundColor="#E74C3C"
                                                TextColor="White" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Botones Guardar y Cancelar -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0, 8, 0, 0">
                        <Button Grid.Column="0"
                                Text="{loc:Translate Seasonings_SaveSeasoning}"
                                Command="{Binding SaveSeasoningCommand}"
                                FontAttributes="Bold"
                                HeightRequest="44"
                                FontSize="13"
                                BackgroundColor="#27AE60"
                                TextColor="White" />

                        <Button Grid.Column="1"
                                Text="{loc:Translate Seasonings_Cancel}"
                                Command="{Binding ToggleCreatePanelCommand}"
                                HeightRequest="44"
                                FontSize="13"
                                BackgroundColor="#95A5A6"
                                TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Listado de Alinos Registrados -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Seasonings}"
                                 Spacing="12">
                <BindableLayout.EmptyView>
                    <Label Text="{loc:Translate Seasonings_Empty}"
                           TextColor="Gray"
                           HorizontalTextAlignment="Center"
                           Margin="0, 30, 0, 30"
                           FontSize="14" />
                </BindableLayout.EmptyView>

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="dto:SeasoningDto">
                        <Border StrokeShape="RoundRectangle 12"
                                Padding="14"
                                Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                            <VerticalStackLayout Spacing="10">
                                <!-- Cabecera del Alino con Badges y Eliminar -->
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                    <Label Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="16"
                                           VerticalOptions="Center" />

                                    <!-- Badge de Peso Total y Calorias -->
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 6"
                                                Padding="8, 3"
                                                Background="{AppThemeBinding Light=#EBF5FB, Dark=#1B2631}">
                                            <Label Text="{Binding TotalGrams, StringFormat='{0:F0} g'}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#2980B9" />
                                        </Border>

                                        <Border StrokeShape="RoundRectangle 6"
                                                Padding="8, 3"
                                                Background="{AppThemeBinding Light=#FEF9E7, Dark=#2A2518}">
                                            <Label Text="{Binding TotalCalories, StringFormat='{0:F0} kcal'}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#D4AC0D" />
                                        </Border>
                                    </HorizontalStackLayout>

                                    <!-- Boton Eliminar -->
                                    <Button Grid.Column="2"
                                            Text="{loc:Translate Seasonings_Delete}"
                                            Command="{Binding Source={x:Reference ThisSeasoningsPage}, Path=BindingContext.DeleteSeasoningCommand}"
                                            CommandParameter="{Binding Id}"
                                            FontSize="12"
                                            HeightRequest="44"
                                            MinimumHeightRequest="44"
                                            Padding="12, 4"
                                            BackgroundColor="#E74C3C"
                                            TextColor="White"
                                            VerticalOptions="Center" />
                                </Grid>

                                <!-- Descripcion -->
                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       TextColor="Gray"
                                       IsVisible="{Binding HasDescription}" />

                                <!-- Ingredientes que Componen el Alino -->
                                <Label Text="{loc:Translate Seasonings_IngredientsIncluded}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#566573, Dark=#BDC3C7}" />

                                <FlexLayout BindableLayout.ItemsSource="{Binding Items}"
                                            Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="dto:SeasoningItemDto">
                                            <Border Margin="0, 2, 6, 4"
                                                    Padding="8, 4"
                                                    StrokeShape="RoundRectangle 6"
                                                    Background="{AppThemeBinding Light=#F4F6F7, Dark=#1A1A22}">
                                                <Label Text="{Binding DisplayText}"
                                                       FontSize="11"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <!-- Minerales Aportados por el Alino -->
                                <Label Text="{loc:Translate Seasonings_MineralBalance}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#566573, Dark=#BDC3C7}" />

                                <FlexLayout BindableLayout.ItemsSource="{Binding TotalMinerals}"
                                            Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="dto:MineralAmountDto">
                                            <Border Margin="0, 2, 6, 4"
                                                    Padding="6, 2"
                                                    StrokeShape="RoundRectangle 6"
                                                    Background="{AppThemeBinding Light=#D5F5E3, Dark=#1E3F2D}">
                                                <Label Text="{Binding DisplayText}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#196F3D, Dark=#2ECC71}"
                                                       FontAttributes="Bold" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
