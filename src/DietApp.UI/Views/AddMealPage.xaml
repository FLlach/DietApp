<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:models="clr-namespace:DietApp.UI.Models"
             x:Class="DietApp.UI.Views.AddMealPage"
             x:DataType="vm:AddMealViewModel"
             x:Name="ThisPage"
             Title="Registrar Comida">

    <!--
    Como funciona: Interfaz para armar y registrar una comida con uno o mas alimentos,
    especificando el gramaje exacto de cada uno para calcular los minerales resultantes.
    Por que se tomo esta decision: Permite al usuario componer un plato o ingesta completa
    en un solo paso antes de consolidar el conteo en el historial.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label Text="Registrar Nueva Comida"
                   FontAttributes="Bold"
                   FontSize="18" />

            <!-- Encabezado de la comida -->
            <Border StrokeShape="RoundRectangle 10"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="8">
                    <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                        <Label Text="Fecha" FontAttributes="Bold" FontSize="12" />
                        <DatePicker Date="{Binding MealDate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                        <Label Text="Momento" FontAttributes="Bold" FontSize="12" />
                        <Picker ItemsSource="{Binding MealTypeOptions}"
                                SelectedItem="{Binding SelectedMealTypeName}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2">
                        <Label Text="Nota u Observacion (opcional)" FontAttributes="Bold" FontSize="12" />
                        <Entry Placeholder="Ej: Almuerzo liviano post entrenamiento"
                               Text="{Binding Note}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Seccion para agregar un alimento -->
            <Label Text="Agregar Alimento del Catalogo"
                   FontAttributes="Bold"
                   FontSize="15" />

            <Border StrokeShape="RoundRectangle 10"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Seleccionar Alimento del Catalogo" FontAttributes="Bold" FontSize="12" />
                    <Picker ItemsSource="{Binding AvailableFoods}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedFood}"
                            Title="Toca para elegir alimento..." />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Gramos consumidos" FontAttributes="Bold" FontSize="12" />
                            <Entry Placeholder="100"
                                   Keyboard="Numeric"
                                   Text="{Binding PortionGramsText}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="+ Agregar Alimento"
                                VerticalOptions="End"
                                Command="{Binding AddFoodToMealCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Seccion para agregar una receta -->
            <Label Text="O Agregar Receta Culinaria"
                   FontAttributes="Bold"
                   FontSize="15" />

            <Border StrokeShape="RoundRectangle 10"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Seleccionar Receta" FontAttributes="Bold" FontSize="12" />
                    <Picker ItemsSource="{Binding AvailableRecipes}"
                            ItemDisplayBinding="{Binding Title}"
                            SelectedItem="{Binding SelectedRecipe}"
                            Title="Toca para elegir receta..." />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Porciones consumidas" FontAttributes="Bold" FontSize="12" />
                            <Entry Placeholder="1"
                                   Keyboard="Numeric"
                                   Text="{Binding RecipeServingsText}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="+ Agregar Receta"
                                VerticalOptions="End"
                                BackgroundColor="#27AE60"
                                TextColor="White"
                                Command="{Binding AddRecipeToMealCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Lista de Alimentos y Recetas Agregados a la Comida Actual -->
            <Label Text="Items en esta Comida:"
                   FontAttributes="Bold"
                   FontSize="15" />

            <Border StrokeShape="RoundRectangle 10"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="8">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedItems}"
                                         Spacing="6">
                        <BindableLayout.EmptyView>
                            <Label Text="Aun no has agregado alimentos ni recetas a esta comida."
                                   TextColor="Gray"
                                   HorizontalTextAlignment="Center"
                                   Padding="10" />
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MealDraftItemModel">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding FoodName}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding GramsDisplay}" TextColor="Gray" VerticalOptions="Center" />
                                    <Button Grid.Column="2"
                                            Text="Quitar"
                                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.RemoveItemCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#E74C3C"
                                            TextColor="White"
                                            FontSize="11"
                                            Padding="6, 2" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Mensaje de estado -->
            <Label Text="{Binding StatusMessage}"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="#2980B9" />

            <!-- Boton Guardar Comida -->
            <Button Text="Guardar Comida y Calcular Minerales"
                    Command="{Binding SaveMealCommand}"
                    FontAttributes="Bold"
                    HeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
