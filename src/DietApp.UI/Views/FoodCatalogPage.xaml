<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:dto="clr-namespace:DietApp.Application.DTOs;assembly=DietApp.Application"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.FoodCatalogPage"
             x:DataType="vm:FoodCatalogViewModel"
             Title="{loc:Translate FoodCatalog_Title}">

    <!--
    Como funciona: Vista que permite consultar alimentos y aplicar filtros avanzados
    por concentracion de minerales (fosforo, potasio, sodio, etc.) y texto.
    Por que se tomo esta decision: Responde a la necesidad central del usuario de poder
    filtrar de forma efectiva alimentos segun su aporte mineral antes de incluirlos en comidas.
    -->

    <Grid RowDefinitions="Auto, *">
        <!-- Panel de Filtro de Minerales -->
        <Border Grid.Row="0"
                Margin="12"
                Padding="14"
                StrokeShape="RoundRectangle 12"
                Background="{AppThemeBinding Light=#F8F9FA, Dark=#1E1E24}">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="{loc:Translate FoodCatalog_FilterTitle}"
                           FontAttributes="Bold"
                           FontSize="16"
                           VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            Text="{loc:Translate FoodCatalog_NewFood}"
                            Command="{Binding NavigateToAddFoodCommand}"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="44"
                            MinimumHeightRequest="44"
                            Padding="12, 0"
                            VerticalOptions="Center" />
                </Grid>

                <!-- Buscador de texto -->
                <SearchBar Placeholder="{loc:Translate FoodCatalog_SearchName}"
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding ApplyFilterCommand}" />

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                    <!-- Selector de Mineral -->
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="{loc:Translate FoodCatalog_Mineral}" FontSize="12" TextColor="Gray" />
                        <Picker ItemsSource="{Binding MineralOptions}"
                                SelectedItem="{Binding SelectedMineralName}" />
                    </VerticalStackLayout>

                    <!-- Minimo mg -->
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="{loc:Translate FoodCatalog_MinMg}" FontSize="12" TextColor="Gray" />
                        <Entry Placeholder="0"
                               Keyboard="Numeric"
                               Text="{Binding MinimumMilligramsText}" />
                    </VerticalStackLayout>

                    <!-- Maximo mg -->
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="{loc:Translate FoodCatalog_MaxMg}" FontSize="12" TextColor="Gray" />
                        <Entry Placeholder="Max"
                               Keyboard="Numeric"
                               Text="{Binding MaximumMilligramsText}" />
                    </VerticalStackLayout>
                </Grid>

                <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                    <Button Text="{loc:Translate FoodCatalog_ResetFilters}"
                            Command="{Binding ClearFilterCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#495057, Dark=#DEE2E6}" />

                    <Button Text="{loc:Translate FoodCatalog_ApplyFilters}"
                            Command="{Binding ApplyFilterCommand}"
                            FontAttributes="Bold" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Indicador de Carga -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Lista de Alimentos con perfil de minerales -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Foods}"
                        Margin="12,0,12,12">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Padding="30">
                    <Label Text="{loc:Translate FoodCatalog_Empty}"
                           HorizontalTextAlignment="Center"
                           TextColor="Gray"
                           FontSize="15" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:FoodItemDto">
                    <Border Margin="0, 0, 0, 10"
                            Padding="14"
                            StrokeShape="RoundRectangle 10"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Name}"
                                   FontAttributes="Bold"
                                   FontSize="17" />

                            <Label Text="{Binding SubtitleSummary}"
                                   FontSize="13"
                                   TextColor="Gray" />

                            <!-- Listado horizontal de minerales presentes -->
                            <FlexLayout BindableLayout.ItemsSource="{Binding Minerals}"
                                        Wrap="Wrap"
                                        Margin="0, 6, 0, 0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="dto:MineralAmountDto">
                                        <Border Margin="0, 2, 8, 4"
                                                Padding="8, 3"
                                                StrokeShape="RoundRectangle 6"
                                                Background="{AppThemeBinding Light=#E9ECEF, Dark=#343A40}">
                                            <Label Text="{Binding DisplayText}"
                                                   FontSize="12"
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
