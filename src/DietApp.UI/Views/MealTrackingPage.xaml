<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:dto="clr-namespace:DietApp.Application.DTOs;assembly=DietApp.Application"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.MealTrackingPage"
             x:Name="ThisTrackingPage"
             x:DataType="vm:MealTrackingViewModel"
             Title="{loc:Translate DailyTracking_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWarm}, Dark={StaticResource Black}}">

    <!--
    Como funciona: Vista de conteo diario y trazabilidad metabolica-renal basada en el diseno
    Stitch 'Clinical Nutrition Ergonomics'. Consolida la ingesta acumulada de minerales criticos,
    alerta de limites fisiologicos superados mediante tonalidades coral y ambar, y desglosa cada
    comida con objetivos tactiles de 48dp.
    Por que se tomo esta decision: Permite una lectura clinica de alta precision sin sobrecarga visual,
    garantizando que la informacion numerica este claramente diferenciada de sus unidades.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- Indicador de Carga Reactivo -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryDark}"
                               HorizontalOptions="Center" />

            <!-- 1. Encabezado de Estado Clinico -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16, 12"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="DIETAPP • METABOLIC TRACKER"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryDark}" />
                        <Label Text="{loc:Translate DailyTracking_Title}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            StrokeShape="RoundRectangle 9999"
                            Padding="10, 4"
                            StrokeThickness="0"
                            Background="{AppThemeBinding Light={StaticResource MineralProteinBg}, Dark=#1e2d14}">
                        <Label Text="Control Renal y Metabólico"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnPrimaryContainer}"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- 2. Barra Ergonomica de Navegacion por Fechas (Touch targets 48dp) -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="8"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <Grid ColumnDefinitions="48, *, 48" VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Text="◀"
                            Command="{Binding GoToPreviousDayCommand}"
                            HeightRequest="48"
                            MinimumHeightRequest="48"
                            WidthRequest="48"
                            MinimumWidthRequest="48"
                            Padding="0"
                            CornerRadius="12"
                            Style="{StaticResource StitchNeutralButtonStyle}"
                            SemanticProperties.Description="{loc:Translate DailyTracking_PreviousDay}" />

                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                        <Label Text="{Binding SelectedDate, StringFormat='{0:dddd, d MMMM}'}"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                        <Label Text="{Binding SelectedDate, StringFormat='{0:yyyy}'}"
                               HorizontalTextAlignment="Center"
                               FontSize="12"
                               TextColor="{StaticResource Outline}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="2"
                            Text="▶"
                            Command="{Binding GoToNextDayCommand}"
                            HeightRequest="48"
                            MinimumHeightRequest="48"
                            WidthRequest="48"
                            MinimumWidthRequest="48"
                            Padding="0"
                            CornerRadius="12"
                            Style="{StaticResource StitchNeutralButtonStyle}"
                            SemanticProperties.Description="{loc:Translate DailyTracking_NextDay}" />
                </Grid>
            </Border>

            <!-- 3. Banner de Alertas y Avisos Preventivos Clinicos (Level Alert Tonal) -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    IsVisible="{Binding HasExceededAlerts}"
                    Stroke="{StaticResource SecondaryContainer}"
                    StrokeThickness="1.5"
                    Background="{AppThemeBinding Light=#FFF7F5, Dark=#331c15}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 9999"
                                Padding="8, 3"
                                Background="{StaticResource SecondaryContainer}">
                            <Label Text="ALERTA CLÍNICA"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="{loc:Translate DailyTracking_AlertsTitle}"
                               FontAttributes="Bold"
                               FontSize="15"
                               TextColor="{StaticResource Secondary}"
                               VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{loc:Translate DailyTracking_AlertsSubtitle}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource Gray300}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ExceededAlerts}"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:MineralAlertExceededDto">
                                <Border StrokeShape="RoundRectangle 12"
                                        Padding="12, 10"
                                        Stroke="{Binding CardBorderHex}"
                                        StrokeThickness="1"
                                        Background="{Binding CardBackgroundHex}">
                                    <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 9999"
                                                Padding="8, 3"
                                                Background="{Binding CardBorderHex}"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding SeverityBadgeText}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <Label Grid.Column="1"
                                               Text="{Binding IconText}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               TextColor="{Binding CardTextHex}"
                                               VerticalOptions="Center" />

                                        <Label Grid.Column="2"
                                               Text="{Binding WarningMessage}"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="{Binding CardTextHex}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Tarjeta Bento: Resumen Total de Ingesta y Balance Metabolico -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Balance Metabólico"
                                   FontSize="12"
                                   TextColor="{StaticResource Outline}" />
                            <Label Text="{loc:Translate DailyTracking_DailyTotal}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                        </VerticalStackLayout>

                        <!-- Badge Destacado de Meta Proteica (Stitch Lime Primary) -->
                        <Border Grid.Column="1"
                                Padding="12, 6"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource MineralProteinBg}, Dark=#1e2d14}"
                                VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{loc:Translate DailyTracking_ProteinTotal}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource OnPrimaryContainer}"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding DailyProteinDisplay}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource OnPrimaryContainer}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="Trazabilidad cuantitativa de 7 minerales críticos (mg):"
                           FontSize="12"
                           TextColor="{StaticResource Outline}" />

                    <!-- Coleccion fluida de pastillas de minerales (Pill Matrix) -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding DailyMinerals}"
                                Wrap="Wrap"
                                Margin="0, 4, 0, 0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:MineralAmountDto">
                                <Border Margin="0, 3, 8, 5"
                                        Padding="12, 6"
                                        StrokeShape="RoundRectangle 9999"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                        StrokeThickness="1"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}">
                                    <Label Text="{Binding DisplayText}"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 5. Seccion de Listado de Comidas del Dia -->
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" Margin="0, 4, 0, 0">
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label Text="{loc:Translate DailyTracking_MealsDetail}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                    <Label Text="Desglose por momentos de ingesta"
                           FontSize="12"
                           TextColor="{StaticResource Outline}" />
                </VerticalStackLayout>

                <Button Grid.Column="1"
                        Text="{loc:Translate DailyTracking_AddMeal}"
                        Command="{Binding NavigateToAddMealCommand}"
                        Style="{StaticResource StitchPrimaryButtonStyle}"
                        HeightRequest="48"
                        MinimumHeightRequest="48"
                        Padding="16, 0"
                        VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding DayMeals}"
                                 Spacing="12">
                <BindableLayout.EmptyView>
                    <Border StrokeShape="RoundRectangle 16"
                            Padding="24"
                            Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                            StrokeThickness="1"
                            Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}"
                            Margin="0, 8">
                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="{loc:Translate DailyTracking_EmptyMeals}"
                                   TextColor="{StaticResource Outline}"
                                   HorizontalTextAlignment="Center"
                                   FontSize="14" />
                            <Button Text="{loc:Translate DailyTracking_AddMeal}"
                                    Command="{Binding NavigateToAddMealCommand}"
                                    Style="{StaticResource StitchPrimaryButtonStyle}"
                                    HeightRequest="48"
                                    MinimumHeightRequest="48"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </BindableLayout.EmptyView>

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="dto:MealDto">
                        <Border StrokeShape="RoundRectangle 16"
                                Padding="16"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding TitleDisplay}"
                                               FontAttributes="Bold"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                        <Label Text="{Binding NutritionSummary}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                    </VerticalStackLayout>

                                    <!-- Boton Ergonomico de Eliminacion (48dp min touch target) -->
                                    <Button Grid.Column="1"
                                            Text="{loc:Translate DailyTracking_Delete}"
                                            Command="{Binding Source={x:Reference ThisTrackingPage}, Path=BindingContext.DeleteMealCommand}"
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="{StaticResource Secondary}"
                                            TextColor="White"
                                            FontSize="12"
                                            FontAttributes="Bold"
                                            HeightRequest="48"
                                            MinimumHeightRequest="48"
                                            Padding="14, 0"
                                            CornerRadius="12"
                                            VerticalOptions="Center" />
                                </Grid>

                                <!-- Alimentos de la comida -->
                                <Label Text="{loc:Translate DailyTracking_FoodsIngested}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Outline}" />

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}"
                                                     Spacing="4"
                                                     Margin="8, 0, 0, 0">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="dto:MealItemDto">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="•" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                                <Label Text="{Binding FoodName}" FontAttributes="Bold" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                                <Label Text="{Binding PortionSummary, StringFormat='({0})'}" FontSize="13" TextColor="{StaticResource Outline}" />
                                            </HorizontalStackLayout>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <!-- Minerales totales de esta comida -->
                                <Label Text="{loc:Translate DailyTracking_MineralsProvided}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Outline}"
                                       Margin="0, 4, 0, 0" />

                                <FlexLayout BindableLayout.ItemsSource="{Binding TotalMinerals}"
                                            Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="dto:MineralAmountDto">
                                            <Border Margin="0, 2, 6, 4"
                                                    Padding="8, 4"
                                                    StrokeShape="RoundRectangle 9999"
                                                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                                    StrokeThickness="1"
                                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark={StaticResource SurfaceContainerLowDark}}">
                                                <Label Text="{Binding DisplayText}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
