<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:models="clr-namespace:DietApp.UI.Models"
             xmlns:helpers="clr-namespace:DietApp.UI.Helpers"
             x:Class="DietApp.UI.Views.MealTrackingPage"
             x:DataType="vm:MealTrackingViewModel"
             Title="Conteo Diario"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource StitchBackground}, Dark={StaticResource StitchDarkBackground}}">

    <!--
    Como funciona: Pantalla de Conteo Diario fiel al prototipo de Stitch 'Clinical Nutrition Ergonomics'.
    Incluye encabezado con Material Symbols, barra ergonomica de fecha, avisos preventivos y de limite superado,
    tarjeta de balance metabolico con los 7 minerales cuantificables y desglose de tomas registradas.
    Por que se tomo esta decision: Elimina caracteres ASCII y aproximaciones genericas, renderizando
    exactamente la estetica, colores, redondeos y proporciones disenadas en Stitch.
    -->

    <Grid RowDefinitions="Auto, *">
        <!-- 1. TopAppBar Sticky Component -->
        <Border Grid.Row="0"
                StrokeShape="Rectangle"
                StrokeThickness="0,0,0,1"
                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}"
                Background="{AppThemeBinding Light={StaticResource StitchSurface}, Dark={StaticResource StitchDarkSurface}}"
                Padding="16, 8"
                HeightRequest="64">
            <Grid ColumnDefinitions="48, *, 48" VerticalOptions="Center">
                <!-- Boton Calendario (48dp target) -->
                <Button Grid.Column="0"
                        Text="{x:Static helpers:MaterialIconFont.CalendarToday}"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource StitchCircularIconButtonStyle}"
                        SemanticProperties.Description="Calendario de registros" />

                <!-- Titulo Central Clinico -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                    <Label Text="Conteo Diario"
                           FontFamily="PlusJakartaSans"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                    
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" VerticalOptions="Center">
                        <BoxView WidthRequest="6"
                                 HeightRequest="6"
                                 CornerRadius="3"
                                 Color="{StaticResource StitchPrimaryContainer}"
                                 VerticalOptions="Center" />
                        <Label Text="Control Renal y Metabólico"
                               FontFamily="Inter"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Boton Notificaciones / Alertas (48dp target con badge) -->
                <Grid Grid.Column="2" WidthRequest="48" HeightRequest="48">
                    <Button Text="{x:Static helpers:MaterialIconFont.Notifications}"
                            Style="{StaticResource StitchCircularIconButtonStyle}"
                            SemanticProperties.Description="Notificaciones" />
                    <BoxView WidthRequest="8"
                             HeightRequest="8"
                             CornerRadius="4"
                             Color="{StaticResource StitchClinicalCoral}"
                             HorizontalOptions="End"
                             VerticalOptions="Start"
                             Margin="0, 8, 8, 0"
                             IsVisible="{Binding HasAlertBanners}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 2. Contenido Desplazable Principal -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16, 12, 16, 32" Spacing="16" MaximumWidthRequest="480" HorizontalOptions="Center">

                <!-- Indicador de Carga -->
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource StitchPrimary}"
                                   HorizontalOptions="Center" />

                <!-- 2.1 Barra de Navegacion por Fechas Ergonimica -->
                <Border Style="{StaticResource StitchCardBorderStyle}"
                        Padding="8, 6">
                    <Grid ColumnDefinitions="44, *, 44" VerticalOptions="Center">
                        <!-- Dia Anterior -->
                        <Button Grid.Column="0"
                                Text="{x:Static helpers:MaterialIconFont.ChevronLeft}"
                                Command="{Binding GoToPreviousDayCommand}"
                                FontFamily="MaterialSymbols"
                                FontSize="22"
                                WidthRequest="44"
                                HeightRequest="44"
                                MinimumWidthRequest="44"
                                MinimumHeightRequest="44"
                                CornerRadius="12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                Padding="0"
                                SemanticProperties.Description="Día anterior" />

                        <!-- Fecha Seleccionada -->
                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                            <Label Text="{x:Static helpers:MaterialIconFont.Event}"
                                   Style="{StaticResource MaterialIconStyle}"
                                   FontSize="20"
                                   TextColor="{StaticResource StitchPrimary}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding FormattedDate}"
                                       FontFamily="PlusJakartaSans"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                <Label Text="{Binding FormattedWeekDay}"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource StitchPrimary}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Dia Siguiente -->
                        <Button Grid.Column="2"
                                Text="{x:Static helpers:MaterialIconFont.ChevronRight}"
                                Command="{Binding GoToNextDayCommand}"
                                FontFamily="MaterialSymbols"
                                FontSize="22"
                                WidthRequest="44"
                                HeightRequest="44"
                                MinimumWidthRequest="44"
                                MinimumHeightRequest="44"
                                CornerRadius="12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                Padding="0"
                                SemanticProperties.Description="Día siguiente" />
                    </Grid>
                </Border>

                <!-- 2.2 Banners de Alertas Clinicas y Avisos Preventivos -->
                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding AlertBanners}"
                                     IsVisible="{Binding HasAlertBanners}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ClinicalAlertBannerModel">
                            <Border StrokeShape="RoundRectangle 16"
                                    Stroke="{Binding AccentColor}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                    Padding="0">
                                <Grid ColumnDefinitions="5, *">
                                    <!-- Banda de acento lateral Stitch -->
                                    <BoxView Grid.Column="0"
                                             Color="{Binding AccentColor}" />

                                    <!-- Contenido del aviso clinico -->
                                    <Grid Grid.Column="1" ColumnDefinitions="Auto, *" Padding="14, 12" ColumnSpacing="12">
                                        <!-- Icono de alerta -->
                                        <Border Grid.Column="0"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                StrokeShape="RoundRectangle 18"
                                                StrokeThickness="0"
                                                Background="{Binding BadgeBackground}"
                                                VerticalOptions="Start">
                                            <Label Text="{Binding IconGlyph}"
                                                   Style="{StaticResource MaterialIconStyle}"
                                                   FontSize="20"
                                                   TextColor="{Binding AccentColor}" />
                                        </Border>

                                        <!-- Textos e informacion de exceso -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <Border Grid.Column="0"
                                                        StrokeShape="RoundRectangle 9999"
                                                        StrokeThickness="0"
                                                        Background="{Binding BadgeBackground}"
                                                        Padding="8, 2">
                                                    <Label Text="{Binding BadgeText}"
                                                           FontFamily="Inter"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding BadgeTextColor}" />
                                                </Border>
                                                <Label Grid.Column="1"
                                                       Text="{Binding DifferenceText}"
                                                       FontFamily="Inter"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding AccentColor}"
                                                       HorizontalOptions="End"
                                                       VerticalOptions="Center" />
                                            </Grid>

                                            <Label Text="{Binding SummaryText}"
                                                   FontFamily="PlusJakartaSans"
                                                   FontSize="13"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />

                                            <Label Text="{Binding AdviceText}"
                                                   FontFamily="PlusJakartaSans"
                                                   FontSize="12"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- 2.3 Tarjeta de Resumen Total del Dia (Balance Metabolico) -->
                <Border Style="{StaticResource StitchCardBorderStyle}" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <!-- Encabezado de Ingesta Acumulada -->
                        <Grid ColumnDefinitions="*, Auto" Padding="0, 0, 0, 10">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Balance Metabólico"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                <Label Text="Ingesta Acumulada"
                                       FontFamily="PlusJakartaSans"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                <!-- Total Calorico -->
                                <VerticalStackLayout HorizontalOptions="End" Spacing="0">
                                    <Label Text="Energía"
                                           FontFamily="Inter"
                                           FontSize="11"
                                           HorizontalTextAlignment="End"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                    <HorizontalStackLayout Spacing="3">
                                        <Label Text="{Binding TotalCalories, StringFormat='{0:N0}'}"
                                               FontFamily="PlusJakartaSans"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                        <Label Text="{Binding DailyCalorieGoal, StringFormat='/ {0:N0}'}"
                                               FontFamily="Inter"
                                               FontSize="13"
                                               VerticalOptions="End"
                                               Margin="0,0,0,2"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}"
                                               IsVisible="{Binding IsCalorieGoalEnabled}" />
                                        <Label Text="kcal"
                                               FontFamily="Inter"
                                               FontSize="12"
                                               VerticalOptions="End"
                                               Margin="0,0,0,2"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Badge Verde Lima Meta Proteica -->
                                <Border StrokeShape="RoundRectangle 12"
                                        Stroke="{StaticResource StitchPrimaryContainer}"
                                        StrokeThickness="1"
                                        Background="#1584CC16"
                                        Padding="10, 6">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="Meta Proteica"
                                               FontFamily="Inter"
                                               FontSize="10"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{StaticResource StitchOnPrimaryContainer}" />
                                        <Label Text="{Binding FormattedProteinStatus}"
                                               FontFamily="Inter"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{StaticResource StitchOnPrimaryContainer}" />
                                    </VerticalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}" />

                        <!-- Barra de Cumplimiento del Plan Diario -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                       Text="Cumplimiento del Plan Diario"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                <Label Grid.Column="1"
                                       Text="{Binding FormattedPlanProgress}"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource StitchPrimary}" />
                            </Grid>
                            
                            <!-- Barra de progreso con capsulas redondeadas -->
                            <Border StrokeShape="RoundRectangle 5"
                                    StrokeThickness="0"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainer}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                                    HeightRequest="8">
                                <ProgressBar Progress="{Binding PlanProgressFraction}"
                                             ProgressColor="{StaticResource StitchPrimaryContainer}"
                                             HeightRequest="8" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Cuadricula: Trazabilidad de los 7 Minerales Criticos -->
                        <VerticalStackLayout Spacing="10" Margin="0, 6, 0, 0">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                       Text="Trazabilidad de 7 Minerales Críticos"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                <Label Grid.Column="1"
                                       Text="Unidad: mg"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                            </Grid>

                            <!-- Listado de Minerales en Columna Unica con Ancho Completo -->
                            <VerticalStackLayout Spacing="8"
                                                 BindableLayout.ItemsSource="{Binding SevenMinerals}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:MineralDisplayModel">
                                        <Border StrokeShape="RoundRectangle 14"
                                                StrokeThickness="1"
                                                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                                Padding="12, 10"
                                                HorizontalOptions="Fill">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsExceeded}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource StitchClinicalCoral}" />
                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsWarning}" Value="True">
                                                    <Setter Property="Stroke" Value="{StaticResource StitchTertiaryContainer}" />
                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                </DataTrigger>
                                            </Border.Triggers>

                                            <VerticalStackLayout Spacing="8">
                                                <!-- Fila Superior: Badge Simbolo + Nombre/Limite + Consumo/Porcentaje -->
                                                <Grid ColumnDefinitions="36, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                                    <!-- Simbolo Quimico con estilo clinico Stitch -->
                                                    <Border Grid.Column="0"
                                                            WidthRequest="36"
                                                            HeightRequest="36"
                                                            StrokeShape="RoundRectangle 10"
                                                            StrokeThickness="0"
                                                            Background="{Binding SymbolBackground}"
                                                            VerticalOptions="Center">
                                                        <Label Text="{Binding Symbol}"
                                                               FontFamily="Inter"
                                                               FontSize="13"
                                                               FontAttributes="Bold"
                                                               HorizontalTextAlignment="Center"
                                                               VerticalTextAlignment="Center"
                                                               TextColor="{Binding SymbolTextColor}" />
                                                    </Border>

                                                    <!-- Nombre del mineral, Badges clinicos y Limite Maximo -->
                                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                            <Label Text="{Binding Name}"
                                                                   FontFamily="PlusJakartaSans"
                                                                   FontSize="14"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                                            <!-- Badge Excedido -->
                                                            <Border IsVisible="{Binding IsExceeded}"
                                                                    StrokeShape="RoundRectangle 6"
                                                                    Background="#20EF713F"
                                                                    Stroke="{StaticResource StitchClinicalCoral}"
                                                                    StrokeThickness="1"
                                                                    Padding="6, 1"
                                                                    VerticalOptions="Center">
                                                                <Label Text="Excedido"
                                                                       FontFamily="Inter"
                                                                       FontSize="9"
                                                                       FontAttributes="Bold"
                                                                       TextColor="{StaticResource StitchClinicalCoral}" />
                                                            </Border>
                                                            <!-- Badge Alerta Preventiva -->
                                                            <Border IsVisible="{Binding IsWarning}"
                                                                    StrokeShape="RoundRectangle 6"
                                                                    Background="#20FEA518"
                                                                    Stroke="{StaticResource StitchTertiaryContainer}"
                                                                    StrokeThickness="1"
                                                                    Padding="6, 1"
                                                                    VerticalOptions="Center">
                                                                <Label Text="Alerta"
                                                                       FontFamily="Inter"
                                                                       FontSize="9"
                                                                       FontAttributes="Bold"
                                                                       TextColor="{StaticResource StitchTertiaryContainer}" />
                                                            </Border>
                                                        </HorizontalStackLayout>

                                                        <Label Text="{Binding FormattedLimit}"
                                                               FontFamily="Inter"
                                                               FontSize="11"
                                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                                    </VerticalStackLayout>

                                                    <!-- Cantidad Ingerida y Porcentaje -->
                                                    <VerticalStackLayout Grid.Column="2" HorizontalOptions="End" VerticalOptions="Center" Spacing="1">
                                                        <HorizontalStackLayout HorizontalOptions="End" Spacing="2">
                                                            <Label Text="{Binding FormattedAmount}"
                                                                   FontFamily="PlusJakartaSans"
                                                                   FontSize="16"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}">
                                                                <Label.Triggers>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding IsExceeded}" Value="True">
                                                                        <Setter Property="TextColor" Value="{StaticResource StitchClinicalCoral}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger TargetType="Label" Binding="{Binding IsWarning}" Value="True">
                                                                        <Setter Property="TextColor" Value="{StaticResource StitchTertiaryContainer}" />
                                                                    </DataTrigger>
                                                                </Label.Triggers>
                                                            </Label>
                                                            <Label Text="{Binding Unit}"
                                                                   FontFamily="Inter"
                                                                   FontSize="11"
                                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                                   VerticalOptions="End"
                                                                   Margin="0, 0, 0, 1" />
                                                        </HorizontalStackLayout>

                                                        <Label Text="{Binding ProgressPercentText}"
                                                               FontFamily="Inter"
                                                               FontSize="11"
                                                               FontAttributes="Bold"
                                                               HorizontalTextAlignment="End"
                                                               TextColor="{StaticResource StitchPrimary}">
                                                            <Label.Triggers>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsExceeded}" Value="True">
                                                                    <Setter Property="TextColor" Value="{StaticResource StitchClinicalCoral}" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label" Binding="{Binding IsWarning}" Value="True">
                                                                    <Setter Property="TextColor" Value="{StaticResource StitchTertiaryContainer}" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                </Grid>

                                                <!-- Barra de Progreso que abarca todo el ancho del contenedor -->
                                                <Border StrokeShape="RoundRectangle 3"
                                                        StrokeThickness="0"
                                                        Background="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                                        HeightRequest="6"
                                                        HorizontalOptions="Fill">
                                                    <ProgressBar Progress="{Binding ProgressFraction}"
                                                                 ProgressColor="{Binding ProgressColor}"
                                                                 HeightRequest="6"
                                                                 HorizontalOptions="Fill" />
                                                </Border>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 2.4 Listado de Comidas Ingeridas -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto" Padding="2, 4">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Comidas Registradas"
                                   FontFamily="PlusJakartaSans"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                            <Label Text="{Binding RegisteredMealsSummary}"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                        </VerticalStackLayout>

                        <!-- Boton Tactil Ergonomico 44dp: + Registrar Comida -->
                        <Button Grid.Column="1"
                                Text="+ Registrar Comida"
                                Command="{Binding RegisterMealCommand}"
                                Style="{StaticResource StitchPrimaryButtonStyle}"
                                HeightRequest="44"
                                CornerRadius="12"
                                Padding="14, 0"
                                SemanticProperties.Description="Registrar nueva comida" />
                    </Grid>

                    <!-- Coleccion de Comidas -->
                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding RegisteredMeals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MealCardDisplayModel">
                                <Border Style="{StaticResource StitchCardBorderStyle}"
                                        Padding="14">
                                    <VerticalStackLayout Spacing="10">
                                        <!-- Fila superior: Icono, Titulo/Hora y Boton Eliminar -->
                                        <Grid ColumnDefinitions="Auto, *, 40">
                                            <!-- Contenedor icono segun tipo de comida -->
                                            <Border Grid.Column="0"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    StrokeShape="RoundRectangle 12"
                                                    StrokeThickness="0"
                                                    Background="{Binding IconContainerBackground}"
                                                    VerticalOptions="Start">
                                                <Label Text="{Binding IconGlyph}"
                                                       Style="{StaticResource MaterialIconStyle}"
                                                       FontSize="22"
                                                       TextColor="{Binding IconColor}" />
                                            </Border>

                                            <!-- Titulo y Detalle -->
                                            <VerticalStackLayout Grid.Column="1" Margin="10, 0, 6, 0" Spacing="2">
                                                <Label Text="{Binding HeaderText}"
                                                       FontFamily="Inter"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding IconColor}" />
                                                <Label Text="{Binding Description}"
                                                       FontFamily="PlusJakartaSans"
                                                       FontSize="14"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                            </VerticalStackLayout>

                                            <!-- Boton Eliminar (40dp target) -->
                                            <Button Grid.Column="2"
                                                    Text="{x:Static helpers:MaterialIconFont.Delete}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MealTrackingViewModel}}, Path=DeleteMealCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    FontFamily="MaterialSymbols"
                                                    FontSize="20"
                                                    BackgroundColor="{StaticResource Transparent}"
                                                    TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                    Padding="0"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    CornerRadius="20"
                                                    SemanticProperties.Description="Eliminar comida" />
                                        </Grid>

                                        <!-- Fila intermedia: Resumen de calorias, proteinas e impacto mineral -->
                                        <Border StrokeShape="RoundRectangle 10"
                                                StrokeThickness="0"
                                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                                Padding="12, 8">
                                            <Grid ColumnDefinitions="Auto, 1, Auto, 1, *" ColumnSpacing="12">
                                                <VerticalStackLayout Grid.Column="0" Spacing="0">
                                                    <Label Text="Calorías"
                                                           FontFamily="Inter"
                                                           FontSize="10"
                                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                                    <Label Text="{Binding Calories, StringFormat='{0:N0} kcal'}"
                                                           FontFamily="Inter"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                                </VerticalStackLayout>

                                                <BoxView Grid.Column="1" WidthRequest="1" Color="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}" />

                                                <VerticalStackLayout Grid.Column="2" Spacing="0">
                                                    <Label Text="Proteína"
                                                           FontFamily="Inter"
                                                           FontSize="10"
                                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                                    <Label Text="{Binding ProteinGrams, StringFormat='{0:0.#} g'}"
                                                           FontFamily="Inter"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource StitchPrimary}" />
                                                </VerticalStackLayout>

                                                <BoxView Grid.Column="3" WidthRequest="1" Color="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}" />

                                                <VerticalStackLayout Grid.Column="4" Spacing="0">
                                                    <Label Text="Impacto Mineral"
                                                           FontFamily="Inter"
                                                           FontSize="10"
                                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                                    <Label Text="{Binding ImpactText}"
                                                           FontFamily="Inter"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding ImpactTextColor}" />
                                                </VerticalStackLayout>
                                            </Grid>
                                        </Border>

                                        <!-- Fila inferior: Chips de Minerales -->
                                        <HorizontalStackLayout Spacing="6"
                                                               BindableLayout.ItemsSource="{Binding MineralChips}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:MealMineralChipModel">
                                                    <Border StrokeShape="RoundRectangle 9999"
                                                            Stroke="{Binding BorderColor}"
                                                            StrokeThickness="1"
                                                            Background="{Binding BackgroundColor}"
                                                            Padding="8, 3">
                                                        <HorizontalStackLayout Spacing="3">
                                                            <Label Text="{Binding Symbol, StringFormat='{0}:'}"
                                                                   FontFamily="Inter"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   TextColor="{Binding TextColor}" />
                                                            <Label Text="{Binding AmountWithUnit}"
                                                                   FontFamily="Inter"
                                                                   FontSize="11"
                                                                   TextColor="{Binding TextColor}" />
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Placeholder Sugerencia de Proxima Toma Clinica -->
                    <Border StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}"
                            StrokeThickness="1.5"
                            Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                            Padding="16"
                            HorizontalOptions="Fill">
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="{x:Static helpers:MaterialIconFont.DinnerDining}"
                                   Style="{StaticResource MaterialIconStyle}"
                                   FontSize="28"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                   HorizontalOptions="Center" />
                            <Label Text="Próxima toma sugerida: Cena ligera"
                                   FontFamily="PlusJakartaSans"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                            <Label Text="Límite recomendado de potasio para la cena: &lt; 200 mg"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
