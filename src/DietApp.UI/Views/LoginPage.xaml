<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:helpers="clr-namespace:DietApp.UI.Helpers"
             x:Class="DietApp.UI.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Iniciar Sesión"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource StitchBackground}, Dark={StaticResource StitchDarkBackground}}">

    <!--
    Como funciona: Pantalla de inicio de sesion (LoginPage) disenada bajo el sistema 'Clinical Nutrition Ergonomics'.
    Implementa soporte completo para modo claro y modo oscuro OLED, acceso seguro con correo electronico y contrasena,
    registro de nuevos usuarios, visibilidad alternable de contrasena y proteccion de datos clinicos.
    Por que se tomo esta decision: Asegura fidelidad visual total con los prototipos Stitch preservando ergonomia tactil
    de 48dp+ y adaptabilidad fluida a telefonos y tabletas Android y Windows.
    -->

    <Grid>
        <!-- Contenido desplazable principal -->
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="20,16,20,24"
                                 Spacing="16"
                                 MaximumWidthRequest="460"
                                 HorizontalOptions="Center">

                <!-- 1. Encabezado e Isotipo de Marca -->
                <VerticalStackLayout Spacing="8"
                                     HorizontalOptions="Center"
                                     Margin="0,12,0,4">
                    
                    <!-- Isotipo Clinico: Escudo de signos vitales -->
                    <Border WidthRequest="68"
                            HeightRequest="68"
                            StrokeShape="RoundRectangle 20"
                            Stroke="{StaticResource StitchPrimaryContainer}"
                            StrokeThickness="1.5"
                            BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                            HorizontalOptions="Center">
                        <Grid>
                            <BoxView Color="{StaticResource StitchPrimaryContainer}"
                                     Opacity="0.12"
                                     CornerRadius="20" />
                            <Label Text="{x:Static helpers:MaterialIconFont.VitalSigns}"
                                   FontFamily="MaterialSymbols"
                                   FontSize="36"
                                   TextColor="{StaticResource StitchPrimaryContainer}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <!-- Punto indicador activo -->
                            <Border WidthRequest="10"
                                    HeightRequest="10"
                                    StrokeShape="RoundRectangle 5"
                                    BackgroundColor="{StaticResource StitchPrimaryContainer}"
                                    Stroke="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                    StrokeThickness="1.5"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="0,6,6,0" />
                        </Grid>
                    </Border>

                    <!-- Titulo de Marca y Badge Clinical -->
                    <HorizontalStackLayout Spacing="8"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                        <Label Text="DietApp"
                               FontFamily="PlusJakartaSans"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                        
                        <Border StrokeShape="RoundRectangle 999"
                                BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainer}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                                Stroke="{StaticResource StitchPrimaryContainer}"
                                StrokeThickness="1"
                                Padding="8,2"
                                VerticalOptions="Center">
                            <Label Text="CLINICAL"
                                   FontFamily="Inter"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchPrimary}, Dark={StaticResource StitchPrimaryContainer}}" />
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="Control y seguimiento de minerales, proteínas y balance renal"
                           FontFamily="PlusJakartaSans"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}"
                           HorizontalTextAlignment="Center"
                           Margin="0,-2,0,0" />
                </VerticalStackLayout>

                <!-- 2. Tarjeta del Formulario Principal -->
                <Border StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                        Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}"
                        StrokeThickness="1"
                        Padding="18,20">
                    <VerticalStackLayout Spacing="14">

                        <!-- Banner de Error si ocurre fallo -->
                        <Border IsVisible="{Binding HasError}"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource StitchErrorContainer}, Dark='#3E1414'}"
                                Stroke="{StaticResource StitchError}"
                                StrokeThickness="1"
                                Padding="12,10">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{x:Static helpers:MaterialIconFont.Warning}"
                                       FontFamily="MaterialSymbols"
                                       FontSize="20"
                                       TextColor="{StaticResource StitchError}"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding ErrorMessage}"
                                       FontFamily="PlusJakartaSans"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnErrorContainer}, Dark='#FFDAD6'}"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"
                                       MaximumWidthRequest="320" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Campo Nombre de Usuario (Solo visible en modo registro) -->
                        <VerticalStackLayout Spacing="6" IsVisible="{Binding IsSignUpMode}">
                            <Label Text="Nombre y Apellidos"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                            
                            <Border StrokeShape="RoundRectangle 14"
                                    HeightRequest="52"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutline}}"
                                    StrokeThickness="1"
                                    Padding="12,0">
                                <Grid ColumnDefinitions="32,*">
                                    <Label Grid.Column="0"
                                           Text="{x:Static helpers:MaterialIconFont.ManageAccounts}"
                                           FontFamily="MaterialSymbols"
                                           FontSize="20"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutline}}"
                                           VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           Placeholder="Ej. María González"
                                           PlaceholderColor="{AppThemeBinding Light='#80505A69', Dark='#808F9BA8'}"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                           FontFamily="PlusJakartaSans"
                                           FontSize="14"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Campo: Correo Electronico -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Correo electrónico"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />

                            <Border StrokeShape="RoundRectangle 14"
                                    HeightRequest="52"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutline}}"
                                    StrokeThickness="1"
                                    Padding="12,0">
                                <Grid ColumnDefinitions="32,*">
                                    <Label Grid.Column="0"
                                           Text="{x:Static helpers:MaterialIconFont.Mail}"
                                           FontFamily="MaterialSymbols"
                                           FontSize="20"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutline}}"
                                           VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding Email}"
                                           Keyboard="Email"
                                           Placeholder="ejemplo@correo.com"
                                           PlaceholderColor="{AppThemeBinding Light='#80505A69', Dark='#808F9BA8'}"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                           FontFamily="PlusJakartaSans"
                                           FontSize="14"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Campo: Contraseña -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Contraseña"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                <Label Grid.Column="1"
                                       Text="¿Olvidaste tu contraseña?"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchPrimary}, Dark={StaticResource StitchPrimaryContainer}}"
                                       TextDecorations="Underline">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <Border StrokeShape="RoundRectangle 14"
                                    HeightRequest="52"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutline}}"
                                    StrokeThickness="1"
                                    Padding="12,0">
                                <Grid ColumnDefinitions="32,*,40">
                                    <Label Grid.Column="0"
                                           Text="{x:Static helpers:MaterialIconFont.Key}"
                                           FontFamily="MaterialSymbols"
                                           FontSize="20"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutline}}"
                                           VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding Password}"
                                           IsPassword="{Binding IsPasswordHidden}"
                                           Placeholder="••••••••••••"
                                           PlaceholderColor="{AppThemeBinding Light='#80505A69', Dark='#808F9BA8'}"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                           FontFamily="PlusJakartaSans"
                                           FontSize="14"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="2"
                                            Text="{Binding PasswordToggleIcon}"
                                            FontFamily="MaterialSymbols"
                                            FontSize="20"
                                            TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutline}}"
                                            BackgroundColor="Transparent"
                                            Padding="0"
                                            Command="{Binding TogglePasswordVisibilityCommand}" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Toggle: Recordar sesion en este dispositivo -->
                        <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                            <CheckBox IsChecked="{Binding RememberSession}"
                                      Color="{StaticResource StitchPrimaryContainer}"
                                      VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                <Label Text="Recordar sesión en este dispositivo"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                <Label Text="Almacenamiento local seguro y cifrado"
                                       FontFamily="PlusJakartaSans"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                        <!-- Boton de Accion Principal (Lima CTA 50dp) -->
                        <Button Text="{Binding SubmitButtonText}"
                                FontFamily="Inter"
                                FontSize="14"
                                FontAttributes="Bold"
                                HeightRequest="50"
                                CornerRadius="14"
                                BackgroundColor="{StaticResource StitchPrimaryContainer}"
                                TextColor="#0F172A"
                                Command="{Binding SubmitCommand}"
                                IsEnabled="{Binding IsBusy, Converter={helpers:InverseBoolConverter}}"
                                Margin="0,8,0,0" />

                        <!-- Indicador de carga -->
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource StitchPrimaryContainer}"
                                           HorizontalOptions="Center"
                                           HeightRequest="24"
                                           WidthRequest="24" />

                        <!-- Alternar entre Login y Registro -->
                        <Button Text="{Binding SwitchModeText}"
                                FontFamily="Inter"
                                FontSize="12"
                                BackgroundColor="Transparent"
                                TextColor="{AppThemeBinding Light={StaticResource StitchPrimary}, Dark={StaticResource StitchPrimaryContainer}}"
                                Command="{Binding ToggleAuthModeCommand}"
                                Padding="0"
                                Margin="0,-4,0,0" />

                    </VerticalStackLayout>
                </Border>

                <!-- 3. Pie de Pantalla / Privacidad y Cifrado Clinico -->
                <HorizontalStackLayout Spacing="6"
                                       HorizontalOptions="Center"
                                       Margin="0,12,0,0">
                    <Label Text="{x:Static helpers:MaterialIconFont.VerifiedUser}"
                           FontFamily="MaterialSymbols"
                           FontSize="16"
                           TextColor="{StaticResource StitchPrimary}"
                           VerticalOptions="Center" />
                    <Label Text="Datos cifrados bajo estándares de privacidad médica"
                           FontFamily="PlusJakartaSans"
                           FontSize="10"
                           TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutline}}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
