<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:dto="clr-namespace:DietApp.Application.DTOs;assembly=DietApp.Application"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.RecipeDetailPage"
             x:DataType="vm:RecipeDetailViewModel"
             Title="{loc:Translate RecipeDetail_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWarm}, Dark={StaticResource Black}}">

    <!--
    Como funciona: Ficha clinica y detallada de la preparacion culinaria basada en el diseno Stitch 'Clinical Nutrition Ergonomics'.
    Estructura la informacion en un Hero fotografico superior con retorno flotante de 48dp, pildoras de los 3 minerales criticos,
    panel ergonomico de registro en la ingesta diaria, desglose de ingredientes dosificados y secuencia numerada de pasos.
    Por que se tomo esta decision: Permite al usuario y al profesional de nutricion evaluar de inmediato
    la viabilidad clinica de la receta respecto al limite diario del paciente.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- Indicador de Carga -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryDark}"
                               HorizontalOptions="Center" />

            <!-- 1. Hero Fotografico Superior con Contenedores Flotantes -->
            <Grid HeightRequest="260" Margin="0, 0, 0, 2">
                <Border StrokeShape="RoundRectangle 20"
                        Padding="0"
                        StrokeThickness="0"
                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerHigh}, Dark=#2a2a35}">
                    <Image Source="{Binding Recipe.FinalImagePath}"
                           Aspect="AspectFill"
                           HeightRequest="260" />
                </Border>

                <!-- Boton circular flotante '✕' para retorno rapido (48dp touch target) -->
                <Button Text="✕"
                        Command="{Binding CloseCommand}"
                        WidthRequest="48"
                        HeightRequest="48"
                        MinimumWidthRequest="48"
                        MinimumHeightRequest="48"
                        CornerRadius="24"
                        Padding="0"
                        FontSize="18"
                        FontAttributes="Bold"
                        BackgroundColor="#99131b2e"
                        TextColor="White"
                        HorizontalOptions="Start"
                        VerticalOptions="Start"
                        Margin="12" />

                <!-- Barra flotante superpuesta en la base con titulo y badge energetico -->
                <Border StrokeShape="RoundRectangle 16"
                        Background="#EE131B2E"
                        Padding="16, 12"
                        Margin="12, 0, 12, 12"
                        VerticalOptions="End"
                        HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="{Binding Recipe.Title}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 9999"
                                    Padding="10, 4"
                                    Background="{StaticResource Primary}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Label Text="{Binding Recipe.EnergyBadge}"
                                       TextColor="{StaticResource ContrastDark}"
                                       FontAttributes="Bold"
                                       FontSize="11" />
                            </Border>
                        </Grid>

                        <Label Text="{Binding Recipe.Description}"
                               TextColor="#CBD5E1"
                               FontSize="12"
                               MaxLines="1"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 2. Fila de Pildoras de Nutrientes Clave (Matrix Stitch) -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                <!-- Sodio: Tonalidad Azul Cobalto -->
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 14"
                        Padding="10, 8"
                        Stroke="{StaticResource MineralSodiumBorder}"
                        StrokeThickness="1"
                        Background="{StaticResource MineralSodiumBg}">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="SODIO (Na)"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MineralSodiumText}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Recipe.SodiumBadge}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MineralSodiumText}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Potasio: Alerta Coral Naranja -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="10, 8"
                        Stroke="{StaticResource MineralPotassiumBorder}"
                        StrokeThickness="1.5"
                        Background="{StaticResource MineralPotassiumBg}">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="POTASIO (K)"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MineralPotassiumText}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Recipe.PotassiumBadge}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MineralPotassiumText}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Fosforo: Amatista Real -->
                <Border Grid.Column="2"
                        StrokeShape="RoundRectangle 14"
                        Padding="10, 8"
                        Stroke="{StaticResource MineralPhosphorusBorder}"
                        StrokeThickness="1"
                        Background="{StaticResource MineralPhosphorusBg}">
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                        <Label Text="FÓSFORO (P)"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MineralPhosphorusText}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Recipe.PhosphorusBadge}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource MineralPhosphorusText}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- 3. Banner de Advertencias Clinicas de Porcion (si aplica) -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    IsVisible="{Binding HasPortionWarnings}"
                    Stroke="{StaticResource SecondaryContainer}"
                    StrokeThickness="1.5"
                    Background="{AppThemeBinding Light=#FFF7F5, Dark=#331c15}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate RecipeDetail_PortionWarningTitle}"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{StaticResource Secondary}" />

                    <Label Text="{loc:Translate RecipeDetail_PortionWarningSubtitle}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource Gray300}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PortionWarnings}"
                                         Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:RecipePortionWarningDto">
                                <Border StrokeShape="RoundRectangle 12"
                                        Padding="10, 8"
                                        Stroke="{Binding CardBorderHex}"
                                        StrokeThickness="1"
                                        Background="{Binding CardBackgroundHex}">
                                    <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 9999"
                                                Padding="6, 2"
                                                Background="{Binding CardBorderHex}"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding SeverityBadgeText}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <Label Grid.Column="1"
                                               Text="{Binding IconText}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               TextColor="{Binding CardTextHex}"
                                               VerticalOptions="Center" />

                                        <Label Grid.Column="2"
                                               Text="{Binding WarningMessage}"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="{Binding CardTextHex}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Panel de Accion: Registrar en la Ingesta Diaria -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource MineralProteinBg}, Dark=#1e2d14}">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{loc:Translate RecipeDetail_IntakePanelTitle}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{StaticResource OnPrimaryContainer}" />
                        <Label Text="{loc:Translate RecipeDetail_IntakePanelSubtitle}"
                               FontSize="12"
                               TextColor="{StaticResource OnPrimaryContainer}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="10">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                            <Label Text="{loc:Translate RecipeDetail_IntakeDate}"
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   TextColor="{StaticResource Outline}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource BorderWarmLight}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark=#23232c}"
                                    Padding="8, 0">
                                <DatePicker Date="{Binding IntakeDate}"
                                            HeightRequest="48"
                                            FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                            <Label Text="{loc:Translate RecipeDetail_MealMoment}"
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   TextColor="{StaticResource Outline}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{StaticResource BorderWarmLight}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark=#23232c}"
                                    Padding="8, 0">
                                <Picker ItemsSource="{Binding MealTypeOptions}"
                                        SelectedItem="{Binding SelectedMealTypeName}"
                                        HeightRequest="48"
                                        FontSize="13" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                            <Label Text="{loc:Translate RecipeDetail_ServingsConsumed}"
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   TextColor="{StaticResource Outline}" />
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 12"
                                        Stroke="{StaticResource BorderWarmLight}"
                                        StrokeThickness="1"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark=#23232c}"
                                        Padding="8, 0">
                                    <Entry Placeholder="1"
                                           Keyboard="Numeric"
                                           Text="{Binding ServingsConsumedText}"
                                           HeightRequest="48"
                                           FontSize="14" />
                                </Border>

                                <Button Grid.Column="1"
                                        Text="{loc:Translate RecipeDetail_LogAction}"
                                        Command="{Binding AddToDailyIntakeCommand}"
                                        Style="{StaticResource StitchPrimaryButtonStyle}"
                                        HeightRequest="48"
                                        MinimumHeightRequest="48"
                                        Padding="16, 0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Mensaje de confirmacion -->
                    <Label Text="{Binding IntakeMessage}"
                           FontAttributes="Bold"
                           FontSize="12"
                           TextColor="{StaticResource PrimaryDark}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 5. Resumen Completo de 7 Minerales por Porcion -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate RecipeDetail_MineralsPerServingTitle}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                    <Label Text="{loc:Translate RecipeDetail_MineralsPerServingSubtitle}"
                           FontSize="12"
                           TextColor="{StaticResource Outline}" />

                    <FlexLayout BindableLayout.ItemsSource="{Binding Recipe.MineralsPerServing}"
                                Wrap="Wrap"
                                Margin="0, 4, 0, 0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:MineralAmountDto">
                                <Border Margin="0, 3, 8, 5"
                                        Padding="10, 6"
                                        StrokeShape="RoundRectangle 9999"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                        StrokeThickness="1"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}">
                                    <Label Text="{Binding DisplayText}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 6. Seccion de Ingredientes Dosificados -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="{loc:Translate RecipeDetail_IngredientsTitle}"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}"
                               VerticalOptions="Center" />

                        <Border Grid.Column="1"
                                Padding="10, 4"
                                StrokeShape="RoundRectangle 9999"
                                Background="{AppThemeBinding Light={StaticResource MineralProteinBg}, Dark=#1e2d14}"
                                Stroke="{StaticResource Primary}"
                                StrokeThickness="1"
                                VerticalOptions="Center">
                            <Label Text="{Binding Recipe.ProteinPerServingDisplay}"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource OnPrimaryContainer}" />
                        </Border>
                    </Grid>

                    <!-- Selector de ordenamiento de ingredientes -->
                    <Border StrokeShape="RoundRectangle 12"
                            Padding="12, 8"
                            Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{loc:Translate RecipeDetail_SortIngredients}"
                                   FontAttributes="Bold"
                                   FontSize="11"
                                   TextColor="{StaticResource Outline}" />

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="6, 0"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark=#2a2a35}">
                                    <Picker ItemsSource="{Binding IngredientMineralOptions}"
                                            ItemDisplayBinding="{Binding DisplayName}"
                                            SelectedItem="{Binding SelectedIngredientMineralOption}"
                                            HeightRequest="44"
                                            FontSize="12" />
                                </Border>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="6, 0"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark=#2a2a35}">
                                    <Picker ItemsSource="{Binding IngredientDirectionOptions}"
                                            ItemDisplayBinding="{Binding DisplayName}"
                                            SelectedItem="{Binding SelectedIngredientDirectionOption}"
                                            HeightRequest="44"
                                            FontSize="12" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lista de Tarjetas de Ingredientes -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding DisplayedIngredients}"
                                Wrap="Wrap"
                                JustifyContent="SpaceBetween"
                                AlignItems="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:RecipeIngredientDto">
                                <Border FlexLayout.Basis="48%"
                                        Style="{StaticResource StitchCardStyle}"
                                        Padding="10"
                                        Margin="0, 0, 0, 10">
                                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 10"
                                                Padding="0"
                                                StrokeThickness="0"
                                                HeightRequest="75"
                                                WidthRequest="110"
                                                Background="Transparent"
                                                HorizontalOptions="Center">
                                            <Image Source="{Binding ImagePath}"
                                                   Aspect="AspectFit"
                                                   HeightRequest="75"
                                                   WidthRequest="110"
                                                   HorizontalOptions="Center" />
                                        </Border>
                                        <Label Text="{Binding FoodName}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                        <Label Text="{Binding GramsDisplay}"
                                               FontSize="12"
                                               TextColor="{StaticResource Outline}"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 7. Seccion de Pasos Numerados de Elaboracion -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate RecipeDetail_StepsTitle}"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recipe.Steps}"
                                         Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:RecipeStepDto">
                                <Border StrokeShape="RoundRectangle 14"
                                        Padding="14"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                        StrokeThickness="1">
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <Border StrokeShape="RoundRectangle 9999"
                                                    Padding="10, 3"
                                                    Background="{StaticResource Primary}">
                                                <Label Text="{Binding StepTitle}"
                                                       TextColor="{StaticResource ContrastDark}"
                                                       FontAttributes="Bold"
                                                       FontSize="11" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding Instruction}"
                                               FontSize="14"
                                               LineHeight="1.2"
                                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                                        <Border StrokeShape="RoundRectangle 12"
                                                Padding="0"
                                                IsVisible="{Binding HasImage}"
                                                HeightRequest="150">
                                            <Image Source="{Binding ImagePath}"
                                                   Aspect="AspectFill" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
