<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:dto="clr-namespace:DietApp.Application.DTOs;assembly=DietApp.Application"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.RecipeDetailPage"
             x:DataType="vm:RecipeDetailViewModel"
             Title="{loc:Translate RecipeDetail_Title}">

    <!--
    Como funciona: Pantalla de presentacion detallada de la receta culinaria.
    Exhibe la imagen final de la receta terminada, el subtitulo nutricional por porcion,
    panel para registrar directamente la receta en la ingesta diaria del usuario,
    la lista de ingredientes y la secuencia de pasos numerados con imagenes ilustrativas.
    Por que se tomo esta decision: Permite al usuario tanto consultar la guia culinaria
    como registrar inmediatamente las porciones consumidas en su historial de comidas.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="16">
            <!-- Indicador de Carga -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />

            <!-- Imagen Final de la Receta Terminada -->
            <Border StrokeShape="RoundRectangle 14"
                    Padding="0"
                    IsVisible="{Binding Recipe.HasFinalImage}">
                <Image Source="{Binding Recipe.FinalImagePath}"
                       Aspect="AspectFill"
                       HeightRequest="220" />
            </Border>

            <!-- Encabezado y Titulo -->
            <VerticalStackLayout Spacing="6">
                <Label Text="{Binding Recipe.Title}"
                       FontAttributes="Bold"
                       FontSize="22" />

                <!-- Subtitulo de Minerales y Calorias por Porcion -->
                <Border StrokeShape="RoundRectangle 8"
                        Padding="12, 8"
                        Background="{AppThemeBinding Light=#EBF5FB, Dark=#1A252F}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate RecipeDetail_NutritionPerServing}"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="Gray" />
                        <Label Text="{Binding Recipe.NutritionSubtitle}"
                               FontAttributes="Bold"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#1B4F72, Dark=#85C1E9}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Descripcion -->
                <Label Text="{Binding Recipe.Description}"
                       FontSize="14"
                       Margin="0, 4, 0, 0" />
            </VerticalStackLayout>

            <!-- Banner de Advertencia de Limite de Minerales -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="14"
                    IsVisible="{Binding HasPortionWarnings}"
                    Stroke="{StaticResource WarningAmber}"
                    StrokeThickness="1.5"
                    Background="{AppThemeBinding Light=#FEF9E7, Dark=#2E2315}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate RecipeDetail_PortionWarningTitle}"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#B9770E, Dark=#F39C12}" />

                    <Label Text="{loc:Translate RecipeDetail_PortionWarningSubtitle}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#7D6608, Dark=#FAD7A0}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PortionWarnings}"
                                         Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:RecipePortionWarningDto">
                                <Border StrokeShape="RoundRectangle 8"
                                        Padding="10, 8"
                                        Stroke="{Binding CardBorderHex}"
                                        StrokeThickness="1"
                                        Background="{Binding CardBackgroundHex}">
                                    <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 4"
                                                Padding="6, 2"
                                                Background="{Binding CardBorderHex}"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding SeverityBadgeText}"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="White"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <Label Grid.Column="1"
                                               Text="{Binding IconText}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               TextColor="{Binding CardTextHex}"
                                               VerticalOptions="Center" />

                                        <Label Grid.Column="2"
                                               Text="{Binding WarningMessage}"
                                               FontAttributes="Bold"
                                               FontSize="12"
                                               TextColor="{Binding CardTextHex}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Resumen Completo de Minerales por Porcion -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="14"
                    Background="{AppThemeBinding Light=#EBF5FB, Dark=#1A252F}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate RecipeDetail_MineralsPerServingTitle}"
                           FontAttributes="Bold"
                           FontSize="15"
                           TextColor="{AppThemeBinding Light=#1B4F72, Dark=#85C1E9}" />

                    <Label Text="{loc:Translate RecipeDetail_MineralsPerServingSubtitle}"
                           FontSize="12"
                           TextColor="Gray" />

                    <FlexLayout BindableLayout.ItemsSource="{Binding Recipe.MineralsPerServing}"
                                Wrap="Wrap"
                                Margin="0, 4, 0, 0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:MineralAmountDto">
                                <Border Margin="0, 3, 8, 5"
                                        Padding="10, 6"
                                        StrokeShape="RoundRectangle 8"
                                        Background="{AppThemeBinding Light=#D4E6F1, Dark=#2E4053}">
                                    <Label Text="{Binding DisplayText}"
                                           FontSize="13"
                                           FontAttributes="Bold" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Panel de Accion: Registrar en la Ingesta Diaria -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="14"
                    Background="{AppThemeBinding Light=#EAFAF1, Dark=#142B1E}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate RecipeDetail_IntakePanelTitle}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light=#196F3D, Dark=#52BE80}" />

                    <Label Text="{loc:Translate RecipeDetail_IntakePanelSubtitle}"
                           FontSize="12"
                           TextColor="Gray" />

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="10" RowSpacing="8">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                            <Label Text="{loc:Translate RecipeDetail_IntakeDate}" FontAttributes="Bold" FontSize="11" />
                            <DatePicker Date="{Binding IntakeDate}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                            <Label Text="{loc:Translate RecipeDetail_MealMoment}" FontAttributes="Bold" FontSize="11" />
                            <Picker ItemsSource="{Binding MealTypeOptions}"
                                    SelectedItem="{Binding SelectedMealTypeName}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2">
                            <Label Text="{loc:Translate RecipeDetail_ServingsConsumed}" FontAttributes="Bold" FontSize="11" />
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Entry Grid.Column="0"
                                       Placeholder="1"
                                       Keyboard="Numeric"
                                       Text="{Binding ServingsConsumedText}" />

                                <Button Grid.Column="1"
                                        Text="{loc:Translate RecipeDetail_LogAction}"
                                        Command="{Binding AddToDailyIntakeCommand}"
                                        FontAttributes="Bold"
                                        HeightRequest="44"
                                        MinimumHeightRequest="44"
                                        Padding="14, 0"
                                        BackgroundColor="{StaticResource HealthTeal}"
                                        TextColor="White" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Mensaje de confirmacion -->
                    <Label Text="{Binding IntakeMessage}"
                           FontAttributes="Bold"
                           FontSize="12"
                           TextColor="{StaticResource HealthTeal}" />
                </VerticalStackLayout>
            </Border>

            <!-- Seccion de Ingredientes -->
            <Label Text="{loc:Translate RecipeDetail_IngredientsTitle}"
                   FontAttributes="Bold"
                   FontSize="17" />

            <Border StrokeShape="RoundRectangle 12"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="10">
                    <!-- Controles para ordenar ingredientes por mineral -->
                    <Border StrokeShape="RoundRectangle 8"
                            Padding="10, 8"
                            Background="{AppThemeBinding Light=#F8F9F9, Dark=#1C2833}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{loc:Translate RecipeDetail_SortIngredients}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#2C3E50, Dark=#BDC3C7}" />

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="4, 0"
                                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#2C3E50}">
                                    <Picker ItemsSource="{Binding IngredientMineralOptions}"
                                            ItemDisplayBinding="{Binding DisplayName}"
                                            SelectedItem="{Binding SelectedIngredientMineralOption}"
                                            FontSize="12" />
                                </Border>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="4, 0"
                                        Background="{AppThemeBinding Light=#FFFFFF, Dark=#2C3E50}">
                                    <Picker ItemsSource="{Binding IngredientDirectionOptions}"
                                            ItemDisplayBinding="{Binding DisplayName}"
                                            SelectedItem="{Binding SelectedIngredientDirectionOption}"
                                            FontSize="12" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lista de Ingredientes Ordenados -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DisplayedIngredients}"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:RecipeIngredientDto">
                                <VerticalStackLayout Spacing="2">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                                        <Label Grid.Column="0" Text="•" FontAttributes="Bold" FontSize="14" />
                                        <Label Grid.Column="1" Text="{Binding DisplayText}" FontAttributes="Bold" FontSize="14" />
                                    </Grid>
                                    <Label Text="{Binding MineralsSummary}"
                                           FontSize="11"
                                           TextColor="Gray"
                                           Margin="16, 0, 0, 4" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Seccion de Pasos Numerados de Elaboracion -->
            <Label Text="{loc:Translate RecipeDetail_StepsTitle}"
                   FontAttributes="Bold"
                   FontSize="17" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recipe.Steps}"
                                 Spacing="14">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="dto:RecipeStepDto">
                        <Border StrokeShape="RoundRectangle 12"
                                Padding="14"
                                Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                            <VerticalStackLayout Spacing="10">
                                <!-- Numero y Titulo del Paso -->
                                <HorizontalStackLayout Spacing="8">
                                    <Border StrokeShape="RoundRectangle 6"
                                            Padding="8, 3"
                                            Background="{AppThemeBinding Light=#2980B9, Dark=#3498DB}">
                                        <Label Text="{Binding StepTitle}"
                                               TextColor="White"
                                               FontAttributes="Bold"
                                               FontSize="12" />
                                    </Border>
                                </HorizontalStackLayout>

                                <!-- Instruccion del Paso -->
                                <Label Text="{Binding Instruction}"
                                       FontSize="14"
                                       LineHeight="1.2" />

                                <!-- Imagen Ilustrativa del Paso si fue agregada -->
                                <Border StrokeShape="RoundRectangle 8"
                                        Padding="0"
                                        IsVisible="{Binding HasImage}"
                                        HeightRequest="160">
                                    <Image Source="{Binding ImagePath}"
                                           Aspect="AspectFill" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
