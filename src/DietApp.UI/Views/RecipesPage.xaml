<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             x:Class="DietApp.UI.Views.RecipesPage"
             x:DataType="vm:RecipesViewModel"
             Title="Recetas"
             BackgroundColor="{AppThemeBinding Light={StaticResource StitchBackground}, Dark={StaticResource StitchDarkBackground}}">

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center" HorizontalOptions="Center">
        <Label Text="Catálogo de Recetas"
               FontFamily="PlusJakartaSans"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center" />
        <Label Text="Pantalla en fase de reconstrucción limpia contra Stitch."
               FontFamily="Inter"
               FontSize="13"
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource StitchOutline}" />
    </VerticalStackLayout>

</ContentPage>
