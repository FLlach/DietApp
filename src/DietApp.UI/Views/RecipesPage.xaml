<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:dto="clr-namespace:DietApp.Application.DTOs;assembly=DietApp.Application"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.RecipesPage"
             x:Name="ThisRecipesPage"
             x:DataType="vm:RecipesViewModel"
             Title="{loc:Translate Recipes_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWarm}, Dark={StaticResource Black}}">

    <!--
    Como funciona: Catalogo culinario clinico basado en el diseno Stitch 'Clinical Nutrition Ergonomics'.
    Integra busqueda rapida, selectores tactiles de ordenamiento por mineral o proteina,
    un banner de acceso al modulo de alinos y condimentos, y tarjetas de preparacion con
    aportes de nutrientes dosificados por racion.
    Por que se tomo esta decision: Facilita la exploracion y dosificacion precisa de platos
    con objetivos tactiles optimizados de 48dp en entorno movil Android.
    -->

    <Grid RowDefinitions="Auto, *">
        <!-- 1. Barra Superior Clinica y Controles de Filtro -->
        <Border Grid.Row="0"
                Margin="16, 12, 16, 8"
                Padding="16"
                StrokeShape="RoundRectangle 16"
                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                StrokeThickness="1"
                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="DIETAPP • METABOLIC MAUI"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryDark}" />
                        <Label Text="{loc:Translate Recipes_Title}"
                               FontAttributes="Bold"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                        <Label Text="Preparaciones dosificadas y control clínico"
                               FontSize="12"
                               TextColor="{StaticResource Outline}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="{loc:Translate Recipes_NewRecipe}"
                            Command="{Binding NavigateToAddRecipeCommand}"
                            Style="{StaticResource StitchPrimaryButtonStyle}"
                            HeightRequest="48"
                            MinimumHeightRequest="48"
                            Padding="16, 0"
                            VerticalOptions="Center" />
                </Grid>

                <!-- Barra de Busqueda Clinica -->
                <Border StrokeShape="RoundRectangle 14"
                        Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                        Padding="4, 0">
                    <SearchBar Placeholder="{loc:Translate Recipes_SearchPlaceholder}"
                               Text="{Binding SearchText}"
                               SearchCommand="{Binding SearchRecipesCommand}"
                               BackgroundColor="Transparent"
                               CancelButtonColor="{StaticResource PrimaryDark}"
                               HeightRequest="48" />
                </Border>

                <!-- Controles Tactiles de Ordenamiento Nutricional -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <!-- Selector de Mineral / Compuesto -->
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{loc:Translate Sort_ByMineral}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Outline}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 0">
                            <Picker ItemsSource="{Binding MineralOptions}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedMineralOption}"
                                    HeightRequest="48"
                                    MinimumHeightRequest="48"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Selector de Direccion -->
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="{loc:Translate Sort_Direction}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Outline}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 0">
                            <Picker ItemsSource="{Binding DirectionOptions}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedDirectionOption}"
                                    HeightRequest="48"
                                    MinimumHeightRequest="48"
                                    FontSize="13"
                                    TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- 2. Banner Integrado: Modulo de Alinos y Marinadas (Stitch Design) -->
                <Border StrokeShape="RoundRectangle 14"
                        Padding="14, 12"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource MineralProteinBg}, Dark=#1e2d14}">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Border StrokeShape="RoundRectangle 9999"
                                        Padding="6, 2"
                                        Background="{StaticResource Primary}">
                                    <Label Text="METABÓLICO"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource ContrastDark}" />
                                </Border>
                                <Label Text="{loc:Translate Recipes_SeasoningsSectionTitle}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       TextColor="{StaticResource OnPrimaryContainer}" />
                            </HorizontalStackLayout>
                            <Label Text="{loc:Translate Recipes_SeasoningsSectionSubtitle}"
                                   FontSize="12"
                                   TextColor="{StaticResource OnPrimaryContainer}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="{loc:Translate Recipes_SeasoningsSectionAction}"
                                Command="{Binding NavigateToSeasoningsCommand}"
                                Style="{StaticResource StitchNeutralButtonStyle}"
                                HeightRequest="48"
                                MinimumHeightRequest="48"
                                Padding="14, 0"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- Indicador de Carga -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource PrimaryDark}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- 3. Coleccion Vertical de Recetas (Stitch Cards) -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Recipes}"
                        Margin="16, 4, 16, 16">
            <CollectionView.EmptyView>
                <Border StrokeShape="RoundRectangle 16"
                        Padding="28"
                        Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                        <Label Text="{loc:Translate Recipes_Empty}"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource Outline}"
                               FontSize="14" />
                        <Button Text="{loc:Translate Recipes_EmptyAction}"
                                Command="{Binding NavigateToAddRecipeCommand}"
                                Style="{StaticResource StitchPrimaryButtonStyle}"
                                HeightRequest="48"
                                MinimumHeightRequest="48"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:RecipeDto">
                    <Border Margin="0, 0, 0, 14"
                            Padding="0"
                            StrokeShape="RoundRectangle 16"
                            Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                            StrokeThickness="1"
                            Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                        <VerticalStackLayout Spacing="0">
                            <!-- Fotografia de Plato Clinico si existe -->
                            <Image Source="{Binding FinalImagePath}"
                                   Aspect="AspectFill"
                                   HeightRequest="160"
                                   IsVisible="{Binding HasFinalImage}" />

                            <VerticalStackLayout Padding="16" Spacing="8">
                                <!-- Titulo de la Receta y Badge de Proteina -->
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="17"
                                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}"
                                           VerticalOptions="Center" />

                                    <Border Grid.Column="1"
                                            Padding="10, 4"
                                            StrokeShape="RoundRectangle 9999"
                                            Background="{AppThemeBinding Light={StaticResource MineralProteinBg}, Dark=#1e2d14}"
                                            Stroke="{StaticResource Primary}"
                                            StrokeThickness="1"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding ProteinPerServingDisplay}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource OnPrimaryContainer}" />
                                    </Border>
                                </Grid>

                                <!-- Subtitulo Nutricional y Calorias por Porcion -->
                                <Border StrokeShape="RoundRectangle 10"
                                        Padding="10, 6"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}">
                                    <Label Text="{Binding NutritionSubtitle}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                </Border>

                                <!-- Badges de Minerales por Porcion (Pill Matrix) -->
                                <FlexLayout BindableLayout.ItemsSource="{Binding MineralsPerServing}"
                                            Wrap="Wrap"
                                            Margin="0, 2, 0, 2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="dto:MineralAmountDto">
                                            <Border Margin="0, 2, 6, 4"
                                                    Padding="8, 4"
                                                    StrokeShape="RoundRectangle 9999"
                                                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                                    StrokeThickness="1"
                                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark=#2c2c36}">
                                                <Label Text="{Binding DisplayText}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <!-- Descripcion Breve -->
                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       TextColor="{StaticResource Outline}"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />

                                <!-- Boton de Accion: Ver Ficha de Receta -->
                                <Button Text="{loc:Translate Recipes_ViewSteps}"
                                        Command="{Binding Source={x:Reference ThisRecipesPage}, Path=BindingContext.SelectRecipeCommand}"
                                        CommandParameter="{Binding .}"
                                        Margin="0, 6, 0, 0"
                                        Style="{StaticResource StitchNeutralButtonStyle}"
                                        HeightRequest="48"
                                        MinimumHeightRequest="48" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
