<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:dto="clr-namespace:DietApp.Application.DTOs;assembly=DietApp.Application"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.RecipesPage"
             x:Name="ThisRecipesPage"
             x:DataType="vm:RecipesViewModel"
             Title="{loc:Translate Recipes_Title}">

    <!--
    Como funciona: Pantalla principal del modulo de recetas. Muestra el catalogo de preparaciones culinarias
    con buscador por texto, imagen final y el subtitulo automatico de minerales y calorias por porcion.
    Por que se tomo esta decision: Permite al usuario explorar opciones de comidas planificadas
    conociendo de inmediato el balance nutricional de cada racion antes de ingresar a los pasos de elaboracion.
    -->

    <Grid RowDefinitions="Auto, *">
        <!-- Barra Superior con Busqueda y Accion Nueva Receta -->
        <Border Grid.Row="0"
                Margin="12, 12, 12, 6"
                Padding="12"
                StrokeShape="RoundRectangle 12"
                Background="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E24}">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="{loc:Translate Recipes_Title}"
                           FontAttributes="Bold"
                           FontSize="18"
                           VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            Text="{loc:Translate Recipes_NewRecipe}"
                            Command="{Binding NavigateToAddRecipeCommand}"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="44"
                            MinimumHeightRequest="44"
                            Padding="12, 0" />
                </Grid>

                <SearchBar Placeholder="{loc:Translate Recipes_SearchPlaceholder}"
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding SearchRecipesCommand}" />

                <!-- Controles de Ordenamiento por Mineral -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0, 4, 0, 0">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="{loc:Translate Sort_ByMineral}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="Gray" />
                        <Border StrokeShape="RoundRectangle 8"
                                Padding="4, 0"
                                Background="{AppThemeBinding Light=#F4F6F7, Dark=#2C3E50}">
                            <Picker ItemsSource="{Binding MineralOptions}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedMineralOption}"
                                    FontSize="12" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                        <Label Text="{loc:Translate Sort_Direction}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="Gray" />
                        <Border StrokeShape="RoundRectangle 8"
                                Padding="4, 0"
                                Background="{AppThemeBinding Light=#F4F6F7, Dark=#2C3E50}">
                            <Picker ItemsSource="{Binding DirectionOptions}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedDirectionOption}"
                                    FontSize="12" />
                        </Border>
                    </VerticalStackLayout>
                </Grid>

                <!-- Apartado de Alinos como opcion dentro de recetas -->
                <Border StrokeShape="RoundRectangle 10"
                        Padding="12, 10"
                        Margin="0, 4, 0, 0"
                        Stroke="{StaticResource HealthTeal}"
                        StrokeThickness="1"
                        Background="{AppThemeBinding Light=#F0FDFA, Dark=#132E2B}">
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="{loc:Translate Recipes_SeasoningsSectionTitle}"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="{StaticResource HealthTeal}" />
                            <Label Text="{loc:Translate Recipes_SeasoningsSectionSubtitle}"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#94A3B8}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="{loc:Translate Recipes_SeasoningsSectionAction}"
                                Command="{Binding NavigateToSeasoningsCommand}"
                                FontSize="12"
                                FontAttributes="Bold"
                                HeightRequest="44"
                                MinimumHeightRequest="44"
                                Padding="14, 0"
                                BackgroundColor="{StaticResource HealthTeal}"
                                TextColor="White"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </Border>

        <!-- Indicador de Carga -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />

        <!-- Listado de Recetas -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Recipes}"
                        Margin="12, 6, 12, 12">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12"
                                     Padding="30">
                    <Label Text="{loc:Translate Recipes_Empty}"
                           HorizontalTextAlignment="Center"
                           TextColor="Gray"
                           FontSize="15" />
                    <Button Text="{loc:Translate Recipes_EmptyAction}"
                            Command="{Binding NavigateToAddRecipeCommand}"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:RecipeDto">
                    <Border Margin="0, 0, 0, 12"
                            Padding="0"
                            StrokeShape="RoundRectangle 12"
                            Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                        <VerticalStackLayout Spacing="0">
                            <!-- Imagen final de la receta si existe -->
                            <Image Source="{Binding FinalImagePath}"
                                   Aspect="AspectFill"
                                   HeightRequest="150"
                                   IsVisible="{Binding HasFinalImage}" />

                            <VerticalStackLayout Padding="14" Spacing="6">
                                <!-- Titulo de la Receta y Badge de Proteina -->
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Title}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           VerticalOptions="Center" />

                                    <Border Grid.Column="1"
                                            Padding="8, 3"
                                            StrokeShape="RoundRectangle 6"
                                            Background="{AppThemeBinding Light=#E8F5E9, Dark=#1B382B}"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding ProteinPerServingDisplay}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#2E7D32, Dark=#81C784}" />
                                    </Border>
                                </Grid>

                                <!-- Subtitulo de Minerales y Calorias por Porcion -->
                                <Border StrokeShape="RoundRectangle 6"
                                        Padding="8, 4"
                                        Background="{AppThemeBinding Light=#EBF5FB, Dark=#1A252F}">
                                    <Label Text="{Binding NutritionSubtitle}"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#1B4F72, Dark=#85C1E9}" />
                                </Border>

                                <!-- Badges Visuales de Minerales por Porcion -->
                                <FlexLayout BindableLayout.ItemsSource="{Binding MineralsPerServing}"
                                            Wrap="Wrap"
                                            Margin="0, 4, 0, 4">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="dto:MineralAmountDto">
                                            <Border Margin="0, 2, 6, 2"
                                                    Padding="6, 3"
                                                    StrokeShape="RoundRectangle 6"
                                                    Background="{AppThemeBinding Light=#E8F8F5, Dark=#164E43}">
                                                <Label Text="{Binding DisplayText}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#117A65, Dark=#48C9B0}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <!-- Descripcion breve -->
                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       TextColor="Gray"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation" />

                                <!-- Boton de visualizacion de pasos -->
                                <Button Text="{loc:Translate Recipes_ViewSteps}"
                                        Command="{Binding Source={x:Reference ThisRecipesPage}, Path=BindingContext.SelectRecipeCommand}"
                                        CommandParameter="{Binding .}"
                                        Margin="0, 8, 0, 0"
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        HeightRequest="44"
                                        MinimumHeightRequest="44" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
