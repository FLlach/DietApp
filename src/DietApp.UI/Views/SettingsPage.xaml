<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             xmlns:models="clr-namespace:DietApp.UI.Models"
             x:Class="DietApp.UI.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{loc:Translate Settings_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWarm}, Dark={StaticResource Black}}">

    <!--
    Como funciona: Modulo de configuracion y ajustes basado en el diseno Stitch 'Clinical Nutrition Ergonomics'.
    Organiza mediante tarjetas Bento las preferencias de interfaz (idioma y temas visuales), los limites
    clinicos de los 7 minerales criticos (con umbral preventivo porcentual) y los metadatos del sistema.
    Por que se tomo esta decision: Permite una personalizacion clinica inmediata con objetivos tactiles
    de 48dp y confirmaciones en tiempo real para pacientes y dietistas.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- 1. Encabezado de la Pantalla -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16, 12"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="DIETAPP • PARÁMETROS Y ALERTAS"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDark}" />
                    <Label Text="{loc:Translate Settings_Title}"
                           FontAttributes="Bold"
                           FontSize="20"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                    <Label Text="Configuración metabólica, idioma y temas"
                           FontSize="12"
                           TextColor="{StaticResource Outline}" />
                </VerticalStackLayout>
            </Border>

            <!-- 2. Bento: Preferencias de Interfaz (Idioma y Tema) -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate Settings_LanguageTitle}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                    <Label Text="{loc:Translate Settings_LanguageSubtitle}"
                           FontSize="12"
                           TextColor="{StaticResource Outline}" />

                    <!-- Opciones de Idioma con estética Stitch (48dp touch targets) -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <!-- Opcion Espanol -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="12"
                                Stroke="{Binding SpanishBorderColor}"
                                StrokeThickness="{Binding SpanishBorderThickness}"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#1A1A22}">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="ES"
                                       FontAttributes="Bold"
                                       FontSize="20"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{StaticResource PrimaryDark}" />
                                <Label Text="{loc:Translate Settings_Spanish}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                <Button Text="{loc:Translate Common_Select}"
                                        Command="{Binding SelectSpanishCommand}"
                                        Style="{StaticResource StitchPrimaryButtonStyle}"
                                        HeightRequest="44"
                                        MinimumHeightRequest="44"
                                        Padding="14, 0" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Opcion Ingles -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 14"
                                Padding="12"
                                Stroke="{Binding EnglishBorderColor}"
                                StrokeThickness="{Binding EnglishBorderThickness}"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#1A1A22}">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="EN"
                                       FontAttributes="Bold"
                                       FontSize="20"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{StaticResource PrimaryDark}" />
                                <Label Text="{loc:Translate Settings_English}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                <Button Text="{loc:Translate Common_Select}"
                                        Command="{Binding SelectEnglishCommand}"
                                        Style="{StaticResource StitchNeutralButtonStyle}"
                                        HeightRequest="44"
                                        MinimumHeightRequest="44"
                                        Padding="14, 0" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="{Binding StatusMessage}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDark}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 3. Bento: Seleccion de Tema Visual -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate Settings_ThemeTitle}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                    <Label Text="{loc:Translate Settings_ThemeSubtitle}"
                           FontSize="12"
                           TextColor="{StaticResource Outline}" />

                    <!-- Opciones de Tema Visual: Claro, Oscuro, Sistema -->
                    <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                        <!-- Opcion Modo Claro -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="8, 12"
                                Stroke="{Binding LightBorderColor}"
                                StrokeThickness="{Binding LightBorderThickness}"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#1E1E24}">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="CLARO"
                                       FontAttributes="Bold"
                                       FontSize="11"
                                       TextColor="{StaticResource PrimaryDark}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{loc:Translate Settings_ThemeLight}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                <Button Text="{loc:Translate Common_Select}"
                                        Command="{Binding SelectLightCommand}"
                                        Style="{StaticResource StitchPrimaryButtonStyle}"
                                        HeightRequest="40"
                                        MinimumHeightRequest="40"
                                        Padding="8, 0"
                                        FontSize="11" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Opcion Modo Oscuro -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="8, 12"
                                Stroke="{Binding DarkBorderColor}"
                                StrokeThickness="{Binding DarkBorderThickness}"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#1A1A22}">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="OSCURO"
                                       FontAttributes="Bold"
                                       FontSize="11"
                                       TextColor="{StaticResource Secondary}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{loc:Translate Settings_ThemeDark}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                <Button Text="{loc:Translate Common_Select}"
                                        Command="{Binding SelectDarkCommand}"
                                        Style="{StaticResource StitchNeutralButtonStyle}"
                                        HeightRequest="40"
                                        MinimumHeightRequest="40"
                                        Padding="8, 0"
                                        FontSize="11" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Opcion Sistema -->
                        <Border Grid.Column="2"
                                StrokeShape="RoundRectangle 12"
                                Padding="8, 12"
                                Stroke="{Binding SystemBorderColor}"
                                StrokeThickness="{Binding SystemBorderThickness}"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#1A1A22}">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="AUTO"
                                       FontAttributes="Bold"
                                       FontSize="11"
                                       TextColor="{StaticResource Outline}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{loc:Translate Settings_ThemeSystem}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                                <Button Text="{loc:Translate Common_Select}"
                                        Command="{Binding SelectSystemCommand}"
                                        Style="{StaticResource StitchNeutralButtonStyle}"
                                        HeightRequest="40"
                                        MinimumHeightRequest="40"
                                        Padding="8, 0"
                                        FontSize="11" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Label Text="{Binding ThemeStatusMessage}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDark}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 4. Bento: Parametros Clinicos y Limites de Minerales -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate Settings_MineralAlertsTitle}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                    <Label Text="{loc:Translate Settings_MineralAlertsSubtitle}"
                           FontSize="12"
                           TextColor="{StaticResource Outline}" />

                    <!-- Configuracion de Umbral Porcentual Preventivo -->
                    <Border StrokeShape="RoundRectangle 14"
                            Padding="14"
                            Background="{AppThemeBinding Light=#FEF9E7, Dark=#262115}"
                            Stroke="{StaticResource WarningAmber}"
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="{loc:Translate Settings_WarningThresholdTitle}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="{StaticResource WarningAmber}"
                                       VerticalOptions="Center" />

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 9999"
                                        Padding="10, 4"
                                        Background="{StaticResource WarningAmber}">
                                    <Label Text="{Binding WarningPercentageDisplay}"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="White" />
                                </Border>
                            </Grid>

                            <Label Text="{loc:Translate Settings_WarningThresholdSubtitle}"
                                   FontSize="12"
                                   TextColor="{StaticResource Outline}" />

                            <Slider Minimum="50"
                                    Maximum="95"
                                    Value="{Binding WarningPercentage}"
                                    ThumbColor="{StaticResource WarningAmber}"
                                    MinimumTrackColor="{StaticResource WarningAmber}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lista de Minerales con Entrada de Limite Maximo -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MineralAlerts}"
                                         Spacing="10"
                                         Margin="0, 4, 0, 0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MineralAlertConfigModel">
                                <Border StrokeShape="RoundRectangle 12"
                                        Padding="12, 10"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#1A1A22}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                        StrokeThickness="1">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Label Grid.Column="0"
                                               Text="{Binding MineralName}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}"
                                               VerticalOptions="Center" />

                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Border StrokeShape="RoundRectangle 10"
                                                    Padding="8, 0"
                                                    WidthRequest="85"
                                                    Stroke="{StaticResource BorderWarmLight}"
                                                    StrokeThickness="1"
                                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark=#2C3E50}">
                                                <Entry Text="{Binding ThresholdText}"
                                                       Keyboard="Numeric"
                                                       Placeholder="0"
                                                       HorizontalTextAlignment="End"
                                                       HeightRequest="44"
                                                       FontSize="13" />
                                            </Border>
                                            <Label Text="{Binding Unit}"
                                                   FontSize="12"
                                                   TextColor="{StaticResource Outline}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <Switch Grid.Column="2"
                                                IsToggled="{Binding IsEnabled}"
                                                OnColor="{StaticResource Primary}"
                                                ThumbColor="{AppThemeBinding Light=White, Dark={StaticResource PrimaryDark}}"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Botones de Accion -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0, 6, 0, 0">
                        <Button Grid.Column="0"
                                Text="{loc:Translate Settings_MineralAlertsSave}"
                                Command="{Binding SaveAlertsCommand}"
                                Style="{StaticResource StitchPrimaryButtonStyle}"
                                HeightRequest="48"
                                MinimumHeightRequest="48"
                                FontSize="13" />

                        <Button Grid.Column="1"
                                Text="{loc:Translate Settings_MineralAlertsReset}"
                                Command="{Binding ResetAlertsCommand}"
                                Style="{StaticResource StitchSecondaryButtonStyle}"
                                HeightRequest="48"
                                MinimumHeightRequest="48"
                                FontSize="13" />
                    </Grid>

                    <Label Text="{Binding AlertsStatusMessage}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource PrimaryDark}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- 5. Tarjeta Informativa de la Aplicacion -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Settings_AboutTitle}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                    <Label Text="{loc:Translate Settings_AboutDescription}"
                           FontSize="12"
                           TextColor="{StaticResource Outline}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}" Margin="0, 4" />
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Base de Datos:" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource PrimaryDark}" />
                        <Label Grid.Column="1" Text="SQLite (USDA FoodData Central Foundation Foods)" FontSize="12" TextColor="{StaticResource Outline}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Framework:" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource PrimaryDark}" />
                        <Label Grid.Column="1" Text=".NET 10 MAUI (Android API 21-35 / Multiplataforma)" FontSize="12" TextColor="{StaticResource Outline}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
