<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{loc:Translate Settings_Title}">

    <!--
    Como funciona: Pantalla de configuracion de la aplicacion que permite seleccionar interactivamente
    el idioma preferido entre Espanol e Ingles.
    Por que se tomo esta decision: Brinda al usuario una forma visual, intuitiva y persistente de alternar
    el idioma, impactando de forma inmediata en las pestanas, titulos, etiquetas, minerales y comidas.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- Encabezado de la pantalla -->
            <Label Text="{loc:Translate Settings_Title}"
                   FontAttributes="Bold"
                   FontSize="20" />

            <!-- Tarjeta de Seleccion de Idioma -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate Settings_LanguageTitle}"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <Label Text="{loc:Translate Settings_LanguageSubtitle}"
                           FontSize="13"
                           TextColor="Gray" />

                    <!-- Opciones de Idioma -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0, 4, 0, 0">
                        <!-- Opcion Espanol -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="12"
                                Stroke="{Binding IsSpanishSelected, Converter={x:Null}}"
                                Background="{AppThemeBinding Light=#F4F6F7, Dark=#1A1A22}">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="ES"
                                       FontAttributes="Bold"
                                       FontSize="22"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#2980B9, Dark=#3498DB}" />
                                <Label Text="{loc:Translate Settings_Spanish}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center" />
                                <Button Text="Seleccionar"
                                        Command="{Binding SelectSpanishCommand}"
                                        FontSize="11"
                                        Padding="10, 4"
                                        HeightRequest="36"
                                        BackgroundColor="{AppThemeBinding Light=#2980B9, Dark=#3498DB}"
                                        TextColor="White" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Opcion Ingles -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12"
                                Stroke="{Binding IsEnglishSelected, Converter={x:Null}}"
                                Background="{AppThemeBinding Light=#F4F6F7, Dark=#1A1A22}">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="EN"
                                       FontAttributes="Bold"
                                       FontSize="22"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#27AE60, Dark=#2ECC71}" />
                                <Label Text="{loc:Translate Settings_English}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center" />
                                <Button Text="Select"
                                        Command="{Binding SelectEnglishCommand}"
                                        FontSize="11"
                                        Padding="10, 4"
                                        HeightRequest="36"
                                        BackgroundColor="{AppThemeBinding Light=#27AE60, Dark=#2ECC71}"
                                        TextColor="White" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Mensaje de estado al cambiar -->
                    <Label Text="{Binding StatusMessage}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#1E8449"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Tarjeta Informativa de la Aplicacion -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Settings_AboutTitle}"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <Label Text="{loc:Translate Settings_AboutDescription}"
                           FontSize="13"
                           TextColor="Gray" />
                    <BoxView HeightRequest="1" Color="#BDC3C7" Margin="0, 4" />
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Base de Datos:" FontAttributes="Bold" FontSize="12" />
                        <Label Grid.Column="1" Text="SQLite (USDA FoodData Central Foundation Foods)" FontSize="12" TextColor="Gray" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Version:" FontAttributes="Bold" FontSize="12" />
                        <Label Grid.Column="1" Text="1.0.0 (.NET 10 MAUI)" FontSize="12" TextColor="Gray" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
