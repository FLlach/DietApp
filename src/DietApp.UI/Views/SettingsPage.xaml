<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             xmlns:models="clr-namespace:DietApp.UI.Models"
             x:Class="DietApp.UI.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{loc:Translate Settings_Title}">

    <!--
    Como funciona: Pantalla de configuracion de la aplicacion que permite seleccionar interactivamente
    el idioma preferido entre Espanol e Ingles.
    Por que se tomo esta decision: Brinda al usuario una forma visual, intuitiva y persistente de alternar
    el idioma, impactando de forma inmediata en las pestanas, titulos, etiquetas, minerales y comidas.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- Encabezado de la pantalla -->
            <Label Text="{loc:Translate Settings_Title}"
                   FontAttributes="Bold"
                   FontSize="20" />

            <!-- Tarjeta de Seleccion de Idioma -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate Settings_LanguageTitle}"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <Label Text="{loc:Translate Settings_LanguageSubtitle}"
                           FontSize="13"
                           TextColor="Gray" />

                    <!-- Opciones de Idioma -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0, 4, 0, 0">
                        <!-- Opcion Espanol -->
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 10"
                                Padding="12"
                                Stroke="{Binding SpanishBorderColor}"
                                StrokeThickness="{Binding SpanishBorderThickness}"
                                Background="{AppThemeBinding Light=#F4F6F7, Dark=#1A1A22}">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="ES"
                                       FontAttributes="Bold"
                                       FontSize="22"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#2980B9, Dark=#3498DB}" />
                                <Label Text="{loc:Translate Settings_Spanish}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center" />
                                <Button Text="{loc:Translate Common_Select}"
                                        Command="{Binding SelectSpanishCommand}"
                                        FontSize="12"
                                        Padding="12, 6"
                                        HeightRequest="44"
                                        MinimumHeightRequest="44"
                                        MinimumWidthRequest="44"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        TextColor="White" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Opcion Ingles -->
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="12"
                                Stroke="{Binding EnglishBorderColor}"
                                StrokeThickness="{Binding EnglishBorderThickness}"
                                Background="{AppThemeBinding Light=#F4F6F7, Dark=#1A1A22}">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="EN"
                                       FontAttributes="Bold"
                                       FontSize="22"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource SuccessGreen}, Dark={StaticResource SuccessGreenDark}}" />
                                <Label Text="{loc:Translate Settings_English}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       HorizontalTextAlignment="Center" />
                                <Button Text="{loc:Translate Common_Select}"
                                        Command="{Binding SelectEnglishCommand}"
                                        FontSize="12"
                                        Padding="12, 6"
                                        HeightRequest="44"
                                        MinimumHeightRequest="44"
                                        MinimumWidthRequest="44"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SuccessGreen}, Dark={StaticResource SuccessGreenDark}}"
                                        TextColor="White" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Mensaje de estado al cambiar -->
                    <Label Text="{Binding StatusMessage}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource HealthTeal}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Tarjeta de Alertas y Limites de Minerales -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate Settings_MineralAlertsTitle}"
                           FontAttributes="Bold"
                           FontSize="16" />

                    <Label Text="{loc:Translate Settings_MineralAlertsSubtitle}"
                           FontSize="13"
                           TextColor="Gray" />

                    <!-- Configuracion de Umbral Porcentual de Aviso Preventivo -->
                    <Border StrokeShape="RoundRectangle 10"
                            Padding="12"
                            Background="{AppThemeBinding Light=#FEF9E7, Dark=#262115}"
                            Stroke="{AppThemeBinding Light=#F9E79F, Dark=#564A23}"
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="{loc:Translate Settings_WarningThresholdTitle}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       VerticalOptions="Center" />

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="10, 4"
                                        Background="{AppThemeBinding Light=#F39C12, Dark=#D68910}">
                                    <Label Text="{Binding WarningPercentageDisplay}"
                                           FontAttributes="Bold"
                                           FontSize="13"
                                           TextColor="White" />
                                </Border>
                            </Grid>

                            <Label Text="{loc:Translate Settings_WarningThresholdSubtitle}"
                                   FontSize="12"
                                   TextColor="Gray" />

                            <Slider Minimum="50"
                                    Maximum="95"
                                    Value="{Binding WarningPercentage}"
                                    ThumbColor="{StaticResource WarningAmber}"
                                    MinimumTrackColor="{StaticResource WarningAmber}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lista de Minerales con Entrada de Limite Maximo -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MineralAlerts}"
                                         Spacing="10"
                                         Margin="0, 4, 0, 0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MineralAlertConfigModel">
                                <Border StrokeShape="RoundRectangle 8"
                                        Padding="10, 8"
                                        Background="{AppThemeBinding Light=#F8F9F9, Dark=#1A1A22}">
                                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <!-- Nombre del Mineral -->
                                        <Label Grid.Column="0"
                                               Text="{Binding MineralName}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               VerticalOptions="Center" />

                                        <!-- Campo de Limite en mg -->
                                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                            <Border StrokeShape="RoundRectangle 6"
                                                    Padding="6, 0"
                                                    WidthRequest="80"
                                                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#2C3E50}">
                                                <Entry Text="{Binding ThresholdText}"
                                                       Keyboard="Numeric"
                                                       Placeholder="0"
                                                       HorizontalTextAlignment="End"
                                                       FontSize="13" />
                                            </Border>
                                            <Label Text="{Binding Unit}"
                                                   FontSize="12"
                                                   TextColor="Gray"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <!-- Conmutador Activar/Desactivar -->
                                        <Switch Grid.Column="2"
                                                IsToggled="{Binding IsEnabled}"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Botones de Accion -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0, 6, 0, 0">
                        <Button Grid.Column="0"
                                Text="{loc:Translate Settings_MineralAlertsSave}"
                                Command="{Binding SaveAlertsCommand}"
                                FontAttributes="Bold"
                                HeightRequest="44"
                                FontSize="12"
                                BackgroundColor="{StaticResource HealthTeal}"
                                TextColor="White" />

                        <Button Grid.Column="1"
                                Text="{loc:Translate Settings_MineralAlertsReset}"
                                Command="{Binding ResetAlertsCommand}"
                                HeightRequest="44"
                                FontSize="12"
                                BackgroundColor="{StaticResource AlertRed}"
                                TextColor="White" />
                    </Grid>

                    <!-- Mensaje de Estado de Alertas -->
                    <Label Text="{Binding AlertsStatusMessage}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource HealthTeal}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Tarjeta Informativa de la Aplicacion -->
            <Border StrokeShape="RoundRectangle 12"
                    Padding="16"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Settings_AboutTitle}"
                           FontAttributes="Bold"
                           FontSize="15" />
                    <Label Text="{loc:Translate Settings_AboutDescription}"
                           FontSize="13"
                           TextColor="Gray" />
                    <BoxView HeightRequest="1" Color="{StaticResource Gray300}" Margin="0, 4" />
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Base de Datos:" FontAttributes="Bold" FontSize="12" />
                        <Label Grid.Column="1" Text="SQLite (USDA FoodData Central Foundation Foods)" FontSize="12" TextColor="Gray" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="Version:" FontAttributes="Bold" FontSize="12" />
                        <Label Grid.Column="1" Text="1.0.0 (.NET 10 MAUI)" FontSize="12" TextColor="Gray" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
