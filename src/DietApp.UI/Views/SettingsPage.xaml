<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:helpers="clr-namespace:DietApp.UI.Helpers"
             x:Class="DietApp.UI.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Ajustes"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource StitchBackground}, Dark={StaticResource StitchDarkBackground}}">

    <!--
    Como funciona: Pantalla de Configuracion y Ajustes clinicos de DietApp fiel al prototipo Stitch
    'Ajustes y Configuración (SettingsPage)'. Ofrece seleccion bilingüe reactiva (ES/EN), seleccion de tema
    visual (Claro, Oscuro, Sistema), calibracion tactil del umbral preventivo de alerta con barra deslizadora
    y visualizacion numerica, administracion de limites diarios para los 7 minerales diana con interruptores
    individuales de activacion, restauracion a directrices KDOQI/USDA y auditoria tecnica de la base local SQLite.
    Por que se tomo esta decision: Permite adaptar la experiencia de usuario y las reglas de seguridad renal
    a la etapa clinica y necesidades especificas de cada paciente.
    -->

    <Grid RowDefinitions="Auto, *">

        <!-- 1. TopAppBar (Encabezado Superior Fijo) -->
        <Border Grid.Row="0"
                StrokeShape="Rectangle"
                StrokeThickness="0,0,0,1"
                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}"
                Background="{AppThemeBinding Light={StaticResource StitchSurface}, Dark={StaticResource StitchDarkSurface}}"
                Padding="16, 10">
            <Grid ColumnDefinitions="*, Auto" MaximumWidthRequest="560" HorizontalOptions="Center">

                <!-- Titulo y Subtitulo -->
                <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainer}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                            WidthRequest="40"
                            HeightRequest="40"
                            VerticalOptions="Center">
                        <Label Text="{x:Static helpers:MaterialIconFont.ManageAccounts}"
                               Style="{StaticResource MaterialIconStyle}"
                               FontSize="20"
                               TextColor="{StaticResource StitchPrimary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label Text="Configuración y Ajustes"
                               FontFamily="PlusJakartaSans"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                        <Label Text="DietApp • Parámetros y Alertas"
                               FontFamily="Inter"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <!-- Botones de Accion Superior (Sincronizar y Guia Clinica) -->
                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Border StrokeShape="RoundRectangle 9999"
                            StrokeThickness="0"
                            Background="Transparent"
                            WidthRequest="36"
                            HeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SyncClinicalDataCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static helpers:MaterialIconFont.Sync}"
                               Style="{StaticResource MaterialIconStyle}"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Border StrokeShape="RoundRectangle 9999"
                            StrokeThickness="0"
                            Background="Transparent"
                            WidthRequest="36"
                            HeightRequest="36">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowClinicalGuideCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static helpers:MaterialIconFont.MedicalInformation}"
                               Style="{StaticResource MaterialIconStyle}"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>

            </Grid>
        </Border>

        <!-- 2. Contenido Principal Desplazable -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16, 14, 16, 36"
                                 Spacing="16"
                                 MaximumWidthRequest="560"
                                 HorizontalOptions="Center">

                <!-- 2.1 Preferencias de Interfaz (Bento 1) -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto" Padding="2, 0">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="{x:Static helpers:MaterialIconFont.Tune}"
                                   Style="{StaticResource MaterialIconStyle}"
                                   FontSize="18"
                                   TextColor="{StaticResource StitchPrimary}" />
                            <Label Text="Preferencias de Interfaz"
                                   FontFamily="PlusJakartaSans"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                        </HorizontalStackLayout>
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 9999"
                                StrokeThickness="0"
                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainer}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                                Padding="8, 2">
                            <Label Text="Ergonomía"
                                   FontFamily="Inter"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource StitchPrimary}" />
                        </Border>
                    </Grid>

                    <!-- Selector de Idioma -->
                    <Border Style="{StaticResource StitchCardBorderStyle}"
                            Padding="14"
                            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*, Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                    <Label Text="{x:Static helpers:MaterialIconFont.Language}"
                                           Style="{StaticResource MaterialIconStyle}"
                                           FontSize="16"
                                           TextColor="{StaticResource StitchOutline}" />
                                    <Label Text="Idioma de la Aplicación"
                                           FontFamily="Inter"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                </HorizontalStackLayout>
                                <Label Grid.Column="1"
                                       Text="Soporte Bilingüe UI"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       TextColor="{StaticResource StitchOutline}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">

                                <!-- Tarjeta Espanol -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectLanguageCommand}" CommandParameter="es" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSpanishSelected}" Value="True">
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Stroke" Value="{StaticResource StitchPrimaryContainer}" />
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StitchSurfaceBright}, Dark={StaticResource StitchDarkSurfaceContainer}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSpanishSelected}" Value="False">
                                            <Setter Property="StrokeThickness" Value="1" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLowest}}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                Background="#2584CC16"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                VerticalOptions="Center">
                                            <Label Text="ES"
                                                   FontFamily="Inter"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource StitchPrimary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="Español"
                                                   FontFamily="Inter"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                            <Label Text="Normativa UE"
                                                   FontFamily="Inter"
                                                   FontSize="9"
                                                   TextColor="{StaticResource StitchOutline}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{x:Static helpers:MaterialIconFont.CheckCircle}"
                                               Style="{StaticResource MaterialIconStyle}"
                                               FontSize="18"
                                               TextColor="{StaticResource StitchPrimary}"
                                               IsVisible="{Binding IsSpanishSelected}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                                <!-- Tarjeta Ingles -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectLanguageCommand}" CommandParameter="en" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsEnglishSelected}" Value="True">
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Stroke" Value="{StaticResource StitchPrimaryContainer}" />
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StitchSurfaceBright}, Dark={StaticResource StitchDarkSurfaceContainer}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsEnglishSelected}" Value="False">
                                            <Setter Property="StrokeThickness" Value="1" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLowest}}" />
                                        </DataTrigger>
                                    </Border.Triggers>

                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 8"
                                                StrokeThickness="0"
                                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerHigh}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                VerticalOptions="Center">
                                            <Label Text="EN"
                                                   FontFamily="Inter"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label Text="English"
                                                   FontFamily="Inter"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                            <Label Text="US KDOQI / USDA"
                                                   FontFamily="Inter"
                                                   FontSize="9"
                                                   TextColor="{StaticResource StitchOutline}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{x:Static helpers:MaterialIconFont.CheckCircle}"
                                               Style="{StaticResource MaterialIconStyle}"
                                               FontSize="18"
                                               TextColor="{StaticResource StitchPrimary}"
                                               IsVisible="{Binding IsEnglishSelected}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>

                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Selector de Tema Visual -->
                    <Border Style="{StaticResource StitchCardBorderStyle}"
                            Padding="14"
                            StrokeShape="RoundRectangle 16">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:MaterialIconFont.Palette}"
                                       Style="{StaticResource MaterialIconStyle}"
                                       FontSize="16"
                                       TextColor="{StaticResource StitchOutline}" />
                                <Label Text="Tema Visual y Contraste"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">

                                <!-- Modo Claro -->
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectThemeCommand}" CommandParameter="Light" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsLightThemeSelected}" Value="True">
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Stroke" Value="{StaticResource StitchPrimaryContainer}" />
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StitchSurfaceBright}, Dark={StaticResource StitchDarkSurfaceContainer}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsLightThemeSelected}" Value="False">
                                            <Setter Property="StrokeThickness" Value="1" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLowest}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{x:Static helpers:MaterialIconFont.LightMode}"
                                               Style="{StaticResource MaterialIconStyle}"
                                               FontSize="20"
                                               TextColor="{StaticResource StitchPrimary}"
                                               HorizontalOptions="Center" />
                                        <Label Text="Claro"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                               HorizontalOptions="Center" />
                                        <Label Text="Activo"
                                               FontFamily="Inter"
                                               FontSize="9"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource StitchPrimary}"
                                               HorizontalOptions="Center"
                                               IsVisible="{Binding IsLightThemeSelected}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Modo Oscuro -->
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectThemeCommand}" CommandParameter="Dark" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsDarkThemeSelected}" Value="True">
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Stroke" Value="{StaticResource StitchPrimaryContainer}" />
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StitchSurfaceBright}, Dark={StaticResource StitchDarkSurfaceContainer}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsDarkThemeSelected}" Value="False">
                                            <Setter Property="StrokeThickness" Value="1" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLowest}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{x:Static helpers:MaterialIconFont.DarkMode}"
                                               Style="{StaticResource MaterialIconStyle}"
                                               FontSize="20"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchPrimary}}"
                                               HorizontalOptions="Center" />
                                        <Label Text="Oscuro"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                               HorizontalOptions="Center" />
                                        <Label Text="OLED"
                                               FontFamily="Inter"
                                               FontSize="9"
                                               TextColor="{StaticResource StitchOutline}"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Modo Sistema -->
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectThemeCommand}" CommandParameter="System" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSystemThemeSelected}" Value="True">
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Stroke" Value="{StaticResource StitchPrimaryContainer}" />
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StitchSurfaceBright}, Dark={StaticResource StitchDarkSurfaceContainer}}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSystemThemeSelected}" Value="False">
                                            <Setter Property="StrokeThickness" Value="1" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                            <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLowest}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{x:Static helpers:MaterialIconFont.Devices}"
                                               Style="{StaticResource MaterialIconStyle}"
                                               FontSize="20"
                                               TextColor="{StaticResource StitchOutline}"
                                               HorizontalOptions="Center" />
                                        <Label Text="Sistema"
                                               FontFamily="Inter"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                               HorizontalOptions="Center" />
                                        <Label Text="Auto"
                                               FontFamily="Inter"
                                               FontSize="9"
                                               TextColor="{StaticResource StitchOutline}"
                                               HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Border>

                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- 2.2 Calibracion del Umbral Preventivo de Alerta (Bento 2) -->
                <Border Style="{StaticResource StitchCardBorderStyle}"
                        Padding="16"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{x:Static helpers:MaterialIconFont.Warning}"
                                           Style="{StaticResource MaterialIconStyle}"
                                           FontSize="18"
                                           TextColor="{StaticResource StitchSecondary}" />
                                    <Label Text="Umbral Preventivo de Alerta"
                                           FontFamily="PlusJakartaSans"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                </HorizontalStackLayout>
                                <Label Text="Dispara la alerta temprana antes de alcanzar el 100% de la carga de filtración."
                                       FontFamily="Inter"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                            </VerticalStackLayout>

                            <!-- Indicador Porcentual -->
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 9999"
                                    StrokeThickness="1"
                                    Stroke="#4084CC16"
                                    Background="#2584CC16"
                                    Padding="10, 4"
                                    VerticalOptions="Start">
                                <HorizontalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding WarningThresholdDisplay}"
                                           FontFamily="Inter"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource StitchOnPrimaryContainer}" />
                                    <Label Text="%"
                                           FontFamily="Inter"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource StitchPrimary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Slider Interactivo Tactil -->
                        <VerticalStackLayout Spacing="4" Margin="0, 4, 0, 0">
                            <Slider Minimum="50"
                                    Maximum="95"
                                    Value="{Binding WarningThresholdPercent, Mode=TwoWay}"
                                    MinimumTrackColor="{StaticResource StitchPrimaryContainer}"
                                    MaximumTrackColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerHigh}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                                    ThumbColor="{StaticResource StitchPrimary}" />
                            <Grid ColumnDefinitions="Auto, *, Auto" Padding="2, 0">
                                <Label Grid.Column="0"
                                       Text="50% (Muy prudente)"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       TextColor="{StaticResource StitchOutline}" />
                                <Label Grid.Column="1"
                                       Text="80% Recomendado"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource StitchPrimary}"
                                       HorizontalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="95% (Crítico)"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       TextColor="{StaticResource StitchOutline}" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Nota de Protocolo Clinico -->
                        <Border StrokeShape="RoundRectangle 10"
                                StrokeThickness="0"
                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}"
                                Padding="10">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{x:Static helpers:MaterialIconFont.VerifiedUser}"
                                       Style="{StaticResource MaterialIconStyle}"
                                       FontSize="18"
                                       TextColor="{StaticResource StitchPrimary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Alineado con directrices KDOQI 2024 para prevención de hiperpotasemia e hiperfosfatemia."
                                       FontFamily="Inter"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

                <!-- 2.3 Limites Clinicos y Metas Nutricionales (Bento 3) -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto" Padding="2, 0">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="{x:Static helpers:MaterialIconFont.Science}"
                                   Style="{StaticResource MaterialIconStyle}"
                                   FontSize="18"
                                   TextColor="{StaticResource StitchPrimary}" />
                            <Label Text="Límites Clínicos y Metas Nutricionales"
                                   FontFamily="PlusJakartaSans"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1"
                               Text="Metas y 7 Minerales"
                               FontFamily="Inter"
                               FontSize="11"
                               TextColor="{StaticResource StitchOutline}"
                               VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="10">

                        <!-- 0.1 Meta Diaria de Calorias (KCAL) -->
                        <Border Style="{StaticResource StitchCardBorderStyle}" Padding="12" StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 8" StrokeThickness="0" Background="{StaticResource EnergyCalorieContainer}" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                        <Label Text="KCAL" FontFamily="Inter" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource EnergyCalorieText}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Meta de Calorías" FontFamily="Inter" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                        <Label Text="Gasto Energético Diario • 2000 kcal estándar" FontFamily="Inter" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource EnergyCalorieText}" />
                                    </VerticalStackLayout>
                                    <Switch Grid.Column="2" IsToggled="{Binding IsCalorieGoalEnabled, Mode=TwoWay}" OnColor="{StaticResource StitchPrimaryContainer}" ThumbColor="{StaticResource StitchPrimary}" VerticalOptions="Center" />
                                </Grid>
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource StitchOutlineVariantSoft}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="Meta Diaria Recomendada:" FontFamily="Inter" FontSize="11" TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="1" Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}" Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceContainerLow}}" HeightRequest="36" WidthRequest="80" Padding="6, 0">
                                            <Entry Text="{Binding CalorieGoalText, Mode=TwoWay}" Keyboard="Numeric" FontFamily="Inter" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" HorizontalTextAlignment="End" BackgroundColor="Transparent" VerticalOptions="Center" />
                                        </Border>
