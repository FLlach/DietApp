                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Sincronización Local" FontFamily="Inter" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding LastSyncText}" FontFamily="Inter" FontSize="11" TextColor="{StaticResource StitchOutline}" VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Enlace Exportar Informe PDF -->
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainer}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                                Padding="12, 10"
                                Margin="0, 4, 0, 0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ExportReportPdfCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="{x:Static helpers:MaterialIconFont.PictureAsPdf}"
                                       Style="{StaticResource MaterialIconStyle}"
                                       FontSize="20"
                                       TextColor="{StaticResource StitchSecondary}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="Exportar Resumen Clínico (PDF)"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2"
                                       Text="{x:Static helpers:MaterialIconFont.ChevronRight}"
                                       Style="{StaticResource MaterialIconStyle}"
                                       FontSize="18"
                                       TextColor="{StaticResource StitchOutline}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
