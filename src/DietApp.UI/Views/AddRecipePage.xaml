<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:models="clr-namespace:DietApp.UI.Models"
             xmlns:dtos="clr-namespace:DietApp.Application.DTOs;assembly=DietApp.Application"
             xmlns:helpers="clr-namespace:DietApp.UI.Helpers"
             x:Class="DietApp.UI.Views.AddRecipePage"
             x:DataType="vm:AddRecipeViewModel"
             Title="Compositor de Receta"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource StitchBackground}, Dark={StaticResource StitchDarkBackground}}">

    <!--
    Como funciona: Compositor clinico de recetas segun el prototipo Stitch 'Compositor de Recetas (AddRecipePage)'.
    Estructurado con TopAppBar modal, selector hero de fotografia del plato terminado, formulario de datos basicos
    con raciones y tiempo de coccion, cuadricula de ingredientes dosificados con integracion directa de alinos guardados,
    panel de proyeccion clinica en tiempo real (macros y los 7 minerales criticos), pasos numerados de elaboracion
    y barra inferior ergonomica de persistencia (Guardar y Borrador).
    Por que se tomo esta decision: Permite una prescripcion y formulacion culinaria de alta precision sin romper
    las restricciones nutricionales del paciente antes de consolidar la receta.
    -->

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- 1. TopAppBar Modal (Cabecera fija superior) -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                Padding="12, 10"
                Shadow="{StaticResource StitchCardShadow}">
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                <Button Grid.Column="0"
                        Text="{x:Static helpers:MaterialIconFont.ArrowBack}"
                        Command="{Binding CancelCommand}"
                        FontFamily="MaterialSymbols"
                        FontSize="22"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}"
                        Padding="0"
                        WidthRequest="44"
                        HeightRequest="44"
                        CornerRadius="22"
                        SemanticProperties.Description="Volver atrás o cancelar" />

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="Compositor de Receta"
                           FontFamily="PlusJakartaSans"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <BoxView WidthRequest="6" HeightRequest="6" CornerRadius="3" Color="{StaticResource StitchPrimaryContainer}" VerticalOptions="Center" />
                        <Label Text="Modo Dosificación Clínica"
                               FontFamily="Inter"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="Guardar"
                        Command="{Binding SaveRecipeCommand}"
                        Style="{StaticResource StitchPrimaryButtonStyle}"
                        HeightRequest="40"
                        Padding="14, 0"
                        CornerRadius="12"
                        SemanticProperties.Description="Guardar receta" />
            </Grid>
        </Border>

        <!-- Contenido Desplazable Principal -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="14, 16, 14, 24" Spacing="16" MaximumWidthRequest="440" HorizontalOptions="Center">

                <!-- 2. Hero Image Picker (Fotografía del Plato) -->
                <Border Style="{StaticResource StitchCardBorderStyle}" Padding="14">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:MaterialIconFont.PhotoCamera}"
                                       Style="{StaticResource MaterialIconStyle}"
                                       FontSize="20"
                                       TextColor="{StaticResource StitchPrimary}" />
                                <Label Text="Fotografía del Plato"
                                       FontFamily="Inter"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                            </HorizontalStackLayout>

                            <Border Grid.Column="2"
                                    StrokeShape="RoundRectangle 9999"
                                    StrokeThickness="0"
                                    Background="{StaticResource StitchPrimaryContainer}"
                                    Padding="8, 2">
                                <Label Text="Recomendado"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource StitchOnPrimaryContainer}" />
                            </Border>
                        </Grid>

                        <!-- Contenedor Visual de Fotografía -->
                        <Border StrokeShape="RoundRectangle 14"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                HeightRequest="210"
                                BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PickPhotoOptionCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <!-- Imagen cargada -->
                                <Image Source="{Binding ImageUrl}"
                                       Aspect="AspectFill"
                                       IsVisible="{Binding HasImage}" />

                                <!-- Estado cuando no hay imagen seleccionada -->
                                <VerticalStackLayout IsVisible="{Binding HasNoImage}"
                                                     HorizontalOptions="Center"
                                                     VerticalOptions="Center"
                                                     Spacing="10"
                                                     Padding="12">
                                    <Label Text="{x:Static helpers:MaterialIconFont.AddAPhoto}"
                                           Style="{StaticResource MaterialIconStyle}"
                                           FontSize="34"
                                           TextColor="{StaticResource StitchOutline}"
                                           HorizontalOptions="Center" />
                                    <Label Text="Toca aquí o elige cómo agregar la fotografía"
                                           FontFamily="Inter"
                                           FontSize="12"
                                           TextColor="{StaticResource StitchOutline}"
                                           HorizontalOptions="Center" />

                                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                        <Button Text="Cámara"
                                                Command="{Binding TakePhotoCommand}"
                                                FontFamily="Inter"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                HeightRequest="44"
                                                Padding="14, 0"
                                                CornerRadius="10"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                                TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                                BorderColor="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                BorderWidth="1"
                                                SemanticProperties.Description="Tomar fotografía con la cámara">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialSymbols"
                                                                 Glyph="{x:Static helpers:MaterialIconFont.PhotoCamera}"
                                                                 Size="18"
                                                                 Color="{StaticResource StitchPrimary}" />
                                            </Button.ImageSource>
                                        </Button>

                                        <Button Text="Galería"
                                                Command="{Binding BrowseGalleryCommand}"
                                                FontFamily="Inter"
                                                FontSize="12"
                                                FontAttributes="Bold"
                                                HeightRequest="44"
                                                Padding="14, 0"
                                                CornerRadius="10"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                                TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                                BorderColor="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                BorderWidth="1"
                                                SemanticProperties.Description="Elegir fotografía de la galería">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialSymbols"
                                                                 Glyph="{x:Static helpers:MaterialIconFont.Collections}"
                                                                 Size="18"
                                                                 Color="{StaticResource StitchPrimary}" />
                                            </Button.ImageSource>
                                        </Button>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Gradiente y Barra de Acciones Superpuesta cuando hay imagen -->
                                <BoxView BackgroundColor="#A0000000" VerticalOptions="End" HeightRequest="64" IsVisible="{Binding HasImage}" />

                                <Grid VerticalOptions="End" Padding="12, 10" ColumnDefinitions="*, Auto" IsVisible="{Binding HasImage}">
                                    <Border Grid.Column="0"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="0"
                                            Background="#E6FFFFFF"
                                            Padding="10, 6"
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Label Text="{x:Static helpers:MaterialIconFont.Verified}"
                                                   Style="{StaticResource MaterialIconStyle}"
                                                   FontSize="16"
                                                   TextColor="{StaticResource StitchPrimary}" />
                                            <Label Text="Foto lista"
                                                   FontFamily="Inter"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#131B2E" />
                                        </HorizontalStackLayout>
                                    </Border>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Button Text="Cámara"
                                                Command="{Binding TakePhotoCommand}"
                                                FontFamily="Inter"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                HeightRequest="44"
                                                Padding="10, 0"
                                                CornerRadius="10"
                                                BackgroundColor="#F2F3FF"
                                                TextColor="#131B2E"
                                                SemanticProperties.Description="Volver a tomar foto con cámara">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialSymbols"
                                                                 Glyph="{x:Static helpers:MaterialIconFont.PhotoCamera}"
                                                                 Size="16"
                                                                 Color="#131B2E" />
                                            </Button.ImageSource>
                                        </Button>

                                        <Button Text="Galería"
                                                Command="{Binding BrowseGalleryCommand}"
                                                FontFamily="Inter"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                HeightRequest="44"
                                                Padding="10, 0"
                                                CornerRadius="10"
                                                BackgroundColor="#F2F3FF"
                                                TextColor="#131B2E"
                                                SemanticProperties.Description="Cambiar foto de la galería">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialSymbols"
                                                                 Glyph="{x:Static helpers:MaterialIconFont.Collections}"
                                                                 Size="16"
                                                                 Color="#131B2E" />
                                            </Button.ImageSource>
                                        </Button>

                                        <Button Command="{Binding RemovePhotoCommand}"
                                                HeightRequest="44"
                                                WidthRequest="44"
                                                Padding="0"
                                                CornerRadius="10"
                                                BackgroundColor="#FFEDEA"
                                                SemanticProperties.Description="Eliminar fotografía del plato">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialSymbols"
                                                                 Glyph="{x:Static helpers:MaterialIconFont.Delete}"
                                                                 Size="18"
                                                                 Color="#BA1A1A" />
                                            </Button.ImageSource>
                                        </Button>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 3. Información Básica -->
                <Border Style="{StaticResource StitchCardBorderStyle}" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="{x:Static helpers:MaterialIconFont.Restaurant}"
                                   Style="{StaticResource MaterialIconStyle}"
                                   FontSize="20"
                                   TextColor="{StaticResource StitchPrimary}" />
                            <Label Text="Información Básica"
                                   FontFamily="PlusJakartaSans"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                        </HorizontalStackLayout>

                        <!-- Nombre de la preparación -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Nombre de la preparación culinaria"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                    Padding="12, 2">
                                <Entry Text="{Binding Title}"
                                       Placeholder="Ej. Pechuga macerada en cítricos"
                                       FontFamily="PlusJakartaSans"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Descripción o notas clínicas -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Descripción o notas clínicas"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                    Padding="12, 6">
                                <Editor Text="{Binding Description}"
                                        Placeholder="Detalles dietéticos, precauciones de remojo o técnica culinaria..."
                                        FontFamily="PlusJakartaSans"
                                        FontSize="13"
                                        AutoSize="TextChanges"
                                        HeightRequest="60"
                                        TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Selectores en Cuadrícula: Raciones Totales y Tiempo Estimado -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <!-- Raciones Totales -->
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                    Padding="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="RACIONES TOTALES"
                                           FontFamily="Inter"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                    <Grid ColumnDefinitions="36, *, 36" VerticalOptions="Center" Margin="0, 4, 0, 0">
                                        <Button Grid.Column="0"
                                                Text="{x:Static helpers:MaterialIconFont.Remove}"
                                                Command="{Binding DecreaseServingsCommand}"
                                                FontFamily="MaterialSymbols"
                                                FontSize="16"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                CornerRadius="8"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                                TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                                Padding="0" />
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                                            <Label Text="{Binding Servings}"
                                                   FontFamily="Inter"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                            <Label Text="porciones"
                                                   FontFamily="Inter"
                                                   FontSize="9"
                                                   HorizontalTextAlignment="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2"
                                                Text="{x:Static helpers:MaterialIconFont.Add}"
                                                Command="{Binding IncreaseServingsCommand}"
                                                FontFamily="MaterialSymbols"
                                                FontSize="16"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                CornerRadius="8"
                                                BackgroundColor="{StaticResource StitchPrimaryContainer}"
                                                TextColor="{StaticResource StitchOnPrimaryContainer}"
                                                Padding="0" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Tiempo Estimado -->
                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                    Padding="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="TIEMPO COCCIÓN"
                                           FontFamily="Inter"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" Margin="0, 4, 0, 0">
                                        <Label Grid.Column="0"
                                               Text="{x:Static helpers:MaterialIconFont.Timer}"
                                               Style="{StaticResource MaterialIconStyle}"
                                               FontSize="24"
                                               TextColor="{StaticResource StitchPrimary}"
                                               VerticalOptions="Center" />
                                        <HorizontalStackLayout Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center" Spacing="2">
                                            <Entry Text="{Binding CookTimeMinutes}"
                                                   Keyboard="Numeric"
                                                   FontFamily="Inter"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   WidthRequest="46"
                                                   HorizontalTextAlignment="End"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                            <Label Text="min"
                                                   FontFamily="Inter"
                                                   FontSize="12"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 4. Ingredientes Dosificados e Integración de Aliños -->
                <Border Style="{StaticResource StitchCardBorderStyle}" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Ingredientes Dosificados"
                                       FontFamily="PlusJakartaSans"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                <Label Text="Desglose de micronutrientes dinámico"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 9999"
                                    StrokeThickness="0"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerHigh}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                                    Padding="10, 4">
                                <Label Text="{Binding IngredientsCountDisplay}"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                            </Border>
                        </Grid>

                        <!-- Botones de Acción Rápida: Añadir Alimento y Aliño Guardado -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource StitchPrimaryContainer}"
                                    Background="#2084CC16"
                                    Padding="10, 8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenAddFoodModalCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="{x:Static helpers:MaterialIconFont.AddCircle}"
                                           Style="{StaticResource MaterialIconStyle}"
                                           FontSize="18"
                                           TextColor="{StaticResource StitchPrimary}" />
                                    <Label Text="+ Añadir Alimento"
                                           FontFamily="Inter"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource StitchPrimary}" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerHigh}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                                    Padding="10, 8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenSeasoningPickerCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Label Text="{x:Static helpers:MaterialIconFont.Blender}"
                                           Style="{StaticResource MaterialIconStyle}"
                                           FontSize="18"
                                           TextColor="{StaticResource StitchTertiary}" />
                                    <Label Text="Aliño Guardado"
                                           FontFamily="Inter"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Lista de Ingredientes Dosificados -->
                        <VerticalStackLayout Spacing="8"
                                             BindableLayout.ItemsSource="{Binding IngredientsList}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:RecipeIngredientDraftModel">
                                    <Border StrokeShape="RoundRectangle 12"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                            Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                            Padding="10, 8">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <!-- Icono del Alimento -->
                                            <Border Grid.Column="0"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    StrokeShape="RoundRectangle 10"
                                                    StrokeThickness="0"
                                                    Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerHigh}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding IconGlyph}"
                                                       Style="{StaticResource MaterialIconStyle}"
                                                       FontSize="18"
                                                       TextColor="{StaticResource StitchPrimary}"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <!-- Datos y Micronutrientes -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Label Text="{Binding Name}"
                                                           FontFamily="PlusJakartaSans"
                                                           FontSize="13"
                                                           FontAttributes="Bold"
                                                           LineBreakMode="TailTruncation"
                                                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                                    <Border StrokeShape="RoundRectangle 4"
                                                            StrokeThickness="0"
                                                            Background="#20FEA518"
                                                            Padding="4, 1"
                                                            IsVisible="{Binding IsFromSeasoning}">
                                                        <Label Text="{Binding SeasoningBadgeText}"
                                                               FontFamily="Inter"
                                                               FontSize="9"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource StitchTertiary}" />
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding SubtitleLine}"
                                                       FontFamily="Inter"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                            </VerticalStackLayout>

                                            <!-- Botón Eliminar -->
                                            <Button Grid.Column="2"
                                                    Text="{x:Static helpers:MaterialIconFont.Delete}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddRecipeViewModel}}, Path=RemoveIngredientCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontFamily="MaterialSymbols"
                                                    FontSize="18"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{StaticResource StitchSecondary}"
                                                    WidthRequest="36"
                                                    HeightRequest="36"
                                                    Padding="0"
                                                    CornerRadius="8"
                                                    SemanticProperties.Description="Eliminar ingrediente" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Estado Vacío cuando no hay ingredientes -->
                        <Border IsVisible="{Binding HasNoIngredients}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                StrokeDashArray="4,4"
                                Background="Transparent"
                                Padding="16, 20">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:MaterialIconFont.SoupKitchen}"
                                       Style="{StaticResource MaterialIconStyle}"
                                       FontSize="28"
                                       TextColor="{StaticResource StitchOutline}"
                                       HorizontalOptions="Center" />
                                <Label Text="Aún no has agregado ingredientes"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                <Label Text="Pulsa '+ Añadir Alimento' o 'Aliño Guardado' para iniciar la dosificación."
                                       FontFamily="Inter"
                                       FontSize="11"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{StaticResource StitchOutline}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 5. Panel Resumen Clínico Estimado en Tiempo Real (Por Ración) -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="2"
                        Stroke="{StaticResource StitchPrimaryContainer}"
                        Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                        Padding="16"
                        Shadow="{StaticResource StitchCardShadow}">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:MaterialIconFont.Analytics}"
                                       Style="{StaticResource MaterialIconStyle}"
                                       FontSize="20"
                                       TextColor="{StaticResource StitchPrimary}" />
                                <Label Text="Proyección por Ración"
                                       FontFamily="PlusJakartaSans"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                            </HorizontalStackLayout>

                            <Border Grid.Column="1"
                                    StrokeShape="RoundRectangle 9999"
                                    StrokeThickness="0"
                                    Background="{StaticResource StitchPrimaryContainer}"
                                    Padding="10, 4">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{x:Static helpers:MaterialIconFont.Shield}"
                                           Style="{StaticResource MaterialIconStyle}"
                                           FontSize="13"
                                           TextColor="{StaticResource StitchOnPrimaryContainer}" />
                                    <Label Text="{Binding SodiumBadgeText}"
                                           FontFamily="Inter"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource StitchOnPrimaryContainer}" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Banner Macros Clave (3 Columnas con Divisores) -->
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                Padding="12, 10">
                            <Grid ColumnDefinitions="*, Auto, *, Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                                <!-- Energía -->
                                <VerticalStackLayout Grid.Column="0" Spacing="1" HorizontalOptions="Center">
                                    <Label Text="Energía"
                                           FontFamily="Inter"
                                           FontSize="10"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                    <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="{Binding EnergyPerServingText}"
                                               FontFamily="Inter"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                        <Label Text="kcal"
                                               FontFamily="Inter"
                                               FontSize="10"
                                               VerticalOptions="End"
                                               Margin="0,0,0,2"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <BoxView Grid.Column="1" WidthRequest="1" HeightRequest="28" Color="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}" VerticalOptions="Center" />

                                <!-- Proteínas -->
                                <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="Center">
                                    <Label Text="Proteínas"
                                           FontFamily="Inter"
                                           FontSize="10"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                    <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="{Binding ProteinPerServingText}"
                                               FontFamily="Inter"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource StitchPrimary}" />
                                        <Label Text="g"
                                               FontFamily="Inter"
                                               FontSize="10"
                                               VerticalOptions="End"
                                               Margin="0,0,0,2"
                                               TextColor="{StaticResource StitchPrimary}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <BoxView Grid.Column="3" WidthRequest="1" HeightRequest="28" Color="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}" VerticalOptions="Center" />

                                <!-- Lípidos -->
                                <VerticalStackLayout Grid.Column="4" Spacing="1" HorizontalOptions="Center">
                                    <Label Text="Lípidos"
                                           FontFamily="Inter"
                                           FontSize="10"
                                           TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                    <HorizontalStackLayout Spacing="2" HorizontalOptions="Center">
                                        <Label Text="{Binding FatPerServingText}"
                                               FontFamily="Inter"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                        <Label Text="g"
                                               FontFamily="Inter"
                                               FontSize="10"
                                               VerticalOptions="End"
                                               Margin="0,0,0,2"
                                               TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Balance de 7 Minerales Críticos (Cuadrícula 4x2 con FlexLayout) -->
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0"
                                       Text="Balance de 7 Minerales Críticos"
                                       FontFamily="Inter"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                <Label Grid.Column="1"
                                       Text="Meta por ración (mg)"
                                       FontFamily="Inter"
                                       FontSize="10"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                            </Grid>

                            <FlexLayout BindableLayout.ItemsSource="{Binding MineralProjections}"
                                        Wrap="Wrap"
                                        JustifyContent="SpaceBetween">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:MineralProjectionModel">
                                        <Border StrokeShape="RoundRectangle 10"
                                                StrokeThickness="1"
                                                Stroke="{Binding BorderColor}"
                                                Background="{Binding BackgroundColor}"
                                                Padding="6, 5"
                                                Margin="0, 0, 0, 6"
                                                FlexLayout.Basis="23%">
                                            <VerticalStackLayout Spacing="2">
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding Symbol}"
                                                           FontFamily="Inter"
                                                           FontSize="10"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding TextColor}" />
                                                    <Label Grid.Column="1"
                                                           Text="{Binding StatusText}"
                                                           FontFamily="Inter"
                                                           FontSize="8"
                                                           FontAttributes="Bold"
                                                           TextColor="{Binding StatusColor}" />
                                                </Grid>
                                                <Label Text="{Binding AmountDisplay}"
                                                       FontFamily="Inter"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{Binding TextColor}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 6. Pasos Numerados de Elaboración -->
                <Border Style="{StaticResource StitchCardBorderStyle}" Padding="16">
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:MaterialIconFont.FormatListNumbered}"
                                       Style="{StaticResource MaterialIconStyle}"
                                       FontSize="20"
                                       TextColor="{StaticResource StitchPrimary}" />
                                <Label Text="Pasos de Elaboración"
                                       FontFamily="PlusJakartaSans"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                            </HorizontalStackLayout>

                            <Label Grid.Column="1"
                                   Text="{Binding StepsCountDisplay}"
                                   FontFamily="Inter"
                                   FontSize="11"
                                   TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Pasos Existentes -->
                        <VerticalStackLayout Spacing="8"
                                             BindableLayout.ItemsSource="{Binding StepsList}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:RecipeStepDraftModel">
                                    <Border StrokeShape="RoundRectangle 12"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                            Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                            Padding="10">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10" VerticalOptions="Start">
                                            <Border Grid.Column="0"
                                                    WidthRequest="26"
                                                    HeightRequest="26"
                                                    StrokeShape="RoundRectangle 13"
                                                    StrokeThickness="0"
                                                    Background="{StaticResource StitchPrimaryContainer}"
                                                    VerticalOptions="Start">
                                                <Label Text="{Binding StepNumber}"
                                                       FontFamily="Inter"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"
                                                       TextColor="{StaticResource StitchOnPrimaryContainer}" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="{Binding Instruction}"
                                                       FontFamily="PlusJakartaSans"
                                                       FontSize="12"
                                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />

                                                <!-- Miniatura de foto del paso si existe -->
                                                <Border IsVisible="{Binding HasPhoto}"
                                                        StrokeShape="RoundRectangle 8"
                                                        StrokeThickness="1"
                                                        Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                        HeightRequest="60"
                                                        WidthRequest="90"
                                                        HorizontalOptions="Start"
                                                        Margin="0, 4, 0, 2">
                                                    <Image Source="{Binding ImagePath}"
                                                           Aspect="AspectFill"
                                                           HeightRequest="60"
                                                           WidthRequest="90" />
                                                </Border>

                                                <HorizontalStackLayout Spacing="8">
                                                    <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                                        <Label Text="{x:Static helpers:MaterialIconFont.Schedule}"
                                                               Style="{StaticResource MaterialIconStyle}"
                                                               FontSize="12"
                                                               TextColor="{StaticResource StitchPrimary}" />
                                                        <Label Text="{Binding TimeDisplayText}"
                                                               FontFamily="Inter"
                                                               FontSize="10"
                                                               TextColor="{StaticResource StitchPrimary}" />
                                                    </HorizontalStackLayout>
                                                    <Label Text="{Binding TechniqueTag}"
                                                           FontFamily="Inter"
                                                           FontSize="10"
                                                           TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <Button Grid.Column="2"
                                                    Text="{x:Static helpers:MaterialIconFont.Delete}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddRecipeViewModel}}, Path=RemoveStepCommand}"
                                                    CommandParameter="{Binding .}"
                                                    FontFamily="MaterialSymbols"
                                                    FontSize="18"
                                                    BackgroundColor="Transparent"
                                                    TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                                    WidthRequest="44"
                                                    HeightRequest="44"
                                                    Padding="0"
                                                    SemanticProperties.Description="Eliminar este paso de la receta" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <!-- Estado Vacío cuando no hay pasos -->
                        <Border IsVisible="{Binding HasNoSteps}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                StrokeDashArray="4,4"
                                Background="Transparent"
                                Padding="16, 20">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:MaterialIconFont.FormatListNumbered}"
                                       Style="{StaticResource MaterialIconStyle}"
                                       FontSize="28"
                                       TextColor="{StaticResource StitchOutline}"
                                       HorizontalOptions="Center" />
                                <Label Text="Aún no has redactado pasos"
                                       FontFamily="Inter"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />
                                <Label Text="Escribe la primera instrucción a continuación y pulsa '+ Agregar Paso'."
                                       FontFamily="Inter"
                                       FontSize="11"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{StaticResource StitchOutline}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Formulario para Redactar Siguiente Paso -->
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="1"
                                Stroke="{StaticResource StitchPrimaryContainer}"
                                Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                Padding="12">
                            <VerticalStackLayout Spacing="10">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{x:Static helpers:MaterialIconFont.EditNote}"
                                           Style="{StaticResource MaterialIconStyle}"
                                           FontSize="16"
                                           TextColor="{StaticResource StitchPrimary}" />
                                    <Label Text="Redactar siguiente paso"
                                           FontFamily="Inter"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource StitchPrimary}" />
                                </HorizontalStackLayout>

                                <Editor Text="{Binding NewStepInstruction}"
                                        Placeholder="Describa el procedimiento culinario, temperaturas o tips de emplatado..."
                                        FontFamily="PlusJakartaSans"
                                        FontSize="12"
                                        AutoSize="TextChanges"
                                        HeightRequest="60"
                                        TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />

                                <!-- Vista previa de fotografía adjunta al paso si existe -->
                                <Border IsVisible="{Binding HasNewStepImage}"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                        HeightRequest="66"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                        Padding="6">
                                    <Grid ColumnDefinitions="54, *, Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                StrokeShape="RoundRectangle 6"
                                                StrokeThickness="0"
                                                WidthRequest="54"
                                                HeightRequest="54">
                                            <Image Source="{Binding NewStepImagePath}"
                                                   Aspect="AspectFill"
                                                   WidthRequest="54"
                                                   HeightRequest="54" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="Foto del paso adjunta"
                                                   FontFamily="Inter"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                            <Label Text="Se asociará al pulsar Añadir Paso"
                                                   FontFamily="Inter"
                                                   FontSize="10"
                                                   TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="2"
                                                Command="{Binding RemoveNewStepImageCommand}"
                                                HeightRequest="44"
                                                WidthRequest="44"
                                                Padding="0"
                                                CornerRadius="8"
                                                BackgroundColor="#FFEDEA"
                                                SemanticProperties.Description="Eliminar fotografía adjunta al paso">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialSymbols"
                                                                 Glyph="{x:Static helpers:MaterialIconFont.Delete}"
                                                                 Size="18"
                                                                 Color="#BA1A1A" />
                                            </Button.ImageSource>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Acciones para adjuntar fotografía y agregar paso -->
                                <Grid ColumnDefinitions="Auto, Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                    <Button Grid.Column="0"
                                            Text="Cámara"
                                            Command="{Binding TakeStepPhotoCommand}"
                                            FontFamily="Inter"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            HeightRequest="44"
                                            Padding="10, 0"
                                            CornerRadius="8"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                            TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                            BorderColor="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                            BorderWidth="1"
                                            SemanticProperties.Description="Tomar fotografía del paso con cámara">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="MaterialSymbols"
                                                             Glyph="{x:Static helpers:MaterialIconFont.PhotoCamera}"
                                                             Size="16"
                                                             Color="{StaticResource StitchPrimary}" />
                                        </Button.ImageSource>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Text="Galería"
                                            Command="{Binding BrowseStepGalleryCommand}"
                                            FontFamily="Inter"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            HeightRequest="44"
                                            Padding="10, 0"
                                            CornerRadius="8"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                            TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}"
                                            BorderColor="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                            BorderWidth="1"
                                            SemanticProperties.Description="Elegir fotografía del paso de galería">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="MaterialSymbols"
                                                             Glyph="{x:Static helpers:MaterialIconFont.Collections}"
                                                             Size="16"
                                                             Color="{StaticResource StitchPrimary}" />
                                        </Button.ImageSource>
                                    </Button>

                                    <Button Grid.Column="3"
                                            Text="Añadir Paso"
                                            Command="{Binding AddStepCommand}"
                                            FontFamily="Inter"
                                            FontSize="11"
                                            FontAttributes="Bold"
                                            HeightRequest="44"
                                            Padding="16, 0"
                                            CornerRadius="10"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                                            TextColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkOnSurface}}"
                                            SemanticProperties.Description="Agregar paso redactado a la receta" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 7. Barra Inferior de Persistencia (Fija en la Base) -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                Padding="16, 10, 16, 14"
                Shadow="{StaticResource StitchCardShadow}">
            <VerticalStackLayout Spacing="8" MaximumWidthRequest="440" HorizontalOptions="Center">
                <!-- Boton Principal 48dp Verde Lima -->
                <Button Text="+ Guardar Receta Culinaria"
                        Command="{Binding SaveRecipeCommand}"
                        Style="{StaticResource StitchPrimaryButtonStyle}"
                        HeightRequest="48"
                        CornerRadius="14"
                        SemanticProperties.Description="Guardar receta culinaria" />

                <!-- Boton Secundario Borrador -->
                <Button Text="Guardar como Borrador"
                        Command="{Binding SaveAsDraftCommand}"
                        FontFamily="Inter"
                        FontSize="13"
                        FontAttributes="Bold"
                        HeightRequest="40"
                        CornerRadius="12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainer}, Dark={StaticResource StitchDarkSurfaceContainer}}"
                        TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
            </VerticalStackLayout>
        </Border>

        <!-- MODAL 1: Selector de Alimentos del Catálogo -->
        <Grid Grid.RowSpan="3"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsFoodPickerVisible}">
            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                    Margin="20"
                    Padding="16"
                    MaximumWidthRequest="400"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Añadir Alimento a la Receta"
                               FontFamily="PlusJakartaSans"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                        <Button Grid.Column="1"
                                Text="{x:Static helpers:MaterialIconFont.Close}"
                                Command="{Binding CloseFoodPickerCommand}"
                                FontFamily="MaterialSymbols"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource StitchOutline}"
                                Padding="0"
                                WidthRequest="32"
                                HeightRequest="32" />
                    </Grid>

                    <!-- Buscador -->
                    <Border StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                            Padding="8, 2">
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Grid.Column="0"
                                   Text="{x:Static helpers:MaterialIconFont.Search}"
                                   Style="{StaticResource MaterialIconStyle}"
                                   FontSize="18"
                                   TextColor="{StaticResource StitchOutline}"
                                   VerticalOptions="Center" />
                            <Entry Grid.Column="1"
                                   Text="{Binding FoodSearchQuery}"
                                   Placeholder="Buscar alimento..."
                                   FontFamily="Inter"
                                   FontSize="13"
                                   ReturnCommand="{Binding SearchFoodsCommand}" />
                        </Grid>
                    </Border>

                    <!-- Gramaje a Añadir -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="Gramos a dosificar:"
                               FontFamily="Inter"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="4">
                            <Entry Text="{Binding FoodGramsToAdd}"
                                   Keyboard="Numeric"
                                   FontFamily="Inter"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   WidthRequest="50"
                                   HorizontalTextAlignment="End" />
                            <Label Text="g"
                                   FontFamily="Inter"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Lista de Alimentos -->
                    <ScrollView HeightRequest="220">
                        <VerticalStackLayout Spacing="6"
                                             BindableLayout.ItemsSource="{Binding AvailableFoods}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:FoodItemDto">
                                    <Border StrokeShape="RoundRectangle 8"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                            Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                            Padding="10, 8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddRecipeViewModel}}, Path=SelectFoodItemCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                                <Label Text="{Binding Name}"
                                                       FontFamily="PlusJakartaSans"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                                <Label Text="{Binding SubtitleSummary}"
                                                       FontFamily="Inter"
                                                       FontSize="10"
                                                       TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{x:Static helpers:MaterialIconFont.Add}"
                                                   Style="{StaticResource MaterialIconStyle}"
                                                   FontSize="20"
                                                   TextColor="{StaticResource StitchPrimary}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- MODAL 2: Selector de Aliños Guardados -->
        <Grid Grid.RowSpan="3"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsSeasoningPickerVisible}">
            <Border StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLowest}, Dark={StaticResource StitchDarkSurfaceLowest}}"
                    Margin="20"
                    Padding="16"
                    MaximumWidthRequest="400"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                               Text="Incorporar Aliño Guardado"
                               FontFamily="PlusJakartaSans"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                        <Button Grid.Column="1"
                                Text="{x:Static helpers:MaterialIconFont.Close}"
                                Command="{Binding CloseSeasoningPickerCommand}"
                                FontFamily="MaterialSymbols"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource StitchOutline}"
                                Padding="0"
                                WidthRequest="32"
                                HeightRequest="32" />
                    </Grid>

                    <Label Text="Selecciona un aliño para agregarlo a la preparación dosificada:"
                           FontFamily="Inter"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light={StaticResource StitchOnSurfaceVariant}, Dark={StaticResource StitchDarkOnSurfaceVariant}}" />

                    <!-- Lista de Aliños -->
                    <ScrollView HeightRequest="220">
                        <VerticalStackLayout Spacing="6"
                                             BindableLayout.ItemsSource="{Binding AvailableSeasonings}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dtos:SeasoningDto">
                                    <Border StrokeShape="RoundRectangle 8"
                                            StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource StitchOutlineVariant}, Dark={StaticResource StitchDarkOutlineVariant}}"
                                            Background="{AppThemeBinding Light={StaticResource StitchSurfaceContainerLow}, Dark={StaticResource StitchDarkSurfaceLow}}"
                                            Padding="10, 8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddRecipeViewModel}}, Path=SelectSeasoningCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <Label Grid.Column="0"
                                                   Text="{x:Static helpers:MaterialIconFont.Blender}"
                                                   Style="{StaticResource MaterialIconStyle}"
                                                   FontSize="20"
                                                   TextColor="{StaticResource StitchTertiary}"
                                                   VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding Name}"
                                                       FontFamily="PlusJakartaSans"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource StitchOnSurface}, Dark={StaticResource StitchDarkOnSurface}}" />
                                                <Label Text="{Binding SummaryDisplayText}"
                                                       FontFamily="Inter"
                                                       FontSize="10"
                                                       TextColor="{AppThemeBinding Light={StaticResource StitchOutline}, Dark={StaticResource StitchDarkOutlineVariant}}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2"
                                                   Text="{x:Static helpers:MaterialIconFont.Add}"
                                                   Style="{StaticResource MaterialIconStyle}"
                                                   FontSize="20"
                                                   TextColor="{StaticResource StitchPrimary}"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
