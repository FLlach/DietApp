<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:models="clr-namespace:DietApp.UI.Models"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.AddRecipePage"
             x:Name="ThisAddRecipePage"
             x:DataType="vm:AddRecipeViewModel"
             Title="{loc:Translate AddRecipe_Title}">

    <!--
    Como funciona: Formulario de composicion de recetas culinarias con ingredientes dosificados,
    pasos de preparacion numerados con imagenes ilustrativas e imagen final de la receta terminada.
    Por que se tomo esta decision: Permite al usuario construir una receta interactiva, seleccionar imagenes
    desde el dispositivo para cada paso y obtener un calculo inmediato de minerales y calorias por porcion.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="16">
            <Label Text="{loc:Translate AddRecipe_Header}"
                   FontAttributes="Bold"
                   FontSize="18" />

            <!-- Indicador de Carga -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center" />

            <!-- Informacion Basica -->
            <Border StrokeShape="RoundRectangle 10"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate AddRecipe_RecipeTitle}" FontAttributes="Bold" FontSize="12" />
                    <Entry Placeholder="{loc:Translate AddRecipe_RecipeTitlePlaceholder}"
                           Text="{Binding Title}" />

                    <Label Text="{loc:Translate AddRecipe_Description}" FontAttributes="Bold" FontSize="12" />
                    <Editor Placeholder="{loc:Translate AddRecipe_DescriptionPlaceholder}"
                            Text="{Binding Description}"
                            HeightRequest="70" />

                    <Label Text="{loc:Translate AddRecipe_Servings}" FontAttributes="Bold" FontSize="12" />
                    <Entry Placeholder="2"
                           Keyboard="Numeric"
                           Text="{Binding ServingsText}" />
                </VerticalStackLayout>
            </Border>

            <!-- Imagen Final de la Receta Terminada -->
            <Label Text="{loc:Translate AddRecipe_FinalImage}"
                   FontAttributes="Bold"
                   FontSize="15" />

            <Border StrokeShape="RoundRectangle 10"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate AddRecipe_FinalImageSubtitle}"
                           FontSize="12"
                           TextColor="Gray" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Placeholder="{loc:Translate AddRecipe_ImagePathPlaceholder}"
                               Text="{Binding FinalImagePath}" />

                        <Button Grid.Column="1"
                                Text="{loc:Translate AddRecipe_BrowseButton}"
                                Command="{Binding PickFinalImageCommand}"
                                FontSize="12" />
                    </Grid>

                    <Border StrokeShape="RoundRectangle 8"
                            HeightRequest="140"
                            Padding="0"
                            IsVisible="{Binding HasFinalImage}">
                        <Image Source="{Binding FinalImagePath}"
                               Aspect="AspectFill" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Seccion de Ingredientes -->
            <Label Text="{loc:Translate AddRecipe_Ingredients}"
                   FontAttributes="Bold"
                   FontSize="15" />

            <Border StrokeShape="RoundRectangle 10"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate AddRecipe_SelectFood}" FontAttributes="Bold" FontSize="12" />
                    <Picker ItemsSource="{Binding AvailableFoods}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedFood}"
                            Title="{loc:Translate AddRecipe_SelectFoodPlaceholder}" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{loc:Translate AddRecipe_GramsRequired}" FontAttributes="Bold" FontSize="12" />
                            <Entry Placeholder="100"
                                   Keyboard="Numeric"
                                   Text="{Binding IngredientGramsText}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="{loc:Translate AddRecipe_AddIngredient}"
                                VerticalOptions="End"
                                Command="{Binding AddIngredientCommand}"
                                FontSize="12" />
                    </Grid>

                    <!-- Opcion de Incorporar Alino o Condimento Preconfigurado -->
                    <Border StrokeShape="RoundRectangle 8"
                            Padding="12"
                            Background="{AppThemeBinding Light=#FEF9E7, Dark=#262115}"
                            Stroke="{AppThemeBinding Light=#F9E79F, Dark=#564A23}"
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{loc:Translate AddRecipe_AddSeasoningTitle}"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#B9770E, Dark=#F39C12}" />

                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Picker Grid.Column="0"
                                        ItemsSource="{Binding AvailableSeasonings}"
                                        ItemDisplayBinding="{Binding SummaryDisplayText}"
                                        SelectedItem="{Binding SelectedSeasoning}"
                                        Title="{loc:Translate AddRecipe_SelectSeasoningPlaceholder}"
                                        FontSize="12" />

                                <Button Grid.Column="1"
                                        Text="{loc:Translate AddRecipe_ApplySeasoning}"
                                        Command="{Binding ApplySeasoningCommand}"
                                        BackgroundColor="{StaticResource WarningAmber}"
                                        TextColor="White"
                                        FontSize="11"
                                        Padding="10, 4"
                                        VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lista de ingredientes agregados -->
                    <Label Text="{loc:Translate AddRecipe_IngredientsListTitle}"
                           FontAttributes="Bold"
                           FontSize="12"
                           Margin="0, 6, 0, 0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}"
                                         Spacing="6">
                        <BindableLayout.EmptyView>
                            <Label Text="{loc:Translate AddRecipe_EmptyIngredients}"
                                   TextColor="Gray"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   Padding="6" />
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:RecipeIngredientDraftModel">
                                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                    <Label Grid.Column="0" Text="{Binding DisplayText}" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Text="{loc:Translate AddRecipe_Remove}"
                                            Command="{Binding Source={x:Reference ThisAddRecipePage}, Path=BindingContext.RemoveIngredientCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="#E74C3C"
                                            TextColor="White"
                                            FontSize="12"
                                            HeightRequest="44"
                                            MinimumHeightRequest="44"
                                            MinimumWidthRequest="44"
                                            Padding="12, 4"
                                            VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Seccion de Pasos Numerados -->
            <Label Text="{loc:Translate AddRecipe_PreparationSteps}"
                   FontAttributes="Bold"
                   FontSize="15" />

            <Border StrokeShape="RoundRectangle 10"
                    Padding="14"
                    Background="{AppThemeBinding Light=#FFFFFF, Dark=#25252D}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{loc:Translate AddRecipe_StepInstruction}" FontAttributes="Bold" FontSize="12" />
                    <Editor Placeholder="{loc:Translate AddRecipe_StepInstructionPlaceholder}"
                            Text="{Binding CurrentStepInstruction}"
                            HeightRequest="60" />

                    <Label Text="{loc:Translate AddRecipe_StepImage}" FontAttributes="Bold" FontSize="12" />
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                        <Entry Grid.Column="0"
                               Placeholder="{loc:Translate AddRecipe_ImagePathPlaceholder}"
                               Text="{Binding CurrentStepImagePath}" />
                        <Button Grid.Column="1"
                                Text="{loc:Translate AddRecipe_BrowseButton}"
                                Command="{Binding PickStepImageCommand}"
                                FontSize="12" />
                    </Grid>

                    <Button Text="{loc:Translate AddRecipe_AddStep}"
                            Command="{Binding AddStepCommand}"
                            FontAttributes="Bold"
                            FontSize="12" />

                    <!-- Lista de Pasos Registrados -->
                    <Label Text="{loc:Translate AddRecipe_StepsListTitle}"
                           FontAttributes="Bold"
                           FontSize="12"
                           Margin="0, 8, 0, 0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}"
                                         Spacing="8">
                        <BindableLayout.EmptyView>
                            <Label Text="{loc:Translate AddRecipe_EmptySteps}"
                                   TextColor="Gray"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   Padding="6" />
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:RecipeStepDraftModel">
                                <Border StrokeShape="RoundRectangle 8"
                                        Padding="10"
                                        Background="{AppThemeBinding Light=#F8F9FA, Dark=#1A252F}">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                            <Label Grid.Column="0" Text="{Binding StepTitle}" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Button Grid.Column="1"
                                                    Text="{loc:Translate AddRecipe_Remove}"
                                                    Command="{Binding Source={x:Reference ThisAddRecipePage}, Path=BindingContext.RemoveStepCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#E74C3C"
                                                    TextColor="White"
                                                    FontSize="12"
                                                    HeightRequest="44"
                                                    MinimumHeightRequest="44"
                                                    MinimumWidthRequest="44"
                                                    Padding="12, 4"
                                                    VerticalOptions="Center" />
                                        </Grid>

                                        <Label Text="{Binding Instruction}" FontSize="13" />

                                        <Image Source="{Binding ImagePath}"
                                               HeightRequest="100"
                                               Aspect="AspectFill"
                                               IsVisible="{Binding HasImage}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Mensaje de estado -->
            <Label Text="{Binding StatusMessage}"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{StaticResource HealthTeal}" />

            <!-- Boton Guardar Receta -->
            <Button Text="{loc:Translate AddRecipe_SaveRecipe}"
                    Command="{Binding SaveRecipeCommand}"
                    FontAttributes="Bold"
                    HeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
