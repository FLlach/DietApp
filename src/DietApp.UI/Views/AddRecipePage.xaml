<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DietApp.UI.ViewModels"
             xmlns:models="clr-namespace:DietApp.UI.Models"
             xmlns:loc="clr-namespace:DietApp.UI.Localization"
             x:Class="DietApp.UI.Views.AddRecipePage"
             x:Name="ThisAddRecipePage"
             x:DataType="vm:AddRecipeViewModel"
             Title="{loc:Translate AddRecipe_Title}"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceWarm}, Dark={StaticResource Black}}">

    <!--
    Como funciona: Compositor de recetas clinicas basado en el diseno Stitch 'Clinical Nutrition Ergonomics'.
    Organiza la captura del plato mediante tarjetas Bento: fotografia del plato, informacion basica
    con selectores tactiles de raciones, dosificacion de ingredientes con integracion modular de alinos,
    y pasos secuenciales con ilustracion visual.
    Por que se tomo esta decision: Asegura una experiencia de introduccion de datos fluida, con alturas
    ergonomicas de 48dp y 52dp para teclado virtual en Android y prevencion de errores de dosificacion.
    -->

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- 1. Encabezado de Estado Clinico -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16, 12"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="DIETAPP • COMPOSITOR CULINARIO"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryDark}" />
                        <Label Text="{loc:Translate AddRecipe_Title}"
                               FontAttributes="Bold"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                        <Label Text="Modo Dosificación Clínica"
                               FontSize="12"
                               TextColor="{StaticResource Outline}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="{loc:Translate AddRecipe_SaveButton}"
                            Command="{Binding SaveRecipeCommand}"
                            Style="{StaticResource StitchPrimaryButtonStyle}"
                            HeightRequest="48"
                            MinimumHeightRequest="48"
                            Padding="16, 0"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Indicador de Carga -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource PrimaryDark}"
                               HorizontalOptions="Center" />

            <!-- Mensaje de Estado / Notificacion Clinica -->
            <Label Text="{Binding StatusMessage}"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryDark}"
                   HorizontalTextAlignment="Center" />

            <!-- 2. Hero Fotografia del Plato Terminado -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Grid.Column="0"
                               Text="{loc:Translate AddRecipe_FinalImage}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />
                        <Border Grid.Column="1"
                                StrokeShape="RoundRectangle 9999"
                                Padding="8, 3"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}">
                            <Label Text="Recomendado"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDark}" />
                        </Border>
                    </Grid>

                    <Label Text="{loc:Translate AddRecipe_FinalImageSubtitle}"
                           FontSize="12"
                           TextColor="{StaticResource Outline}" />

                    <!-- Vista Previa de la Fotografia -->
                    <Border StrokeShape="RoundRectangle 14"
                            HeightRequest="170"
                            Padding="0"
                            Stroke="{StaticResource BorderWarmLight}"
                            StrokeThickness="1"
                            Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                            IsVisible="{Binding HasFinalImage}">
                        <Image Source="{Binding FinalImagePath}"
                               Aspect="AspectFill" />
                    </Border>

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 0">
                            <Entry Placeholder="{loc:Translate AddRecipe_ImagePathPlaceholder}"
                                   Text="{Binding FinalImagePath}"
                                   HeightRequest="48"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </Border>

                        <Button Grid.Column="1"
                                Text="{loc:Translate AddRecipe_BrowseButton}"
                                Command="{Binding PickFinalImageCommand}"
                                Style="{StaticResource StitchNeutralButtonStyle}"
                                HeightRequest="48"
                                MinimumHeightRequest="48"
                                Padding="14, 0"
                                VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 3. Informacion Basica de la Preparacion -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Información Básica"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                    <!-- Titulo de la Receta -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate AddRecipe_RecipeTitle}"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="{StaticResource Outline}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 0">
                            <Entry Placeholder="{loc:Translate AddRecipe_RecipeTitlePlaceholder}"
                                   Text="{Binding Title}"
                                   HeightRequest="48"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Descripcion o Notas Clinicas -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate AddRecipe_Description}"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="{StaticResource Outline}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 4">
                            <Editor Placeholder="{loc:Translate AddRecipe_DescriptionPlaceholder}"
                                    Text="{Binding Description}"
                                    HeightRequest="80"
                                    FontSize="13" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Raciones Totales -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate AddRecipe_Servings}"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="{StaticResource Outline}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 0">
                            <Entry Placeholder="2"
                                   Keyboard="Numeric"
                                   Text="{Binding ServingsText}"
                                   HeightRequest="48"
                                   FontSize="14" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Ingredientes Dosificados e Integracion de Alinos -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate AddRecipe_Ingredients}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                    <!-- Selector de Alimento -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate AddRecipe_SelectFood}"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="{StaticResource Outline}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 0">
                            <Picker ItemsSource="{Binding AvailableFoods}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedFood}"
                                    Title="{loc:Translate AddRecipe_SelectFoodPlaceholder}"
                                    HeightRequest="48"
                                    FontSize="13" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Gramaje y Boton Agregar -->
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            <Label Text="{loc:Translate AddRecipe_Grams}"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   TextColor="{StaticResource Outline}" />
                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                    StrokeThickness="1"
                                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                    Padding="8, 0">
                                <Entry Placeholder="100"
                                       Keyboard="Numeric"
                                       Text="{Binding IngredientGramsText}"
                                       HeightRequest="48"
                                       FontSize="14" />
                            </Border>
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="{loc:Translate AddRecipe_AddIngredientButton}"
                                Command="{Binding AddIngredientCommand}"
                                Style="{StaticResource StitchNeutralButtonStyle}"
                                HeightRequest="48"
                                MinimumHeightRequest="48"
                                Padding="14, 0"
                                VerticalOptions="End" />
                    </Grid>

                    <!-- Integracion de Alinos y Marinadas Clinicas -->
                    <Border StrokeShape="RoundRectangle 14"
                            Padding="12"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="1"
                            Background="{AppThemeBinding Light={StaticResource MineralProteinBg}, Dark=#1e2d14}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Incorporar Aliño o Marinada Existente"
                                   FontAttributes="Bold"
                                   FontSize="13"
                                   TextColor="{StaticResource OnPrimaryContainer}" />
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 10"
                                        Stroke="{StaticResource BorderWarmLight}"
                                        StrokeThickness="1"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark=#23232c}"
                                        Padding="8, 0">
                                    <Picker ItemsSource="{Binding AvailableSeasonings}"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedItem="{Binding SelectedSeasoning}"
                                            Title="Seleccionar aliño..."
                                            HeightRequest="48"
                                            FontSize="12" />
                                </Border>
                                <Button Grid.Column="1"
                                        Text="Incorporar"
                                        Command="{Binding ApplySeasoningCommand}"
                                        Style="{StaticResource StitchPrimaryButtonStyle}"
                                        HeightRequest="48"
                                        MinimumHeightRequest="48"
                                        Padding="14, 0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Lista de Ingredientes Agregados -->
                    <Label Text="Ingredientes dosificados en la preparación:"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Outline}"
                           Margin="0, 4, 0, 0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ingredients}"
                                         Spacing="8">
                        <BindableLayout.EmptyView>
                            <Label Text="No se han agregado ingredientes aún."
                                   FontSize="12"
                                   TextColor="{StaticResource Outline}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0, 8" />
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:RecipeIngredientDraftModel">
                                <Border StrokeShape="RoundRectangle 12"
                                        Padding="12, 8"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                        StrokeThickness="1"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <Label Grid.Column="0"
                                               Text="{Binding Summary}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                                        <Button Grid.Column="1"
                                                Text="✕"
                                                Command="{Binding Source={x:Reference ThisAddRecipePage}, Path=BindingContext.RemoveIngredientCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Secondary}"
                                                TextColor="White"
                                                FontAttributes="Bold"
                                                FontSize="12"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                CornerRadius="10"
                                                Padding="0"
                                                VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 5. Pasos Secuenciales de Elaboracion -->
            <Border StrokeShape="RoundRectangle 16"
                    Padding="16"
                    Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                    StrokeThickness="1"
                    Background="{AppThemeBinding Light={StaticResource SurfaceContainerLowest}, Dark={StaticResource CardBackgroundDark}}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate AddRecipe_Steps}"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                    <!-- Instruccion del Paso -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate AddRecipe_StepInstruction}"
                               FontAttributes="Bold"
                               FontSize="12"
                               TextColor="{StaticResource Outline}" />
                        <Border StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 4">
                            <Editor Placeholder="{loc:Translate AddRecipe_StepInstructionPlaceholder}"
                                    Text="{Binding CurrentStepInstruction}"
                                    HeightRequest="70"
                                    FontSize="13" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Selector de Imagen del Paso -->
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                StrokeThickness="1"
                                Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}"
                                Padding="8, 0">
                            <Entry Placeholder="{loc:Translate AddRecipe_ImagePathPlaceholder}"
                                   Text="{Binding CurrentStepImagePath}"
                                   HeightRequest="48"
                                   FontSize="12"
                                   VerticalOptions="Center" />
                        </Border>

                        <Button Grid.Column="1"
                                Text="{loc:Translate AddRecipe_BrowseButton}"
                                Command="{Binding PickStepImageCommand}"
                                Style="{StaticResource StitchNeutralButtonStyle}"
                                HeightRequest="48"
                                MinimumHeightRequest="48"
                                Padding="14, 0"
                                VerticalOptions="Center" />
                    </Grid>

                    <Button Text="{loc:Translate AddRecipe_AddStepButton}"
                            Command="{Binding AddStepCommand}"
                            Style="{StaticResource StitchNeutralButtonStyle}"
                            HeightRequest="48"
                            MinimumHeightRequest="48" />

                    <!-- Lista de Pasos Numerados -->
                    <Label Text="Secuencia de elaboración clínica:"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Outline}"
                           Margin="0, 4, 0, 0" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}"
                                         Spacing="10">
                        <BindableLayout.EmptyView>
                            <Label Text="No se han registrado pasos aún."
                                   FontSize="12"
                                   TextColor="{StaticResource Outline}"
                                   HorizontalTextAlignment="Center"
                                   Margin="0, 8" />
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:RecipeStepDraftModel">
                                <Border StrokeShape="RoundRectangle 14"
                                        Padding="14"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderWarmLight}, Dark={StaticResource BorderWarmDark}}"
                                        StrokeThickness="1"
                                        Background="{AppThemeBinding Light={StaticResource SurfaceContainerLow}, Dark=#23232c}">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                                <Border StrokeShape="RoundRectangle 9999"
                                                        Padding="8, 2"
                                                        Background="{StaticResource PrimaryDark}">
                                                    <Label Text="{Binding StepNumber, StringFormat='Paso {0}'}"
                                                           FontSize="11"
                                                           FontAttributes="Bold"
                                                           TextColor="White" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <Button Grid.Column="1"
                                                    Text="✕"
                                                    Command="{Binding Source={x:Reference ThisAddRecipePage}, Path=BindingContext.RemoveStepCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{StaticResource Secondary}"
                                                    TextColor="White"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    WidthRequest="40"
                                                    HeightRequest="40"
                                                    CornerRadius="10"
                                                    Padding="0"
                                                    VerticalOptions="Center" />
                                        </Grid>

                                        <Label Text="{Binding Instruction}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource ContrastDark}, Dark={StaticResource White}}" />

                                        <Border StrokeShape="RoundRectangle 10"
                                                HeightRequest="120"
                                                Padding="0"
                                                IsVisible="{Binding HasImage}">
                                            <Image Source="{Binding ImagePath}"
                                                   Aspect="AspectFill" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 6. Boton Principal Flotante/Final de Guardado -->
            <Button Text="{loc:Translate AddRecipe_SaveButton}"
                    Command="{Binding SaveRecipeCommand}"
                    Style="{StaticResource StitchPrimaryButtonStyle}"
                    HeightRequest="52"
                    MinimumHeightRequest="52"
                    FontSize="16"
                    Margin="0, 8, 0, 16" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
